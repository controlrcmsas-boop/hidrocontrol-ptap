@rendermode InteractiveServer
@implements IAsyncDisposable
@inject PTAPControl.Services.NodeRedApiClient Api

<div class="global-alarm-banner @(IsActive ? "active" : "") @(IsCritical ? "critical" : "")">
    <div class="alarm-beacon" aria-hidden="true"></div>
    <div>
        <strong>@AlarmBannerTitle</strong>
        <span>@AlarmBannerText</span>
    </div>
    <a href="alarmas">Ver alarmas</a>
</div>

@code {
    [Parameter]
    public bool? PlcConnected { get; set; }

    private int ActiveAlarmCount;
    private bool HasCriticalAlarm;
    private string? LatestAlarmMessage;
    private PeriodicTimer? alarmTimer;
    private CancellationTokenSource? alarmCts;

    private bool IsPlcInterrupted => PlcConnected == false;
    private bool IsActive => IsPlcInterrupted || ActiveAlarmCount > 0;
    private bool IsCritical => IsPlcInterrupted || HasCriticalAlarm;

    private string AlarmBannerTitle =>
        IsPlcInterrupted
            ? "ALERTA DE PROCESO: ENLACE CON EL AUTÓMATA INTERRUMPIDO"
            : ActiveAlarmCount == 0
                ? "Sin alarmas activas"
                : HasCriticalAlarm ? "Alarma crítica activa" : "Alarmas activas";

    private string AlarmBannerText =>
        IsPlcInterrupted
            ? "No se recibe telemetría del PLC Siemens S7-1200 ni del motor de adquisición. Los mandos de control están bloqueados por seguridad física de la planta."
            : ActiveAlarmCount == 0
                ? "Sistema sin eventos activos reportados."
                : $"{ActiveAlarmCount} activa(s). {LatestAlarmMessage}";

    protected override async Task OnInitializedAsync()
    {
        alarmCts = new CancellationTokenSource();
        await RefreshAlarmsAsync();
        alarmTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = AlarmLoopAsync(alarmCts.Token);
    }

    private async Task AlarmLoopAsync(CancellationToken cancellationToken)
    {
        if (alarmTimer is null) return;

        try
        {
            while (await alarmTimer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshAlarmsAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAlarmsAsync()
    {
        try
        {
            var alarms = await Api.GetActiveAlarmsAsync(alarmCts?.Token ?? CancellationToken.None);
            ActiveAlarmCount = alarms.Count;
            HasCriticalAlarm = alarms.Any(a => string.Equals(a.Severity, "critical", StringComparison.OrdinalIgnoreCase));
            LatestAlarmMessage = alarms.FirstOrDefault()?.Message ?? string.Empty;
        }
        catch
        {
            ActiveAlarmCount = 0;
            HasCriticalAlarm = false;
            LatestAlarmMessage = "No se pudo consultar Node-RED.";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (alarmCts is not null)
        {
            await alarmCts.CancelAsync();
            alarmCts.Dispose();
        }

        alarmTimer?.Dispose();
    }
}
