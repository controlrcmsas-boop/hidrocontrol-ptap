<script>
    function toggleMobileNav() {
        var s = document.getElementById('appNavShell');
        if (s) {
            s.classList.toggle('mobile-open');
        }
    }
    function closeMobileNav() {
        var s = document.getElementById('appNavShell');
        if (s) {
            s.classList.remove('mobile-open');
        }
    }
</script>

@code {
    private string? _userName;
    private string? _userRole;
    private bool _isSimulador;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _userName = user.FindFirst("FullName")?.Value
                        ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                        ?? user.Identity.Name;

            if (user.IsInRole("Administrador"))
            {
                _userRole = "Administrador";
                _isAdmin = true;
            }
            else if (user.IsInRole("Gerente"))
            {
                _userRole = "Gerente";
            }
            else if (user.IsInRole("Operador"))
            {
                _userRole = "Operador";
            }
            else if (user.IsInRole("Simulador"))
            {
                _userRole = "Simulador";
                _isSimulador = true;
            }
            else
            {
                _userRole = "Demo";
            }
        }
    }
}

<style>
.nav-links-list {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 12px;
    font-size: 0.86rem;
    border-radius: 8px;
    color: #94A3B8;
    text-decoration: none;
    border: 1px solid transparent;
    transition: all 0.15s ease;
}

.nav-link:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.05);
}

.nav-link.active {
    color: #FFFFFF;
    background: rgba(56, 189, 248, 0.12);
    border-color: rgba(56, 189, 248, 0.25);
    font-weight: 600;
}

.nav-icon {
    color: #64748B;
    flex-shrink: 0;
    transition: color 0.15s ease;
}

.nav-link:hover .nav-icon {
    color: #CBD5E1;
}

.nav-link.active .nav-icon {
    color: #38BDF8;
}

.role-badge-pill {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 500;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
    width: fit-content;
    margin-top: 0.2rem;
    background: rgba(255, 255, 255, 0.05);
    color: #94A3B8;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.login-nav-link {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    color: #E2E8F0 !important;
    text-align: center;
    border-radius: 6px;
    margin-top: 0.5rem;
    font-size: 0.82rem;
}
</style>
