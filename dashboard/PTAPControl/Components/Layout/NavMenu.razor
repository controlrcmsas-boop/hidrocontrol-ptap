@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using PTAPControl.Data
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<div class="nav-shell" id="appNavShell">
    <div class="nav-top-bar">
        <a class="brand" href="@(_isAdmin ? "admin/users" : (_isSimulador ? "simulador" : ""))" onclick="closeMobileNav()">
            <span>H</span>
            <strong>HIDROCONTROL</strong>
        </a>
        <button type="button" class="mobile-nav-toggle" onclick="toggleMobileNav()" aria-label="Abrir menú de navegación">
            <span class="icon-closed">☰</span>
            <span class="icon-opened">✕</span>
        </button>
    </div>

    <div class="nav-collapsible">
        <nav>
            <AuthorizeView Roles="Operador,Gerente">
                <Authorized>
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" onclick="closeMobileNav()">🏭 PTAP Control</NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Operador">
                <Authorized>
                    <NavLink class="nav-link" href="analisis-ia" onclick="closeMobileNav()">🤖 Análisis IA <span class="ai-nav-pill">PRO</span></NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Operador,Gerente">
                <Authorized>
                    <NavLink class="nav-link" href="historicos" onclick="closeMobileNav()">📊 Históricos</NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Operador">
                <Authorized>
                    <NavLink class="nav-link" href="alarmas" onclick="closeMobileNav()">🔔 Alarmas</NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Simulador,Demo">
                <Authorized>
                    <NavLink class="nav-link" href="simulador" onclick="closeMobileNav()">🎮 Simulador PLC</NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Administrador">
                <Authorized>
                    <NavLink class="nav-link" href="configuracion" onclick="closeMobileNav()">⚙️ Configuración</NavLink>
                    <hr class="nav-divider" />
                    <NavLink class="nav-link nav-link-admin" href="admin/users" onclick="closeMobileNav()">👥 Usuarios</NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView>
                <NotAuthorized>
                    <NavLink class="nav-link" href="login" onclick="closeMobileNav()">🔑 Iniciar Sesión</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>

        <!-- Info del usuario autenticado -->
        <div class="nav-user-section">
            <AuthorizeView>
                <Authorized>
                    <div class="nav-user-info">
                        <div class="nav-user-avatar">@(_userName?.FirstOrDefault() ?? '?')</div>
                        <div class="nav-user-details">
                            <span class="nav-user-name">@_userName</span>
                            <span class="role-badge-pill role-@(_userRole?.ToLower())">ROL: @_userRole</span>
                        </div>
                    </div>
                    <a class="nav-logout" href="/logout">🚪 Cerrar sesión</a>
                </Authorized>
                <NotAuthorized>
                    <a class="nav-link login-nav-link" href="/login" onclick="closeMobileNav()">🔑 Iniciar sesión</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

<script>
    function toggleMobileNav() {
        var s = document.getElementById('appNavShell');
        if (s) {
            s.classList.toggle('mobile-open');
        }
    }
    function closeMobileNav() {
        var s = document.getElementById('appNavShell');
        if (s) {
            s.classList.remove('mobile-open');
        }
    }
</script>

@code {
    private string? _userName;
    private string? _userRole;
    private bool _isSimulador;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _userName = user.FindFirst("FullName")?.Value
                        ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                        ?? user.Identity.Name;

            if (user.IsInRole("Administrador"))
            {
                _userRole = "Administrador";
                _isAdmin = true;
            }
            else if (user.IsInRole("Gerente"))
            {
                _userRole = "Gerente";
            }
            else if (user.IsInRole("Operador"))
            {
                _userRole = "Operador";
            }
            else if (user.IsInRole("Simulador"))
            {
                _userRole = "Simulador";
                _isSimulador = true;
            }
            else
            {
                _userRole = "Demo";
            }
        }
    }
}

<style>
.role-badge-pill {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    width: fit-content;
    margin-top: 0.15rem;
}

.role-badge-pill.role-simulador {
    background: rgba(6, 182, 212, 0.15);
    color: #22d3ee;
    border: 1px solid rgba(6, 182, 212, 0.4);
}

.role-badge-pill.role-operador {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.4);
}

.role-badge-pill.role-gerente {
    background: rgba(139, 92, 246, 0.15);
    color: #a78bfa;
    border: 1px solid rgba(139, 92, 246, 0.4);
}

.role-badge-pill.role-administrador {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.4);
}

.role-badge-pill.role-demo {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.4);
}

.login-nav-link {
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid #38bdf8 !important;
    color: #38bdf8 !important;
    text-align: center;
    border-radius: 8px;
    margin-top: 0.5rem;
}
</style>
