@page "/alarmas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Operador")]
@rendermode InteractiveServer
@using PTAPControl.Models
@using PTAPControl.Services
@using PTAPControl.Components.Layout
@inject NodeRedApiClient Api

<PageTitle>Alarmas</PageTitle>

<section class="alarm-page">
    <header class="scada-header">
        <div>
            <h1>Alarmas del Sistema</h1>
        </div>
        <div class="header-actions">
            <button class="btn-pill-action" @onclick="LoadAsync">Actualizar</button>
            <TopUserNav />
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert-line">@ErrorMessage</div>
    }

    <!-- Guía de Configuración y Criterios de Alarmas para el Técnico -->
    <div class="alarm-guide-card">
        <h3>Guía de Configuración y Criterios de Alarmas</h3>
        <p>
            • <strong>Supervisión de Calidad:</strong> El sistema evalúa continuamente los límites de pH (6.5 — 8.5), Turbidez (&le; 2.0 NTU) y Conductividad (&le; 1.000 µS/cm).
        </p>
        <p>
            • <strong>Niveles de Severidad:</strong> low (registro informativo), medium (advertencia operativa en consola), high (alarma prioritaria en pantalla), critical (alerta crítica con notificación por correo y WhatsApp).
        </p>
    </div>

    <section class="panel-section alarm-summary">
        <h2>Alarmas activas</h2>
        <strong class="alarm-count">@ActiveAlarms.Count</strong>
    </section>

    <table class="history-table alarm-table">
        <thead>
            <tr>
                <th>Inicio</th>
                <th>Variable</th>
                <th>Mensaje</th>
                <th>Valor</th>
                <th>Severidad</th>
            </tr>
        </thead>
        <tbody>
            @if (ActiveAlarms.Count == 0)
            {
                <tr>
                    <td colspan="5">No hay alarmas activas.</td>
                </tr>
            }
            @foreach (var alarm in ActiveAlarms)
            {
                <tr>
                    <td>@alarm.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@DisplayName(alarm)</td>
                    <td>@alarm.Message</td>
                    <td>@DisplayValue(alarm)</td>
                    <td><span class="severity @alarm.Severity">@alarm.Severity</span></td>
                </tr>
            }
        </tbody>
    </table>

    <section class="history-section">
        <h2>Historico reciente</h2>
        <table class="history-table alarm-table">
            <thead>
                <tr>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Variable</th>
                    <th>Mensaje</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alarm in History)
                {
                    <tr>
                        <td>@alarm.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@(alarm.ClearedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
                        <td>@DisplayName(alarm)</td>
                        <td>@alarm.Message</td>
                        <td>@alarm.State</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</section>

@code {
    private List<AlarmEvent> ActiveAlarms = [];
    private List<AlarmEvent> History = [];
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            ActiveAlarms = await Api.GetActiveAlarmsAsync();
            History = await Api.GetAlarmHistoryAsync(100);
            ErrorMessage = null;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No se pudieron cargar alarmas: {ex.Message}";
        }
    }

    private static string DisplayName(AlarmEvent alarm) => string.IsNullOrWhiteSpace(alarm.NombreVisible) ? alarm.TagId : alarm.NombreVisible;

    private static string DisplayValue(AlarmEvent alarm)
    {
        if (alarm.ValueNumeric is not null) return alarm.ValueNumeric.Value.ToString("0.###");
        if (alarm.ValueBool is not null) return alarm.ValueBool.Value ? "TRUE" : "FALSE";
        return "-";
    }
}

<style>
.alarm-guide-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.1rem 1.35rem;
    margin-bottom: 1.25rem;
}

.alarm-guide-card h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: #38BDF8;
    margin: 0 0 6px;
}

.alarm-guide-card p {
    font-size: 0.84rem;
    color: #8C93A4;
    margin: 0 0 4px;
    line-height: 1.45;
}
</style>
