@page "/analisis-ia"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Operador")]
@rendermode InteractiveServer
@using PTAPControl.Models
@using PTAPControl.Services
@using PTAPControl.Components.Layout
@implements IAsyncDisposable
@inject NodeRedApiClient Api
@inject TypeSafeAiClientService TypeSafe
@inject AiChatStateService ChatState
@inject PtapKnowledgeService Knowledge

<PageTitle>Análisis IA — HIDROCONTROL PTAP</PageTitle>

<section class="ai-page">
    <!-- Encabezado Superior Estándar Unificado -->
    <header class="scada-header">
        <div class="scada-title-wrap">
            <h1>Análisis IA</h1>
            <p class="scada-subtitle">SCADA Cloud 24/7</p>
        </div>
        <div class="header-actions">
            @if (Evaluation is not null && (Evaluation.ConfidenceScore < 0.55 || Evaluation.RequiresOperatorIntervention))
            {
                <button type="button" class="btn-pill-action danger" @onclick="RestoreNormalOperationAsync" disabled="@IsAnalyzing" title="Restablecer planta y parámetros a operación nominal">
                    Restablecer Operación
                </button>
            }
            <button type="button" class="btn-pill-action @(IsAnalyzing ? "loading" : "")" @onclick="ExecuteComprehensiveAnalysisAsync" disabled="@IsAnalyzing">
                @(IsAnalyzing ? "Analizando Planta..." : "Analizar Estado de Planta")
            </button>
            <TopUserNav />
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="ai-status-banner">
            @StatusMessage
        </div>
    }

    <!-- Layout Principal: Barra Lateral Compacta + Chat Dominante Central -->
    <div class="ai-workspace-layout">
        <!-- Columna Izquierda: Datos Operativos, Dosificación y Estado (Sin Iconos, Simple y Claro) -->
        <aside class="ai-sidebar-column">
            <!-- 1. Estado y Salud Operativa -->
            @if (Evaluation is not null)
            {
                <div class="ai-sidebar-health-card">
                    <div class="ai-card-header-simple">
                        <span class="ai-card-title-simple">Estado Operativo</span>
                        <span class="ai-status-badge">
                            @Evaluation.OverallStatus
                        </span>
                    </div>

                    <div class="ai-metrics-compact-grid">
                        <div class="ai-metric-box">
                            <span class="ai-metric-box-label">Salud del Sistema</span>
                            <span class="ai-metric-box-val">@Evaluation.ScorePercentage%</span>
                        </div>
                        <div class="ai-metric-box">
                            <span class="ai-metric-box-label">Confianza</span>
                            <span class="ai-metric-box-val confidence-val">
                                @Evaluation.ConfidenceLevel (@Evaluation.ConfidenceScore.ToString("P0"))
                            </span>
                        </div>
                    </div>

                    <p class="ai-summary-text-clean">
                        @Evaluation.ExecutiveSummary
                    </p>

                    @if (Evaluation.ImmediateRecommendations.Count > 0)
                    {
                        <div class="ai-recommendation-box-clean">
                            <span class="ai-rec-title">Recomendación</span>
                            <span class="ai-rec-body">@Evaluation.ImmediateRecommendations.FirstOrDefault()</span>
                        </div>
                    }

                    <!-- Alerta e Intervención del Operador si Confianza es Baja -->
                    @if (Evaluation.RequiresOperatorIntervention)
                    {
                        <div class="intervention-alert-banner">
                            <div class="intervention-title">
                                Control Operativo Requerido
                            </div>
                            <p class="intervention-desc">
                                @Evaluation.InterventionReason
                            </p>
                        </div>

                        <!-- Mando Directo de Actuadores -->
                        <div class="manual-override-card">
                            <div class="override-header">
                                <strong>Mando de Actuadores</strong>
                                <span class="ai-status-badge">Manual</span>
                            </div>

                            <div class="override-actuator-row">
                                <div>
                                    <span class="override-actuator-name">Bomba Principal B1</span>
                                    <span class="override-actuator-status">
                                        @(Telemetry?.GetBool("bomba_principal_estado") == true ? "Encendida" : "Apagada")
                                    </span>
                                </div>
                                <button type="button" class="btn-pill-action @(Telemetry?.GetBool("bomba_principal_estado") == true ? "danger" : "")" 
                                        @onclick='() => ToggleActuatorAsync("bomba_principal", Telemetry?.GetBool("bomba_principal_estado") != true)'>
                                    @(Telemetry?.GetBool("bomba_principal_estado") == true ? "Apagar B1" : "Encender B1")
                                </button>
                            </div>

                            <div class="override-actuator-row">
                                <div>
                                    <span class="override-actuator-name">Dosificador Sulfato B2</span>
                                    <span class="override-actuator-status">
                                        @(Telemetry?.GetBool("dosificador_sulfato_estado") == true ? "Dosificando" : "Detenido")
                                    </span>
                                </div>
                                <button type="button" class="btn-pill-action @(Telemetry?.GetBool("dosificador_sulfato_estado") == true ? "danger" : "")" 
                                        @onclick='() => ToggleActuatorAsync("dosificador_sulfato", Telemetry?.GetBool("dosificador_sulfato_estado") != true)'>
                                    @(Telemetry?.GetBool("dosificador_sulfato_estado") == true ? "Detener B2" : "Iniciar B2")
                                </button>
                            </div>

                            <div class="override-actuator-row">
                                <div>
                                    <span class="override-actuator-name">Dosificador Cloro B3</span>
                                    <span class="override-actuator-status">
                                        @(Telemetry?.GetBool("dosificador_cloro_estado") == true ? "Dosificando" : "Detenido")
                                    </span>
                                </div>
                                <button type="button" class="btn-pill-action @(Telemetry?.GetBool("dosificador_cloro_estado") == true ? "danger" : "")" 
                                        @onclick='() => ToggleActuatorAsync("dosificador_cloro", Telemetry?.GetBool("dosificador_cloro_estado") != true)'>
                                    @(Telemetry?.GetBool("dosificador_cloro_estado") == true ? "Detener B3" : "Iniciar B3")
                                </button>
                            </div>

                            <button type="button" class="btn-pill-action danger" style="width: 100%; margin-top: 6px;" @onclick="ExecuteEmergencyStopAsync">
                                Parada General de Emergencia
                            </button>
                        </div>
                    }
                </div>
            }

            <!-- 2. Dosificación Sugerida (Limpia y Simple) -->
            <div class="ai-sidebar-dosing-section">
                <div class="ai-card-header-simple" style="padding: 0 4px;">
                    <span class="ai-card-title-simple">Dosificación Sugerida</span>
                </div>

                @if (DosingSuggestions.Count == 0)
                {
                    <div class="ai-empty-dosing">
                        Sin sugerencias pendientes.
                    </div>
                }
                else
                {
                    @foreach (var sugg in DosingSuggestions)
                    {
                        <div class="dosing-card-compact">
                            <div class="dosing-compact-header">
                                <strong>@sugg.Chemical</strong>
                                <span class="ai-status-badge">
                                    @sugg.Status
                                </span>
                            </div>

                            <div class="dosing-compact-vals">
                                <div>
                                    <small>Actual</small>
                                    <span>@sugg.CurrentValue</span>
                                </div>
                                <span class="dosing-arrow">&rarr;</span>
                                <div>
                                    <small>Sugerido</small>
                                    <strong>@sugg.SuggestedDoseMgL mg/L</strong>
                                </div>
                            </div>

                            <div class="dosing-reason-text">
                                @sugg.Reason
                            </div>

                            @if (sugg.Status == "Pendiente")
                            {
                                <div class="dosing-compact-actions">
                                    <button type="button" class="btn-pill-primary-sm" @onclick="() => ApproveSuggestionAsync(sugg)">
                                        Aplicar
                                    </button>
                                    <button type="button" class="btn-pill-secondary-sm" @onclick="() => DiscardSuggestion(sugg)">
                                        Descartar
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            <!-- 3. Anomalías Detectadas (Sin Iconos ni Amarillos) -->
            @if (Evaluation?.Anomalies != null && Evaluation.Anomalies.Count > 0)
            {
                <div class="ai-sidebar-health-card">
                    <span class="ai-card-title-simple">Anomalías Detectadas</span>
                    @foreach (var anomaly in Evaluation.Anomalies.Take(2))
                    {
                        <div class="anomaly-item-clean">
                            <strong>[@anomaly.Equipment] @anomaly.Title</strong>
                            <p>@anomaly.RecommendedAction</p>
                        </div>
                    }
                </div>
            }

            <!-- 4. Registro de Decisiones Auditadas (Sin Iconos) -->
            @if (TypeSafe.AuditLog.Count > 0)
            {
                <div class="ai-sidebar-health-card">
                    <span class="ai-card-title-simple">Últimas Acciones</span>
                    <div class="audit-list-clean">
                        @foreach (var audit in TypeSafe.AuditLog.TakeLast(3).Reverse())
                        {
                            <div class="audit-row-clean">
                                <span class="audit-time">@audit.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                <strong class="audit-chem">@audit.Chemical:</strong>
                                <span class="audit-action">@audit.Action</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </aside>

        <!-- Columna Central/Derecha: El Chat Inteligente -->
        <main class="ai-chat-dominant-area">
            <!-- Header del Chat -->
            <div class="dominant-chat-header">
                <div style="display: flex; align-items: center; gap: 0.85rem;">
                    <div class="agent-avatar-wrap">
                        <img src="images/agent-ai-core.jpg" alt="Asistente IA" class="agent-core-sphere-img" />
                    </div>
                    <div>
                        <h2>
                            <span>Asistente Operativo PTAP</span>
                        </h2>
                        <p>
                            Agua Cruda: <strong style="color: #38bdf8;">@(Telemetry?.GetNumber("turbidez_agua_cruda")?.ToString("F1") ?? "--") NTU</strong> &bull; 
                            Agua Tratada: <strong style="color: #38bdf8;">@(Telemetry?.GetNumber("turbidez_agua_tratada")?.ToString("F1") ?? "--") NTU</strong> &bull; 
                            Bomba: <strong style="color: @(Telemetry?.GetBool("bomba_principal_estado") == true ? "#38bdf8" : "#94a3b8");">@(Telemetry?.GetBool("bomba_principal_estado") == true ? "Encendida" : "Apagada")</strong>
                        </p>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="ai-status-badge">
                        En Línea
                    </span>
                    <button type="button" class="btn-pill-secondary-sm" @onclick="ClearChatHistory" title="Reiniciar conversación">
                        Limpiar
                    </button>
                </div>
            </div>

            <!-- Feed de Mensajes -->
            <div class="dominant-chat-feed" @ref="chatFeedRef">
                @foreach (var msg in ChatMessages)
                {
                    <div class="dominant-chat-bubble @(msg.Role == "user" ? "user" : "assistant")">
                        @if (msg.IsThinking)
                        {
                            <span><em>Analizando telemetría y estado de la planta...</em></span>
                        }
                        else
                        {
                            <div>@((MarkupString)FormatMarkdown(msg.Content))</div>

                            @if (msg.Action is not null)
                            {
                                <div class="chat-action-card @(msg.Action.ActionType == "START" ? "start" : "stop")" style="margin-top: 10px;">
                                    <div class="chat-action-header @(msg.Action.ActionType == "START" ? "start" : "stop")">
                                        <span>@(msg.Action.ActionType == "STOP_ALL" ? "PARADA GENERAL DE PLANTA" : msg.Action.ActionType == "STOP" ? "ORDEN DE APAGADO" : "ORDEN DE ARRANQUE")</span>
                                        <span class="ai-status-badge">
                                            @msg.Action.Status
                                        </span>
                                    </div>
                                    <div class="chat-action-body">
                                        <strong>Equipo:</strong> @msg.Action.EquipmentName<br />
                                        <strong>Motivo:</strong> @msg.Action.Reason
                                    </div>
                                    @if (msg.Action.Status == "Pendiente")
                                    {
                                        <div class="chat-action-btns">
                                            <button type="button" class="btn-pill-primary-sm" @onclick="() => ExecuteChatActionAsync(msg.Action)">
                                                Confirmar y Enviar al PLC
                                            </button>
                                            <button type="button" class="btn-pill-secondary-sm" @onclick="() => CancelChatAction(msg.Action)">
                                                Cancelar
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>

            <!-- Sugerencias de Consultas Rápidas (Botones Píldora Elegantes) -->
            <div class="dominant-quick-prompts">
                <button type="button" class="btn-pill-prompt danger" @onclick='() => SendQuickQueryAsync("Desenergiza y apaga toda la planta de inmediato por seguridad")'>
                    Desenergizar Todo
                </button>
                <button type="button" class="btn-pill-prompt" @onclick='() => SendQuickQueryAsync("Por favor apaga la bomba principal B1")'>
                    Apagar Bomba B1
                </button>
                <button type="button" class="btn-pill-prompt" @onclick='() => SendQuickQueryAsync("¿Cómo está la calidad y remoción de turbidez en este momento?")'>
                    Diagnóstico de Calidad
                </button>
                <button type="button" class="btn-pill-prompt" @onclick='() => SendQuickQueryAsync("¿Qué dosificación de coagulante recomiendas con el caudal actual?")'>
                    Dosificación Coagulante
                </button>
                <button type="button" class="btn-pill-prompt" @onclick='() => SendQuickQueryAsync("Explícame las consecuencias de tener un pH bajo en el proceso")'>
                    Consecuencias pH Bajo
                </button>
            </div>

            <!-- Barra de Entrada de Chat -->
            <div class="dominant-input-bar">
                <input type="text" placeholder="Escribe tu consulta o instrucción (ej: 'Apaga la bomba B1', 'Diagnóstico de calidad')..." 
                       @bind="CurrentQuestion" 
                       @bind:event="oninput" 
                       @onkeydown="HandleKeyDown" 
                       disabled="@IsAsking" />
                <button type="button" class="btn-pill-primary" @onclick="SendMessageAsync" disabled="@(IsAsking || string.IsNullOrWhiteSpace(CurrentQuestion))">
                    Enviar
                </button>
            </div>
        </main>
    </div>

    <!-- Capacitación del Asistente (Reglas Operativas de Planta) para el Operador -->
    <div class="ai-rules-card">
        <div class="ai-rules-header">
            <h3>Capacitación del Asistente (Reglas Operativas de Planta)</h3>
            <p>Define una condición de proceso y la acción que el supervisor virtual debe aplicar cuando esa condición ocurra:</p>
        </div>

        <div class="ai-rules-inputs-row">
            <div class="ai-rule-input-group">
                <label>Condición (Ej: "Turbidez > 2.0 NTU")</label>
                <input type="text" @bind="NewRuleCondition" placeholder="Ej: pH < 6.8 con caudal > 15 L/min" />
            </div>
            <div class="ai-rule-input-group">
                <label>Acción Técnica Recomendada</label>
                <input type="text" @bind="NewRuleAction" placeholder="Ej: Dosificar alcalinizante o subir coagulante a 42 mg/L" />
            </div>
            <button type="button" class="btn-pill-primary" style="height: 40px; padding: 0 1.25rem; font-size: 0.85rem;" @onclick="AddRuleAsync">
                + Enseñar Regla
            </button>
        </div>

        <div class="ai-rules-list-section">
            <span class="ai-rules-title">Reglas Operativas Registradas:</span>
            @if (Knowledge.Data.LearnedOperatorRules.Count == 0)
            {
                <p style="color: var(--muted); font-size: 0.84rem; font-style: italic; margin: 0;">No hay reglas registradas aún.</p>
            }
            else
            {
                <div class="ai-rules-flow-list">
                    @foreach (var rule in Knowledge.Data.LearnedOperatorRules)
                    {
                        <div class="ai-rule-item">
                            <span><strong style="color: #38BDF8;">[@rule.Id] SI</strong> @rule.Condition &rarr; <strong>@rule.Action</strong></span>
                            <button type="button" class="rule-btn-del" @onclick="() => RemoveRuleAsync(rule.Id)" title="Eliminar regla">&times;</button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string NewRuleCondition = string.Empty;
    private string NewRuleAction = string.Empty;
    private TelemetryResponse? Telemetry;
    private List<AlarmEvent> ActiveAlarms = [];
    private PtapOperationalEvaluation? Evaluation;
    private List<DosingSuggestion> DosingSuggestions = [];
    private IReadOnlyList<AiChatMessage> ChatMessages => ChatState.Messages;
    private string CurrentQuestion = string.Empty;
    private bool IsAnalyzing;
    private bool IsAsking;
    private string? StatusMessage;
    private bool IsStatusSuccess;
    private ElementReference chatFeedRef;
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;

    protected override async Task OnInitializedAsync()
    {
        cts = new CancellationTokenSource();
        
        ChatState.EnsureInitialized();
        await RefreshTelemetryAsync();
        
        // Evaluación inicial rápida para no bloquear el render
        Evaluation = TypeSafe.BuildFallbackCalibratedEvaluation(Telemetry, ActiveAlarms, 0);
        DosingSuggestions = Evaluation.DosingSuggestions;

        // Disparar evaluación completa con Jev en segundo plano
        _ = Task.Run(async () =>
        {
            await Task.Delay(300);
            await InvokeAsync(ExecuteComprehensiveAnalysisAsync);
        });

        timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = AutoRefreshTelemetryLoopAsync(cts.Token);
    }

    private async Task AutoRefreshTelemetryLoopAsync(CancellationToken token)
    {
        if (timer is null) return;
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await RefreshTelemetryAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshTelemetryAsync()
    {
        try
        {
            Telemetry = await Api.GetCurrentTelemetryAsync(cts?.Token ?? CancellationToken.None);
            ActiveAlarms = await Api.GetActiveAlarmsAsync(cts?.Token ?? CancellationToken.None);
        }
        catch
        {
            // fallback
        }
    }

    private async Task ExecuteComprehensiveAnalysisAsync()
    {
        if (IsAnalyzing) return;
        IsAnalyzing = true;
        StatusMessage = null;

        try
        {
            await RefreshTelemetryAsync();
            Evaluation = await TypeSafe.EvaluatePlantHealthAsync(Telemetry, ActiveAlarms, cts?.Token ?? CancellationToken.None);
            DosingSuggestions = Evaluation.DosingSuggestions;
            
            if (Evaluation.RequiresOperatorIntervention)
            {
                StatusMessage = Evaluation.InterventionReason;
                IsStatusSuccess = false;
            }
            else
            {
                StatusMessage = $"Diagnóstico completado con éxito. Estado: {Evaluation.OverallStatus} | Confianza: {Evaluation.ConfidenceLevel} ({Evaluation.ConfidenceScore:P0}).";
                IsStatusSuccess = true;
            }
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error al diagnosticar la planta: {ex.Message}";
            IsStatusSuccess = false;
        }
        finally
        {
            IsAnalyzing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SimulateLowConfidenceScenarioAsync()
    {
        IsAnalyzing = true;
        StatusMessage = "Inyectando perturbación física (Turbidez 85 NTU) y evaluando estado...";
        StateHasChanged();

        // 1. Inyectar perturbación en el motor de simulación física y telemetría
        await Api.SetSimulatorScenarioAsync("low_confidence");
        await RefreshTelemetryAsync();

        await Task.Delay(350);

        // 2. Evaluar escenario de baja confianza
        Evaluation = TypeSafe.SimulateLowConfidenceScenario(Telemetry, ActiveAlarms);
        DosingSuggestions = Evaluation.DosingSuggestions;
        
        StatusMessage = $"{Evaluation.InterventionReason}. Perturbación inyectada a la telemetría.";
        IsStatusSuccess = false;
        IsAnalyzing = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RestoreNormalOperationAsync()
    {
        IsAnalyzing = true;
        StatusMessage = "Restableciendo variables de planta a régimen nominal normal...";
        StateHasChanged();

        // 1. Restablecer escenario normal en el motor de simulación
        await Api.SetSimulatorScenarioAsync("normal");
        await RefreshTelemetryAsync();

        await Task.Delay(350);

        // 2. Re-evaluar planta
        await ExecuteComprehensiveAnalysisAsync();
        StatusMessage = "Planta restablecida a operación nominal. Telemetría sincronizada en rango seguro.";
        IsStatusSuccess = true;
        IsAnalyzing = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleActuatorAsync(string targetEquipment, bool turnOn)
    {
        var cmd = turnOn ? "start" : "stop";
        var name = targetEquipment switch
        {
            "bomba_principal" => "Bomba Principal B1",
            "dosificador_sulfato" => "Dosificador Sulfato B2",
            _ => "Dosificador Cloro B3"
        };

        try
        {
            await Api.SendCommandAsync(targetEquipment, cmd, cts?.Token ?? CancellationToken.None);
            TypeSafe.RecordAudit(new AiAuditEntry
            {
                Chemical = name,
                Action = turnOn ? "Arranque Manual" : "Apagado Manual",
                Operator = "Técnico Operador (Toma de Control)",
                DoseMgL = 0,
                Details = $"Actuador manipulado directamente por el operador.",
                RawWaterConditions = "CONDICIÓN CRÍTICA / MANDO DIRECTO"
            });

            StatusMessage = $"Control Manual: Orden de {(turnOn ? "ARRANQUE" : "APAGADO")} enviada al PLC para {name}.";
            IsStatusSuccess = true;
            await RefreshTelemetryAsync();
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error al enviar comando a {name}: {ex.Message}";
            IsStatusSuccess = false;
        }
    }

    private async Task ExecuteEmergencyStopAsync()
    {
        try
        {
            await Api.SendCommandAsync("bomba_principal", "stop", cts?.Token ?? CancellationToken.None);
            await Api.SendCommandAsync("dosificador_sulfato", "stop", cts?.Token ?? CancellationToken.None);
            await Api.SendCommandAsync("dosificador_cloro", "stop", cts?.Token ?? CancellationToken.None);

            TypeSafe.RecordAudit(new AiAuditEntry
            {
                Chemical = "TODA LA PLANTA",
                Action = "PARADA GENERAL DE EMERGENCIA",
                Operator = "Técnico Operador (Toma de Control)",
                DoseMgL = 0,
                Details = "Parada manual inmediata de todos los actuadores ejecutada en SCADA.",
                RawWaterConditions = "PARADA DE SEGURIDAD"
            });

            StatusMessage = "PARADA DE EMERGENCIA EJECUTADA: Bomba B1, Sulfato B2 y Cloro B3 apagados en el PLC.";
            IsStatusSuccess = false;
            await RefreshTelemetryAsync();
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error al ejecutar parada de emergencia: {ex.Message}";
            IsStatusSuccess = false;
        }
    }

    private async Task ApproveSuggestionAsync(DosingSuggestion suggestion)
    {
        suggestion.Status = "Aprobado";
        
        var rawTurb = Telemetry?.GetNumber("turbidez_agua_cruda")?.ToString("F1") ?? "--";
        var flow = Telemetry?.GetNumber("caudal_bomba_principal")?.ToString("F1") ?? "--";

        // Registrar en auditoría
        TypeSafe.RecordAudit(new AiAuditEntry
        {
            Chemical = suggestion.Chemical,
            Action = "Aprobado",
            Operator = "Operador Autorizado",
            DoseMgL = suggestion.SuggestedDoseMgL,
            Details = $"Aprobada consigna de {suggestion.SuggestedDoseMgL} mg/L ({suggestion.SuggestedFrequencyHz} Hz) para {suggestion.TargetEquipment}.",
            RawWaterConditions = $"Turb. Cruda: {rawTurb} NTU, Caudal: {flow} L/min"
        });

        // Enviar comando a Node-RED -> PLC
        try
        {
            var cmd = suggestion.SuggestedAction == "stop" ? "stop" : "start";
            var res = await Api.SendCommandAsync(suggestion.TargetEquipment, cmd, cts?.Token ?? CancellationToken.None);
            
            StatusMessage = $"Sugerencia Aprobada: Consigna de {suggestion.Chemical} ({suggestion.SuggestedDoseMgL} mg/L) enviada con éxito al PLC.";
            IsStatusSuccess = true;
        }
        catch (Exception ex)
        {
            StatusMessage = $"Sugerencia aprobada pero hubo un error de comunicación con el PLC: {ex.Message}";
            IsStatusSuccess = false;
        }
    }

    private void DiscardSuggestion(DosingSuggestion suggestion)
    {
        suggestion.Status = "Rechazado";
        
        var rawTurb = Telemetry?.GetNumber("turbidez_agua_cruda")?.ToString("F1") ?? "--";
        var flow = Telemetry?.GetNumber("caudal_bomba_principal")?.ToString("F1") ?? "--";

        TypeSafe.RecordAudit(new AiAuditEntry
        {
            Chemical = suggestion.Chemical,
            Action = "Rechazado",
            Operator = "Operador",
            DoseMgL = suggestion.SuggestedDoseMgL,
            Details = "Sugerencia descartada por el operador. Las consignas del PLC se mantienen sin modificaciones.",
            RawWaterConditions = $"Turb. Cruda: {rawTurb} NTU, Caudal: {flow} L/min"
        });

        StatusMessage = $"Sugerencia para {suggestion.Chemical} descartada. El PLC mantiene su operación habitual.";
        IsStatusSuccess = false;
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentQuestion) || IsAsking) return;

        var userText = CurrentQuestion.Trim();
        CurrentQuestion = string.Empty;

        ChatState.AddUserMessage(userText);
        var thinkingMsg = ChatState.AddThinkingMessage();
        IsAsking = true;

        try
        {
            await Task.Delay(150); // Sensación fluida de proceso
            var (response, action) = TypeSafe.ProcessCopilotQuery(userText, Telemetry, Evaluation);
            ChatState.ReplaceThinkingWithResponse(thinkingMsg, response, action);
        }
        catch (Exception ex)
        {
            ChatState.ReplaceThinkingWithResponse(thinkingMsg, $"Error al procesar consulta: {ex.Message}", null);
        }
        finally
        {
            IsAsking = false;
        }
    }

    private async Task ExecuteChatActionAsync(AiProposedAction action)
    {
        action.Status = "Ejecutado";

        try
        {
            if (action.ActionType == "STOP_ALL")
            {
                await Api.SendCommandAsync("bomba_principal", "stop", cts?.Token ?? CancellationToken.None);
                await Api.SendCommandAsync("dosificador_sulfato", "stop", cts?.Token ?? CancellationToken.None);
                await Api.SendCommandAsync("dosificador_cloro", "stop", cts?.Token ?? CancellationToken.None);

                TypeSafe.RecordAudit(new AiAuditEntry
                {
                    Chemical = "PLANTA GENERAL",
                    Action = "DESENERGIZACIÓN / STOP GENERAL",
                    Operator = "Operador (Vía Asistente IA)",
                    DoseMgL = 0,
                    Details = $"Orden de desenergización ejecutada: Bomba B1 y dosificadores apagados. Motivo: {action.Reason}",
                    RawWaterConditions = "INSTRUCCIÓN VÍA ASISTENTE IA"
                });

                ChatState.AddAssistantMessage("**[Orden Ejecutada en PLC]:** Se han desenergizado y apagado con éxito la **Bomba Principal B1**, el **Dosificador de Sulfato B2** y el **Dosificador de Cloro B3**.");
            }
            else
            {
                var cmd = action.ActionType == "START" ? "start" : "stop";
                await Api.SendCommandAsync(action.TargetEquipment, cmd, cts?.Token ?? CancellationToken.None);

                TypeSafe.RecordAudit(new AiAuditEntry
                {
                    Chemical = action.EquipmentName,
                    Action = action.ActionType == "START" ? "Arranque SCADA" : "Apagado SCADA",
                    Operator = "Operador (Vía Asistente IA)",
                    DoseMgL = 0,
                    Details = $"Orden interactiva de {action.ActionType} ejecutada para {action.EquipmentName}. Motivo: {action.Reason}",
                    RawWaterConditions = "INSTRUCCIÓN VÍA ASISTENTE IA"
                });

                ChatState.AddAssistantMessage($"**[Orden Ejecutada en PLC]:** Se ha transmitido con éxito la orden de **{action.ActionType}** para **{action.EquipmentName}** al PLC Siemens S7-1200.");
            }

            StatusMessage = $"Acción de control para {action.EquipmentName} ejecutada en el PLC.";
            IsStatusSuccess = true;
            await RefreshTelemetryAsync();
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error al ejecutar orden en el PLC: {ex.Message}";
            IsStatusSuccess = false;
        }
    }

    private void CancelChatAction(AiProposedAction action)
    {
        action.Status = "Cancelado";
        ChatState.AddAssistantMessage($"**[Orden Cancelada]:** Se ha descartado la instrucción para {action.EquipmentName}. El PLC permanece sin modificaciones.");
    }

    private void ClearChatHistory()
    {
        ChatState.ClearHistory();
    }

    private async Task SendQuickQueryAsync(string query)
    {
        CurrentQuestion = query;
        await SendMessageAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessageAsync();
        }
    }

    private static string GetStatusBadgeClass(string status) => status.ToLowerInvariant() switch
    {
        "optimo" => "optimo",
        "estable" => "estable",
        "atencion requerida" => "atencion",
        _ => "critico"
    };

    private static string GetConfidenceClass(string confidence) => confidence.ToLowerInvariant() switch
    {
        "alta" => "alta",
        "media" => "media",
        _ => "baja"
    };

    private static string FormatMarkdown(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return string.Empty;
        
        var html = System.Net.WebUtility.HtmlEncode(raw);
        html = html.Replace("\n", "<br/>");
        
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*(.+?)\*", "<em>$1</em>");
        
        return html;
    }

    private async Task AddRuleAsync()
    {
        if (string.IsNullOrWhiteSpace(NewRuleCondition) || string.IsNullOrWhiteSpace(NewRuleAction))
            return;

        await Knowledge.AddRuleAsync(NewRuleCondition.Trim(), NewRuleAction.Trim());
        NewRuleCondition = string.Empty;
        NewRuleAction = string.Empty;
    }

    private async Task RemoveRuleAsync(string ruleId)
    {
        await Knowledge.RemoveRuleAsync(ruleId);
    }

    public async ValueTask DisposeAsync()
    {
        if (cts is not null)
        {
            await cts.CancelAsync();
            cts.Dispose();
        }
        timer?.Dispose();
    }
}

