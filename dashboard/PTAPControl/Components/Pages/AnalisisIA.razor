@page "/analisis-ia"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Operador")]
@rendermode InteractiveServer
@using PTAPControl.Models
@using PTAPControl.Services
@implements IAsyncDisposable
@inject NodeRedApiClient Api
@inject TypeSafeAiClientService TypeSafe
@inject AiChatStateService ChatState

<PageTitle>Evaluación TypeSafe AI - HIDROCONTROL PTAP</PageTitle>

<section class="ai-page">
    <!-- Encabezado Superior Compacto -->
    <header class="ai-header-banner">
        <div class="ai-header-title">
            <p class="eyebrow">HIDROCONTROL PTAP V2.2 &bull; TYPESAFE AI (JEV SYSTEM ONE)</p>
            <h1>
                <span>🛡️</span>
                <span>Evaluación Operativa SCADA &amp; Decisiones Tipadas</span>
            </h1>
        </div>
        <div class="ai-header-actions" style="display: flex; gap: 10px; align-items: center;">
            <button type="button" class="btn-sim-low-conf" @onclick="SimulateLowConfidenceScenarioAsync" disabled="@IsAnalyzing" title="Simular condición crítica con factor de confianza bajo (<55%)">
                <span>⚠️ Simular Baja Confianza (38%)</span>
            </button>
            <button type="button" class="btn-ai-primary" @onclick="ExecuteComprehensiveAnalysisAsync" disabled="@IsAnalyzing">
                @if (IsAnalyzing)
                {
                    <span>⏳ Evaluando con Jev...</span>
                }
                else
                {
                    <span>⚡ Evaluar con TypeSafe Jev (En Vivo)</span>
                }
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="alert-line @(IsStatusSuccess ? "alert-success" : "")">
            @StatusMessage
        </div>
    }

    <!-- Layout Principal: Barra Lateral Compacta + Chat Dominante Central -->
    <div class="ai-workspace-layout">
        <!-- Columna Izquierda: Información de Planta, Dosificación Compacta y Anomalías -->
        <aside class="ai-sidebar-column">
            <!-- 1. Estado, Salud y Factor de Confianza Calibrado -->
            @if (Evaluation is not null)
            {
                <div class="ai-sidebar-health-card">
                    <div class="ai-health-top-row">
                        <div class="ai-score-pill">
                            <span>🩺</span>
                            <span>@Evaluation.ScorePercentage%</span>
                            <small>Salud</small>
                        </div>
                        <span class="ai-status-badge @GetStatusBadgeClass(Evaluation.OverallStatus)">
                            @Evaluation.OverallStatus
                        </span>
                    </div>

                    <!-- Factor de Confianza Calibrado para el SCADA -->
                    <div class="confidence-container">
                        <span class="confidence-title">Factor de Confianza Calibrado:</span>
                        <div style="display: flex; align-items: center; justify-content: space-between;">
                            <span class="confidence-pill @GetConfidenceClass(Evaluation.ConfidenceLevel)">
                                @(Evaluation.ConfidenceLevel == "Alta" ? "🛡️" : Evaluation.ConfidenceLevel == "Media" ? "⚠️" : "🚨")
                                Confianza @Evaluation.ConfidenceLevel (@Evaluation.ConfidenceScore.ToString("P0"))
                            </span>
                            <small style="color: #94a3b8; font-size: 0.72rem;">@(Evaluation.IsLiveApi ? "⚡ API En Vivo" : "🛡️ Motor Local Seguro")</small>
                        </div>
                    </div>

                    <!-- Alerta de Intervención del Operador si Confianza es Baja o hay Condición Crítica -->
                    @if (Evaluation.RequiresOperatorIntervention)
                    {
                        <div class="intervention-alert-banner">
                            <div style="display: flex; align-items: center; gap: 6px; font-weight: 800; color: #f87171; font-size: 0.82rem;">
                                <span>🚨</span>
                                <span>TOMA DE CONTROL OPERATIVO REQUERIDA</span>
                            </div>
                            <p style="margin: 2px 0 0 0; font-size: 0.76rem; line-height: 1.3; color: #fecaca;">
                                @Evaluation.InterventionReason
                            </p>
                        </div>

                        <!-- Panel de Control Manual de Actuadores para el Operador -->
                        <div class="manual-override-card">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                                <strong style="color: #fca5a5; font-size: 0.82rem; display: flex; align-items: center; gap: 5px;">
                                    <span>🎮</span> Mando Directo de Actuadores
                                </strong>
                                <span class="supervision-pill" style="background: rgba(239, 68, 68, 0.2); border-color: #ef4444; color: #f87171; font-size: 0.65rem; padding: 2px 6px;">
                                    Técnico Operador
                                </span>
                            </div>

                            <div class="override-actuator-row">
                                <div>
                                    <span class="override-actuator-name">Bomba Principal B1</span>
                                    <span class="override-actuator-status @(Telemetry?.GetBool("bomba_principal_estado") == true ? "on" : "off")">
                                        @(Telemetry?.GetBool("bomba_principal_estado") == true ? "ENCENDIDA (ON)" : "APAGADA (OFF)")
                                    </span>
                                </div>
                                <button type="button" class="btn-override @(Telemetry?.GetBool("bomba_principal_estado") == true ? "stop" : "start")" 
                                        @onclick='() => ToggleActuatorAsync("bomba_principal", Telemetry?.GetBool("bomba_principal_estado") != true)'>
                                    @(Telemetry?.GetBool("bomba_principal_estado") == true ? "🛑 Apagar B1" : "🟢 Encender B1")
                                </button>
                            </div>

                            <div class="override-actuator-row">
                                <div>
                                    <span class="override-actuator-name">Dosificador Sulfato B2</span>
                                    <span class="override-actuator-status @(Telemetry?.GetBool("dosificador_sulfato_estado") == true ? "on" : "off")">
                                        @(Telemetry?.GetBool("dosificador_sulfato_estado") == true ? "DOSIFICANDO" : "DETENIDO")
                                    </span>
                                </div>
                                <button type="button" class="btn-override @(Telemetry?.GetBool("dosificador_sulfato_estado") == true ? "stop" : "start")" 
                                        @onclick='() => ToggleActuatorAsync("dosificador_sulfato", Telemetry?.GetBool("dosificador_sulfato_estado") != true)'>
                                    @(Telemetry?.GetBool("dosificador_sulfato_estado") == true ? "🛑 Detener B2" : "🟢 Iniciar B2")
                                </button>
                            </div>

                            <div class="override-actuator-row">
                                <div>
                                    <span class="override-actuator-name">Dosificador Cloro B3</span>
                                    <span class="override-actuator-status @(Telemetry?.GetBool("dosificador_cloro_estado") == true ? "on" : "off")">
                                        @(Telemetry?.GetBool("dosificador_cloro_estado") == true ? "DOSIFICANDO" : "DETENIDO")
                                    </span>
                                </div>
                                <button type="button" class="btn-override @(Telemetry?.GetBool("dosificador_cloro_estado") == true ? "stop" : "start")" 
                                        @onclick='() => ToggleActuatorAsync("dosificador_cloro", Telemetry?.GetBool("dosificador_cloro_estado") != true)'>
                                    @(Telemetry?.GetBool("dosificador_cloro_estado") == true ? "🛑 Detener B3" : "🟢 Iniciar B3")
                                </button>
                            </div>

                            <button type="button" class="btn-override-emergency" @onclick="ExecuteEmergencyStopAsync">
                                🚨 PARADA GENERAL DE EMERGENCIA
                            </button>
                        </div>
                    }

                    <div style="font-size: 0.72rem; color: #94a3b8; display: flex; justify-content: space-between; border-top: 1px solid rgba(255,255,255,0.06); padding-top: 6px;">
                        <span>Motor: <strong>@Evaluation.ModelVersion</strong></span>
                        <span>Latencia: <strong>@(Evaluation.LatencyMs) ms</strong></span>
                    </div>

                    <p style="font-size: 0.82rem; color: #cbd5e1; margin: 0; line-height: 1.35;">
                        @Evaluation.ExecutiveSummary
                    </p>

                    @if (Evaluation.ImmediateRecommendations.Count > 0)
                    {
                        <div style="background: rgba(0,0,0,0.25); padding: 8px 10px; border-radius: 4px; border-left: 2px solid var(--cyan);">
                            <small style="color: var(--cyan); font-weight: 700; display: block; margin-bottom: 2px;">Acción Inmediata SCADA:</small>
                            <span style="font-size: 0.78rem; color: #e2e8f0;">@Evaluation.ImmediateRecommendations.FirstOrDefault()</span>
                        </div>
                    }
                </div>
            }

            <!-- 2. Asesor de Dosificación Supervisada con Confianza TypeSafe -->
            <div class="ai-sidebar-dosing-section">
                <div class="section-title-badge">
                    <h2 style="font-size: 0.95rem;">
                        <span>🧪</span>
                        <span>Dosificación Supervisada</span>
                    </h2>
                    <span class="supervision-pill">Human-in-Loop</span>
                </div>

                @if (DosingSuggestions.Count == 0)
                {
                    <div style="padding: 12px; text-align: center; color: var(--muted); font-size: 0.8rem; background: rgba(17,31,39,0.5); border-radius: 6px;">
                        Sin sugerencias pendientes.
                    </div>
                }
                else
                {
                    @foreach (var sugg in DosingSuggestions)
                    {
                        <div class="dosing-card-compact @(sugg.Status == "Aprobado" ? "active" : "")">
                            <div class="dosing-compact-header">
                                <strong>@sugg.Chemical</strong>
                                <div style="display: flex; gap: 4px; align-items: center;">
                                    <span style="font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.4); color: #38bdf8;">
                                        @sugg.Confidence
                                    </span>
                                    <span class="ai-status-badge @(sugg.Status == "Aprobado" ? "optimo" : sugg.Status == "Rechazado" ? "critico" : "atencion")" style="font-size: 0.68rem; padding: 2px 6px;">
                                        @sugg.Status
                                    </span>
                                </div>
                            </div>

                            <div class="dosing-compact-vals">
                                <div>
                                    <small>Actual</small>
                                    <span>@sugg.CurrentValue</span>
                                </div>
                                <div style="color: #38bdf8; font-weight: bold;">&rarr;</div>
                                <div>
                                    <small>Sugerido TypeSafe</small>
                                    <strong>@sugg.SuggestedDoseMgL mg/L</strong>
                                </div>
                            </div>

                            <div style="font-size: 0.76rem; color: #94a3b8; line-height: 1.25;">
                                @sugg.Reason
                            </div>

                            @if (sugg.Status == "Pendiente")
                            {
                                <div class="dosing-compact-actions">
                                    <button type="button" class="btn-approve-compact" @onclick="() => ApproveSuggestionAsync(sugg)">
                                        ✓ Enviar a PLC
                                    </button>
                                    <button type="button" class="btn-discard-compact" @onclick="() => DiscardSuggestion(sugg)">
                                        ✕
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            <!-- 3. Anomalías Detectadas -->
            @if (Evaluation?.Anomalies != null && Evaluation.Anomalies.Count > 0)
            {
                <div class="ai-sidebar-health-card">
                    <strong style="font-size: 0.85rem; color: #e7c765; display: flex; align-items: center; gap: 6px;">
                        <span>⚠️</span> Anomalías Detectadas
                    </strong>
                    @foreach (var anomaly in Evaluation.Anomalies.Take(2))
                    {
                        <div style="font-size: 0.78rem; border-left: 2px solid @(anomaly.Level == "Critico" ? "#ff6b6b" : "#e7c765"); padding-left: 6px; margin-top: 4px;">
                            <strong style="color: #f1f5f9;">[@anomaly.Equipment] @anomaly.Title</strong>
                            <p style="margin: 2px 0 0 0; color: var(--muted);">@anomaly.RecommendedAction</p>
                        </div>
                    }
                </div>
            }

            <!-- 4. Registro de Auditoría de Decisiones -->
            @if (TypeSafe.AuditLog.Count > 0)
            {
                <div class="ai-sidebar-health-card">
                    <strong style="font-size: 0.85rem; color: #38bdf8; display: flex; align-items: center; gap: 6px;">
                        <span>📜</span> Últimas Decisiones Auditadas
                    </strong>
                    <div style="font-size: 0.76rem; max-height: 140px; overflow-y: auto;">
                        @foreach (var audit in TypeSafe.AuditLog.TakeLast(3).Reverse())
                        {
                            <div style="padding: 4px 0; border-bottom: 1px solid rgba(255,255,255,0.05);">
                                <span style="color: var(--muted);">@audit.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span> &bull; 
                                <strong style="color: #cbd5e1;">@audit.Chemical:</strong> @audit.Action
                            </div>
                        }
                    </div>
                </div>
            }
        </aside>

        <!-- Columna Central/Derecha: El Chat Inteligente es el PROTAGONISTA -->
        <main class="ai-chat-dominant-area">
            <!-- Header del Chat con Telemetría Activa -->
            <div class="dominant-chat-header">
                <div>
                    <h2>
                        <span>💬</span>
                        <span>Copiloto de Control PTAP</span>
                    </h2>
                    <p>
                        Agua Cruda: <strong style="color: var(--cyan);">@(Telemetry?.GetNumber("turbidez_agua_cruda")?.ToString("F1") ?? "--") NTU</strong> | 
                        Agua Tratada: <strong style="color: #48d597;">@(Telemetry?.GetNumber("turbidez_agua_tratada")?.ToString("F1") ?? "--") NTU</strong> | 
                        Bomba B1: <strong style="color: @(Telemetry?.GetBool("bomba_principal_estado") == true ? "#48d597" : "#ff6b6b");">@(Telemetry?.GetBool("bomba_principal_estado") == true ? "ON" : "OFF")</strong>
                    </p>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="supervision-pill" style="background: rgba(56, 189, 248, 0.15); border-color: #38bdf8; color: #38bdf8;">
                        🛡️ TypeSafe AI (Jev System One)
                    </span>
                    <button type="button" class="btn-clear-chat" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); border-radius: 20px; color: var(--muted); font-size: 0.75rem; padding: 4px 10px; cursor: pointer;" @onclick="ClearChatHistory" title="Reiniciar conversación">
                        <span>🗑️ Limpiar</span>
                    </button>
                </div>
            </div>

            <!-- Feed de Mensajes Expansivo -->
            <div class="dominant-chat-feed" @ref="chatFeedRef">
                @foreach (var msg in ChatMessages)
                {
                    <div class="dominant-chat-bubble @(msg.Role == "user" ? "user" : "assistant")">
                        @if (msg.IsThinking)
                        {
                            <span><em>Consultando modelo TypeSafe Jev y evaluando telemetría...</em></span>
                        }
                        else
                        {
                            <div>@((MarkupString)FormatMarkdown(msg.Content))</div>

                            @if (msg.Action is not null)
                            {
                                <div class="chat-action-card @(msg.Action.ActionType == "START" ? "start" : "stop")" style="margin-top: 10px;">
                                    <div class="chat-action-header @(msg.Action.ActionType == "START" ? "start" : "stop")">
                                        <span>@(msg.Action.ActionType == "STOP_ALL" ? "🚨 PARADA GENERAL DE PLANTA" : msg.Action.ActionType == "STOP" ? "🛑 ORDEN DE APAGADO" : "🟢 ORDEN DE ARRANQUE")</span>
                                        <span class="chat-action-status-pill @(msg.Action.Status == "Ejecutado" ? "executed" : msg.Action.Status == "Cancelado" ? "cancelled" : "")">
                                            @msg.Action.Status
                                        </span>
                                    </div>
                                    <div class="chat-action-body">
                                        <strong>Equipo:</strong> @msg.Action.EquipmentName<br />
                                        <strong>Motivo:</strong> @msg.Action.Reason
                                    </div>
                                    @if (msg.Action.Status == "Pendiente")
                                    {
                                        <div class="chat-action-btns">
                                            <button type="button" class="btn-chat-execute @(msg.Action.ActionType == "START" ? "start" : "")" @onclick="() => ExecuteChatActionAsync(msg.Action)">
                                                ⚡ Confirmar y Enviar al PLC
                                            </button>
                                            <button type="button" class="btn-chat-cancel" @onclick="() => CancelChatAction(msg.Action)">
                                                ✕ Cancelar
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>

            <!-- Sugerencias de Prompts Rápidos -->
            <div class="dominant-quick-prompts">
                <button type="button" class="btn-quick-query" style="border-color: rgba(255, 107, 107, 0.4); color: #ff8e8e;" @onclick='() => SendQuickQueryAsync("Desenergiza y apaga toda la planta de inmediato por seguridad")'>
                    🚨 Desenergizar Todo
                </button>
                <button type="button" class="btn-quick-query" style="border-color: rgba(255, 107, 107, 0.3); color: #ffadad;" @onclick='() => SendQuickQueryAsync("Por favor apaga la bomba principal B1")'>
                    🛑 Apagar Bomba B1
                </button>
                <button type="button" class="btn-quick-query" @onclick='() => SendQuickQueryAsync("¿Cómo está la calidad y remoción de turbidez en este momento?")'>
                    📊 Diagnóstico Calidad
                </button>
                <button type="button" class="btn-quick-query" @onclick='() => SendQuickQueryAsync("¿Qué dosificación de coagulante recomiendas con el caudal actual?")'>
                    🧪 Dosificación Coagulante
                </button>
                <button type="button" class="btn-quick-query" @onclick='() => SendQuickQueryAsync("Explícame las consecuencias de tener un pH bajo en el proceso")'>
                    💧 Consecuencias pH Bajo
                </button>
            </div>

            <!-- Barra de Entrada de Chat de Impacto -->
            <div class="dominant-input-bar">
                <input type="text" placeholder="Escribe tu consulta o instrucción técnica (ej: 'Apaga la bomba B1', 'Explícame el proceso de floculación')..." 
                       @bind="CurrentQuestion" 
                       @bind:event="oninput" 
                       @onkeydown="HandleKeyDown" 
                       disabled="@IsAsking" />
                <button type="button" class="btn-ai-primary" style="padding: 10px 22px; font-size: 0.95rem;" @onclick="SendMessageAsync" disabled="@(IsAsking || string.IsNullOrWhiteSpace(CurrentQuestion))">
                    <span>Enviar</span>
                </button>
            </div>
        </main>
    </div>
</section>

@code {
    private TelemetryResponse? Telemetry;
    private List<AlarmEvent> ActiveAlarms = [];
    private PtapOperationalEvaluation? Evaluation;
    private List<DosingSuggestion> DosingSuggestions = [];
    private IReadOnlyList<AiChatMessage> ChatMessages => ChatState.Messages;
    private string CurrentQuestion = string.Empty;
    private bool IsAnalyzing;
    private bool IsAsking;
    private string? StatusMessage;
    private bool IsStatusSuccess;
    private ElementReference chatFeedRef;
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;

    protected override async Task OnInitializedAsync()
    {
        cts = new CancellationTokenSource();
        
        ChatState.EnsureInitialized();
        await RefreshTelemetryAsync();
        
        // Evaluación inicial rápida para no bloquear el render
        Evaluation = TypeSafe.BuildFallbackCalibratedEvaluation(Telemetry, ActiveAlarms, 0);
        DosingSuggestions = Evaluation.DosingSuggestions;

        // Disparar evaluación completa con Jev en segundo plano
        _ = Task.Run(async () =>
        {
            await Task.Delay(300);
            await InvokeAsync(ExecuteComprehensiveAnalysisAsync);
        });

        timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = AutoRefreshTelemetryLoopAsync(cts.Token);
    }

    private async Task AutoRefreshTelemetryLoopAsync(CancellationToken token)
    {
        if (timer is null) return;
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await RefreshTelemetryAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshTelemetryAsync()
    {
        try
        {
            Telemetry = await Api.GetCurrentTelemetryAsync(cts?.Token ?? CancellationToken.None);
            ActiveAlarms = await Api.GetActiveAlarmsAsync(cts?.Token ?? CancellationToken.None);
        }
        catch
        {
            // fallback
        }
    }

    private async Task ExecuteComprehensiveAnalysisAsync()
    {
        if (IsAnalyzing) return;
        IsAnalyzing = true;
        StatusMessage = null;

        try
        {
            await RefreshTelemetryAsync();
            Evaluation = await TypeSafe.EvaluatePlantHealthAsync(Telemetry, ActiveAlarms, cts?.Token ?? CancellationToken.None);
            DosingSuggestions = Evaluation.DosingSuggestions;
            
            if (Evaluation.RequiresOperatorIntervention)
            {
                StatusMessage = Evaluation.InterventionReason;
                IsStatusSuccess = false;
            }
            else
            {
                StatusMessage = $"✅ Evaluación TypeSafe completada con éxito ({Evaluation.LatencyMs} ms). Estado: {Evaluation.OverallStatus}, Confianza: {Evaluation.ConfidenceLevel} ({Evaluation.ConfidenceScore:P0}).";
                IsStatusSuccess = true;
            }
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error al evaluar la planta con TypeSafe: {ex.Message}";
            IsStatusSuccess = false;
        }
        finally
        {
            IsAnalyzing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SimulateLowConfidenceScenarioAsync()
    {
        IsAnalyzing = true;
        StatusMessage = "⏳ Simulando perturbación de proceso y evaluando con TypeSafe Jev...";
        StateHasChanged();

        await Task.Delay(350);

        Evaluation = TypeSafe.SimulateLowConfidenceScenario(Telemetry, ActiveAlarms);
        DosingSuggestions = Evaluation.DosingSuggestions;
        
        StatusMessage = Evaluation.InterventionReason;
        IsStatusSuccess = false;
        IsAnalyzing = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleActuatorAsync(string targetEquipment, bool turnOn)
    {
        var cmd = turnOn ? "start" : "stop";
        var name = targetEquipment switch
        {
            "bomba_principal" => "Bomba Principal B1",
            "dosificador_sulfato" => "Dosificador Sulfato B2",
            _ => "Dosificador Cloro B3"
        };

        try
        {
            await Api.SendCommandAsync(targetEquipment, cmd, cts?.Token ?? CancellationToken.None);
            TypeSafe.RecordAudit(new AiAuditEntry
            {
                Chemical = name,
                Action = turnOn ? "Arranque Manual" : "Apagado Manual",
                Operator = "Técnico Operador (Toma de Control)",
                DoseMgL = 0,
                Details = $"Actuador manipulado directamente por el operador ante Factor de Confianza Bajo de TypeSafe.",
                RawWaterConditions = "CONDICIÓN CRÍTICA / MANDO DIRECTO"
            });

            StatusMessage = $"✅ Control Manual: Orden de {(turnOn ? "ARRANQUE" : "APAGADO")} enviada al PLC para {name}.";
            IsStatusSuccess = true;
            await RefreshTelemetryAsync();
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error al enviar comando a {name}: {ex.Message}";
            IsStatusSuccess = false;
        }
    }

    private async Task ExecuteEmergencyStopAsync()
    {
        try
        {
            await Api.SendCommandAsync("bomba_principal", "stop", cts?.Token ?? CancellationToken.None);
            await Api.SendCommandAsync("dosificador_sulfato", "stop", cts?.Token ?? CancellationToken.None);
            await Api.SendCommandAsync("dosificador_cloro", "stop", cts?.Token ?? CancellationToken.None);

            TypeSafe.RecordAudit(new AiAuditEntry
            {
                Chemical = "TODA LA PLANTA",
                Action = "PARADA GENERAL DE EMERGENCIA",
                Operator = "Técnico Operador (Toma de Control)",
                DoseMgL = 0,
                Details = "Parada manual inmediata de todos los actuadores ejecutada por baja confianza en SCADA.",
                RawWaterConditions = "PARADA DE SEGURIDAD"
            });

            StatusMessage = "🚨 PARADA DE EMERGENCIA EJECUTADA: Bomba B1, Sulfato B2 y Cloro B3 apagados en el PLC.";
            IsStatusSuccess = false;
            await RefreshTelemetryAsync();
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error al ejecutar parada de emergencia: {ex.Message}";
            IsStatusSuccess = false;
        }
    }

    private async Task ApproveSuggestionAsync(DosingSuggestion suggestion)
    {
        suggestion.Status = "Aprobado";
        
        var rawTurb = Telemetry?.GetNumber("turbidez_agua_cruda")?.ToString("F1") ?? "--";
        var flow = Telemetry?.GetNumber("caudal_bomba_principal")?.ToString("F1") ?? "--";

        // Registrar en auditoría
        TypeSafe.RecordAudit(new AiAuditEntry
        {
            Chemical = suggestion.Chemical,
            Action = "Aprobado",
            Operator = "Operador Autorizado",
            DoseMgL = suggestion.SuggestedDoseMgL,
            Details = $"Aprobada consigna de {suggestion.SuggestedDoseMgL} mg/L ({suggestion.SuggestedFrequencyHz} Hz) para {suggestion.TargetEquipment} (Confianza {suggestion.Confidence}).",
            RawWaterConditions = $"Turb. Cruda: {rawTurb} NTU, Caudal: {flow} L/min"
        });

        // Enviar comando a Node-RED -> PLC
        try
        {
            var cmd = suggestion.SuggestedAction == "stop" ? "stop" : "start";
            var res = await Api.SendCommandAsync(suggestion.TargetEquipment, cmd, cts?.Token ?? CancellationToken.None);
            
            StatusMessage = $"✅ Sugerencia Aprobada: Consigna de {suggestion.Chemical} ({suggestion.SuggestedDoseMgL} mg/L) enviada con éxito al PLC ({suggestion.TargetEquipment}).";
            IsStatusSuccess = true;
        }
        catch (Exception ex)
        {
            StatusMessage = $"⚠️ Sugerencia aprobada y registrada en auditoría, pero hubo un error de comunicación con el PLC: {ex.Message}";
            IsStatusSuccess = false;
        }
    }

    private void DiscardSuggestion(DosingSuggestion suggestion)
    {
        suggestion.Status = "Rechazado";
        
        var rawTurb = Telemetry?.GetNumber("turbidez_agua_cruda")?.ToString("F1") ?? "--";
        var flow = Telemetry?.GetNumber("caudal_bomba_principal")?.ToString("F1") ?? "--";

        TypeSafe.RecordAudit(new AiAuditEntry
        {
            Chemical = suggestion.Chemical,
            Action = "Rechazado",
            Operator = "Operador",
            DoseMgL = suggestion.SuggestedDoseMgL,
            Details = "Sugerencia descartada por el operador. Las consignas del PLC se mantienen sin modificaciones.",
            RawWaterConditions = $"Turb. Cruda: {rawTurb} NTU, Caudal: {flow} L/min"
        });

        StatusMessage = $"ℹ️ Sugerencia para {suggestion.Chemical} descartada. El PLC mantiene su operación habitual.";
        IsStatusSuccess = false;
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentQuestion) || IsAsking) return;

        var userText = CurrentQuestion.Trim();
        CurrentQuestion = string.Empty;

        ChatState.AddUserMessage(userText);
        var thinkingMsg = ChatState.AddThinkingMessage();
        IsAsking = true;

        try
        {
            await Task.Delay(150); // Sensación fluida de proceso
            var (response, action) = TypeSafe.ProcessCopilotQuery(userText, Telemetry, Evaluation);
            ChatState.ReplaceThinkingWithResponse(thinkingMsg, response, action);
        }
        catch (Exception ex)
        {
            ChatState.ReplaceThinkingWithResponse(thinkingMsg, $"Error al consultar TypeSafe: {ex.Message}", null);
        }
        finally
        {
            IsAsking = false;
        }
    }

    private async Task ExecuteChatActionAsync(AiProposedAction action)
    {
        action.Status = "Ejecutado";

        try
        {
            if (action.ActionType == "STOP_ALL")
            {
                await Api.SendCommandAsync("bomba_principal", "stop", cts?.Token ?? CancellationToken.None);
                await Api.SendCommandAsync("dosificador_sulfato", "stop", cts?.Token ?? CancellationToken.None);
                await Api.SendCommandAsync("dosificador_cloro", "stop", cts?.Token ?? CancellationToken.None);

                TypeSafe.RecordAudit(new AiAuditEntry
                {
                    Chemical = "PLANTA GENERAL",
                    Action = "DESENERGIZACIÓN / STOP GENERAL",
                    Operator = "Operador (Vía Copiloto TypeSafe)",
                    DoseMgL = 0,
                    Details = $"Orden de desenergización ejecutada: Bomba B1 y dosificadores apagados. Motivo: {action.Reason}",
                    RawWaterConditions = "INSTRUCCIÓN VÍA PROMPT COPILOTO"
                });

                ChatState.AddAssistantMessage("✅ **[Orden Ejecutada en PLC]:** Se han desenergizado y apagado con éxito la **Bomba Principal B1**, el **Dosificador de Sulfato B2** y el **Dosificador de Cloro B3**.");
            }
            else
            {
                var cmd = action.ActionType == "START" ? "start" : "stop";
                await Api.SendCommandAsync(action.TargetEquipment, cmd, cts?.Token ?? CancellationToken.None);

                TypeSafe.RecordAudit(new AiAuditEntry
                {
                    Chemical = action.EquipmentName,
                    Action = action.ActionType == "START" ? "Arranque SCADA" : "Apagado SCADA",
                    Operator = "Operador (Vía Copiloto TypeSafe)",
                    DoseMgL = 0,
                    Details = $"Orden interactiva de {action.ActionType} ejecutada para {action.EquipmentName}. Motivo: {action.Reason}",
                    RawWaterConditions = "INSTRUCCIÓN VÍA PROMPT COPILOTO"
                });

                ChatState.AddAssistantMessage($"✅ **[Orden Ejecutada en PLC]:** Se ha transmitido con éxito la orden de **{action.ActionType}** para **{action.EquipmentName}** al PLC Siemens S7-1200.");
            }

            StatusMessage = $"✅ Acción de control para {action.EquipmentName} ejecutada en el PLC.";
            IsStatusSuccess = true;
            await RefreshTelemetryAsync();
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error al ejecutar orden en el PLC: {ex.Message}";
            IsStatusSuccess = false;
        }
    }

    private void CancelChatAction(AiProposedAction action)
    {
        action.Status = "Cancelado";
        ChatState.AddAssistantMessage($"ℹ️ **[Orden Cancelada]:** Se ha descartado la instrucción para {action.EquipmentName}. El PLC permanece sin modificaciones.");
    }

    private void ClearChatHistory()
    {
        ChatState.ClearHistory();
    }

    private async Task SendQuickQueryAsync(string query)
    {
        CurrentQuestion = query;
        await SendMessageAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessageAsync();
        }
    }

    private static string GetStatusBadgeClass(string status) => status.ToLowerInvariant() switch
    {
        "optimo" => "optimo",
        "estable" => "estable",
        "atencion requerida" => "atencion",
        _ => "critico"
    };

    private static string GetConfidenceClass(string confidence) => confidence.ToLowerInvariant() switch
    {
        "alta" => "alta",
        "media" => "media",
        _ => "baja"
    };

    private static string FormatMarkdown(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return string.Empty;
        
        var html = System.Net.WebUtility.HtmlEncode(raw);
        html = html.Replace("\n", "<br/>");
        
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*(.+?)\*", "<em>$1</em>");
        
        return html;
    }

    public async ValueTask DisposeAsync()
    {
        if (cts is not null)
        {
            await cts.CancelAsync();
            cts.Dispose();
        }
        timer?.Dispose();
    }
}
