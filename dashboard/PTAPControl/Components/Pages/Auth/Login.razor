@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer
@layout AuthLayout
@using Microsoft.AspNetCore.Identity
@using PTAPControl.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject ILogger<Login> Logger

<PageTitle>Iniciar Sesión — HIDROCONTROL PTAP</PageTitle>

<div class="auth-card auth-card-login">
    <div class="auth-logo">
        <img src="images/hidrocontrol-brand-logo.png?v=2.2.10" alt="HIDROCONTROL PTAP" class="auth-brand-logo" />
        <p>Sistema de Control PTAP</p>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="auth-alert auth-alert-error">
            @_error
        </div>
    }

    <form method="post" action="/auth/login" class="login-form">
        <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "/")" />

        <div class="auth-field">
            <label for="emailInput">Correo electrónico</label>
            <input id="emailInput"
                   name="email"
                   type="email"
                   value="@_email"
                   @oninput="@((ChangeEventArgs e) => _email = e.Value?.ToString() ?? "")"
                   placeholder="usuario@empresa.com"
                   autocomplete="email"
                   required />
        </div>

        <div class="auth-field">
            <label for="passwordInput">Contraseña</label>
            <div class="password-wrapper">
                <input id="passwordInput"
                       name="password"
                       type="@(_showPassword ? "text" : "password")"
                       value="@_password"
                       @oninput="@((ChangeEventArgs e) => _password = e.Value?.ToString() ?? "")"
                       placeholder="Escribe tu contraseña"
                       autocomplete="current-password"
                       required />
                <button type="button" class="btn-eye" @onclick="TogglePassword"
                        title="@(_showPassword ? "Ocultar" : "Mostrar contraseña")">
                    @if (_showPassword)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                            <line x1="1" y1="1" x2="23" y2="23"/>
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    }
                </button>
            </div>
        </div>

        <div class="auth-field auth-checkbox">
            <input type="checkbox" name="rememberMe" id="remember" value="true" checked />
            <label for="remember">Mantener sesión activa</label>
        </div>

        <button type="submit" class="btn-auth-primary">
            Iniciar Sesión
        </button>
    </form>

    <!-- Panel de Perfiles de Demostración RBAC -->
    <div class="demo-section">
        <div class="demo-divider">
            <span>PERFILES DE PRUEBA</span>
        </div>
        <p class="demo-hint">Selecciona un perfil para cargar automáticamente sus credenciales:</p>

        <div class="demo-cards">
            <!-- 1. Rol Técnico / Operador -->
            <button type="button" class="demo-card @(_selectedRole == "operador" ? "active-demo" : "")" id="demo-operador"
                    @onclick='() => SelectDemoUser("operador@hidrocontrol.potenzia.app", "Operador2026!", "operador")'>
                <div class="card-top">
                    <span class="badge-role">Técnico / Operador</span>
                    <span class="badge-scope">Mando de Planta</span>
                </div>
                <div class="card-body-text">
                    <span class="user-id">operador@hidrocontrol.potenzia.app</span>
                    <span class="role-desc">Mando operativo de planta, actuadores, alarmas y modo operativo.</span>
                </div>
                <div class="card-footer-action">
                    <span class="btn-pill @(_selectedRole == "operador" ? "active" : "")">
                        @(_selectedRole == "operador" ? "Cargado" : "Cargar")
                    </span>
                </div>
            </button>

            <!-- 2. Rol Gerente General -->
            <button type="button" class="demo-card @(_selectedRole == "gerente" ? "active-demo" : "")" id="demo-gerente"
                    @onclick='() => SelectDemoUser("gerente@hidrocontrol.potenzia.app", "Gerente2026!", "gerente")'>
                <div class="card-top">
                    <span class="badge-role">Gerente General</span>
                    <span class="badge-scope">Supervisión</span>
                </div>
                <div class="card-body-text">
                    <span class="user-id">gerente@hidrocontrol.potenzia.app</span>
                    <span class="role-desc">Dashboard informativo de calidad de agua y comités ejecutivos.</span>
                </div>
                <div class="card-footer-action">
                    <span class="btn-pill @(_selectedRole == "gerente" ? "active" : "")">
                        @(_selectedRole == "gerente" ? "Cargado" : "Cargar")
                    </span>
                </div>
            </button>

            <!-- 3. Rol Simulador PLC -->
            <button type="button" class="demo-card @(_selectedRole == "simulador" ? "active-demo" : "")" id="demo-simulador"
                    @onclick='() => SelectDemoUser("simulador@hidrocontrol.potenzia.app", "Simulador2026!", "simulador")'>
                <div class="card-top">
                    <span class="badge-role">Simulador PLC</span>
                    <span class="badge-scope">Diseño y Pruebas</span>
                </div>
                <div class="card-body-text">
                    <span class="user-id">simulador@hidrocontrol.potenzia.app</span>
                    <span class="role-desc">Acceso exclusivo a emulador de fallas y diseño de Pantalla HMI.</span>
                </div>
                <div class="card-footer-action">
                    <span class="btn-pill @(_selectedRole == "simulador" ? "active" : "")">
                        @(_selectedRole == "simulador" ? "Cargado" : "Cargar")
                    </span>
                </div>
            </button>

            <!-- 4. Rol Administrador -->
            <button type="button" class="demo-card @(_selectedRole == "admin" ? "active-demo" : "")" id="demo-admin"
                    @onclick='() => SelectDemoUser("admin@hidrocontrol.potenzia.app", "Admin2026!", "admin")'>
                <div class="card-top">
                    <span class="badge-role">Administrador</span>
                    <span class="badge-scope">Gestión</span>
                </div>
                <div class="card-body-text">
                    <span class="user-id">admin@hidrocontrol.potenzia.app</span>
                    <span class="role-desc">Gestión de usuarios y accesos al sistema.</span>
                </div>
                <div class="card-footer-action">
                    <span class="btn-pill @(_selectedRole == "admin" ? "active" : "")">
                        @(_selectedRole == "admin" ? "Cargado" : "Cargar")
                    </span>
                </div>
            </button>
        </div>
    </div>

    <script>
        function loadDemoDirect(email, password) {
            var emailInput = document.getElementById('emailInput');
            var passInput = document.getElementById('passwordInput');
            if (emailInput) {
                emailInput.value = email;
                emailInput.dispatchEvent(new Event('input', { bubbles: true }));
                emailInput.dispatchEvent(new Event('change', { bubbles: true }));
            }
            if (passInput) {
                passInput.value = password;
                passInput.dispatchEvent(new Event('input', { bubbles: true }));
                passInput.dispatchEvent(new Event('change', { bubbles: true }));
            }
        }
    </script>

    <div class="auth-footer">
        <p>¿No tienes acceso? <a href="/register">Solicitar acceso</a></p>
    </div>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string? _error;
    private bool _showPassword;
    private string _selectedRole = "";

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Error))
        {
            _error = Error switch
            {
                "invalid" => "Correo o contraseña incorrectos.",
                "locked" => "Cuenta bloqueada temporalmente por intentos fallidos. Intenta en 5 minutos.",
                "unconfirmed" => "Debes confirmar tu correo electrónico antes de iniciar sesión.",
                "rejected" => "Tu solicitud de acceso fue rechazada. Contacta al administrador.",
                "empty" => "Por favor ingresa tu correo y contraseña.",
                _ => "Error al iniciar sesión."
            };
        }
    }

    private void TogglePassword() => _showPassword = !_showPassword;

    private void SelectDemoUser(string email, string password, string role)
    {
        _email = email;
        _password = password;
        _selectedRole = role;
        _error = null;
        StateHasChanged();
    }
}

<style>
.auth-card-login {
    max-width: 480px;
    background: #25272D;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    padding: 2rem;
}

input[type="checkbox"] {
    accent-color: #38BDF8;
    cursor: pointer;
}

.btn-auth-primary {
    width: 100%;
    padding: 0.65rem 1.4rem;
    background: #38BDF8;
    color: #0F172A;
    border: none;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.75rem;
    box-shadow: 0 2px 10px rgba(56, 189, 248, 0.25);
}

.btn-auth-primary:hover:not(:disabled) {
    background: #7DD3FC;
    color: #0F172A;
}

.demo-section {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.demo-divider {
    text-align: center;
    margin-bottom: 0.5rem;
}

.demo-divider span {
    background: #1D1E22;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #8E929A;
    padding: 0.2rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.05em;
}

.demo-hint {
    font-size: 0.75rem;
    color: #8E929A;
    text-align: center;
    margin: 0.5rem 0 0.85rem 0;
}

.demo-cards {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.demo-card {
    background: #1D1E22;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
    width: 100%;
    color: #E5E7EB;
}

.demo-card:hover {
    border-color: rgba(56, 189, 248, 0.3);
    background: #212328;
}

.demo-card.active-demo {
    border-color: rgba(56, 189, 248, 0.6);
    background: #212328;
}

.card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.25rem;
}

.badge-role {
    font-size: 0.8rem;
    font-weight: 500;
    color: #E5E7EB;
}

.badge-scope {
    font-size: 0.65rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.04);
    color: #8E929A;
    font-weight: 400;
}

.card-body-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
}

.user-id {
    font-family: inherit;
    font-size: 0.75rem;
    color: #8E929A;
}

.role-desc {
    font-size: 0.7rem;
    color: #737882;
}

.card-footer-action {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.4rem;
}

.btn-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    padding: 0.3rem 0.9rem;
    font-size: 0.72rem;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #2A2C31;
    color: #9CA3AF;
    transition: all 0.2s ease;
}

.btn-pill.active {
    background: #38BDF8;
    color: #0F172A;
    border-color: #38BDF8;
    font-weight: 600;
}
</style>
