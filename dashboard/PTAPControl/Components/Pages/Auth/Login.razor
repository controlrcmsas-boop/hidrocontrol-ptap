@page "/login"
@rendermode InteractiveServer
@layout AuthLayout
@using Microsoft.AspNetCore.Identity
@using PTAPControl.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject ILogger<Login> Logger

<PageTitle>Iniciar Sesión — HIDROCONTROL PTAP</PageTitle>

<div class="auth-card">
    <div class="auth-logo">
        <div class="auth-logo-icon">H</div>
        <h1>HIDROCONTROL</h1>
        <p>Sistema de Control PTAP</p>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="auth-alert auth-alert-error">
            <span>⚠️</span> @_error
        </div>
    }

    <EditForm Model="_model" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />

        <div class="auth-field">
            <label>Correo electrónico</label>
            <InputText @bind-Value="_model.Email"
                       type="email"
                       placeholder="usuario@empresa.com"
                       autocomplete="email" />
            <ValidationMessage For="@(() => _model.Email)" />
        </div>

        <div class="auth-field">
            <label>Contraseña</label>
            <div class="password-wrapper">
                <InputText @bind-Value="_model.Password"
                           type="@(_showPassword ? "text" : "password")"
                           placeholder="Escribe tu contraseña"
                           autocomplete="current-password" />
                <button type="button" class="btn-eye" @onclick="TogglePassword"
                        title="@(_showPassword ? "Ocultar" : "Mostrar contraseña")">
                    @if (_showPassword)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                            <line x1="1" y1="1" x2="23" y2="23"/>
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    }
                </button>
            </div>
            <ValidationMessage For="@(() => _model.Password)" />
        </div>

        <div class="auth-field auth-checkbox">
            <InputCheckbox @bind-Value="_model.RememberMe" id="remember" />
            <label for="remember">Mantener sesión activa</label>
        </div>

        <button type="submit" class="btn-auth-primary" disabled="@_loading">
            @if (_loading)
            {
                <span class="spinner-sm"></span>
                <span>Verificando...</span>
            }
            else
            {
                <span>🔑 Iniciar Sesión</span>
            }
        </button>
    </EditForm>

    <div class="auth-footer">
        <p>¿No tienes acceso? <a href="/register">Solicitar acceso</a></p>
    </div>
</div>

@code {
    private LoginModel _model = new();
    private string? _error;
    private bool _loading;
    private bool _showPassword;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        if (SignInManager.IsSignedIn(new System.Security.Claims.ClaimsPrincipal()))
            Nav.NavigateTo(ReturnUrl ?? "/", replace: true);
    }

    private void TogglePassword() => _showPassword = !_showPassword;

    private async Task HandleLogin()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var user = await UserManager.FindByEmailAsync(_model.Email ?? "");
            if (user is null)
            {
                _error = "Correo o contraseña incorrectos.";
                _loading = false;
                return;
            }

            if (!user.EmailConfirmed)
            {
                _error = "Debes confirmar tu correo electrónico antes de iniciar sesión.";
                _loading = false;
                return;
            }

            if (user.ApprovalStatus == ApprovalStatus.Pending)
            {
                Nav.NavigateTo("/pending-approval");
                return;
            }

            if (user.ApprovalStatus == ApprovalStatus.Rejected)
            {
                _error = "Tu solicitud de acceso fue rechazada. Contacta al administrador.";
                _loading = false;
                return;
            }

            var result = await SignInManager.PasswordSignInAsync(
                user, _model.Password ?? "", _model.RememberMe, lockoutOnFailure: true);

            if (result.Succeeded)
            {
                user.LastLoginAt = DateTime.UtcNow;
                await UserManager.UpdateAsync(user);
                Logger.LogInformation("Usuario {Email} inició sesión.", user.Email);
                Nav.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
            }
            else if (result.IsLockedOut)
            {
                _error = "Cuenta bloqueada temporalmente. Intenta en 5 minutos.";
            }
            else
            {
                _error = "Correo o contraseña incorrectos.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error en login para {Email}", _model.Email);
            _error = "Error inesperado. Intenta de nuevo.";
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El correo es requerido")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Formato de correo inválido")]
        public string? Email { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La contraseña es requerida")]
        public string? Password { get; set; }

        public bool RememberMe { get; set; }
    }
}
