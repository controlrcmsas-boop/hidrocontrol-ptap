@page "/pending-approval"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout AuthLayout

<PageTitle>Solicitud Pendiente — HIDROCONTROL PTAP</PageTitle>

<div class="auth-card">
    <div class="auth-pending-icon">⏳</div>
    <h2>Solicitud en revisión</h2>
    <p>
        Tu correo ha sido verificado correctamente. Tu solicitud de acceso está siendo revisada
        por el administrador del sistema.
    </p>
    <p>
        Recibirás una notificación cuando tu acceso sea aprobado. Si tienes urgencia,
        contacta directamente al administrador de la planta.
    </p>
    <div class="auth-footer" style="margin-top: 2rem;">
        <a href="/login" class="btn-auth-secondary">← Volver al inicio de sesión</a>
    </div>
</div>
