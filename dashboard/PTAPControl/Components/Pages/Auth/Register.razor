@page "/register"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer
@layout AuthLayout
@using Microsoft.AspNetCore.Identity
@using PTAPControl.Data
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav

<PageTitle>Solicitar Acceso — HIDROCONTROL PTAP</PageTitle>

<div class="auth-card auth-card-wide">
    <div class="auth-logo">
        <h1>HIDROCONTROL</h1>
        <p>Solicitud de Acceso al Sistema</p>
    </div>

    @if (_submitted)
    {
        <div class="auth-success-box">
            <div class="auth-success-icon">✅</div>
            <h3>¡Solicitud enviada!</h3>
            <p>
                Hemos enviado un enlace de verificación a <strong>@_submittedEmail</strong>.
                Una vez confirmes tu correo, el administrador revisará tu solicitud y recibirás
                notificación cuando tu acceso sea aprobado.
            </p>
            <a href="/login" class="btn-auth-secondary">Volver al inicio de sesión</a>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="auth-alert auth-alert-error">⚠️ @_error</div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleRegister" FormName="register">
            <DataAnnotationsValidator />

            <div class="auth-form-grid">
                <div class="auth-field">
                    <label>Nombre completo *</label>
                    <InputText @bind-Value="_model.FullName" placeholder="Tu nombre y apellido" autocomplete="name" />
                    <ValidationMessage For="@(() => _model.FullName)" />
                </div>

                <div class="auth-field">
                    <label>Empresa / Organización</label>
                    <InputText @bind-Value="_model.Company" placeholder="Nombre de tu empresa (opcional)" autocomplete="organization" />
                </div>

                <div class="auth-field auth-field-full">
                    <label>Correo electrónico *</label>
                    <InputText @bind-Value="_model.Email" type="email" placeholder="tu@empresa.com" autocomplete="email" />
                    <ValidationMessage For="@(() => _model.Email)" />
                </div>

                <div class="auth-field">
                    <label>Contraseña *</label>
                    <div class="password-wrapper">
                        <InputText @bind-Value="_model.Password"
                                   type="@(_showPass ? "text" : "password")"
                                   placeholder="Mínimo 8 caracteres"
                                   autocomplete="new-password" />
                        <button type="button" class="btn-eye" @onclick="() => _showPass = !_showPass">
                            @if (_showPass) {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                            } else {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            }
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _model.Password)" />
                    <small class="auth-hint">Mínimo 8 caracteres, una mayúscula, un número y un símbolo.</small>
                </div>

                <div class="auth-field">
                    <label>Confirmar contraseña *</label>
                    <div class="password-wrapper">
                        <InputText @bind-Value="_model.ConfirmPassword"
                                   type="@(_showPass ? "text" : "password")"
                                   placeholder="Repite la contraseña"
                                   autocomplete="new-password" />
                    </div>
                    <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                </div>

                <div class="auth-field auth-field-full">
                    <label>¿Para qué necesitas acceso?</label>
                    <InputTextArea @bind-Value="_model.Purpose" placeholder="Ej: Monitorear la PTAP del municipio de..." rows="3" />
                </div>
            </div>

            <div class="auth-terms">
                <InputCheckbox @bind-Value="_model.AcceptTerms" id="terms" />
                <label for="terms">
                    Acepto que mis datos serán utilizados únicamente para acceder a este sistema industrial.
                </label>
                <ValidationMessage For="@(() => _model.AcceptTerms)" />
            </div>

            <button type="submit" class="btn-auth-primary" disabled="@_loading">
                @if (_loading)
                {
                    <span class="spinner-sm"></span> <span>Enviando solicitud...</span>
                }
                else
                {
                    <span>📋 Enviar Solicitud de Acceso</span>
                }
            </button>
        </EditForm>

        <div class="auth-footer">
            <p>¿Ya tienes acceso? <a href="/login">Iniciar sesión</a></p>
        </div>
    }
</div>

@code {
    private RegisterModel _model = new();
    private bool _submitted;
    private bool _loading;
    private bool _showPass;
    private string? _error;
    private string? _submittedEmail;

    private async Task HandleRegister()
    {
        _loading = true;
        _error = null;

        var user = new ApplicationUser
        {
            UserName = _model.Email,
            Email = _model.Email,
            FullName = _model.FullName ?? "",
            Company = _model.Company,
            ApprovalStatus = ApprovalStatus.Pending,
            CreatedAt = DateTime.UtcNow
        };

        var result = await UserManager.CreateAsync(user, _model.Password ?? "");

        if (!result.Succeeded)
        {
            _error = string.Join(" ", result.Errors.Select(e => e.Description));
            _loading = false;
            return;
        }

        // En demo sin servidor SMTP: auto-confirmar el correo y dejar pendiente solo la aprobación del admin
        // TODO: Cuando se configure un servidor SMTP, usar tokens de confirmación reales
        var token = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        await UserManager.ConfirmEmailAsync(user, token);

        // Asignar rol Demo por defecto (el admin puede cambiar)
        await UserManager.AddToRoleAsync(user, "Demo");

        _submittedEmail = user.Email;
        _submitted = true;
        _loading = false;
    }

    private sealed class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre es requerido")]
        [System.ComponentModel.DataAnnotations.MinLength(3, ErrorMessage = "Mínimo 3 caracteres")]
        public string? FullName { get; set; }

        public string? Company { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El correo es requerido")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Formato inválido")]
        public string? Email { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La contraseña es requerida")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Mínimo 8 caracteres")]
        public string? Password { get; set; }

        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden")]
        public string? ConfirmPassword { get; set; }

        public string? Purpose { get; set; }

        [System.ComponentModel.DataAnnotations.Range(typeof(bool), "true", "true", ErrorMessage = "Debes aceptar los términos")]
        public bool AcceptTerms { get; set; }
    }
}
