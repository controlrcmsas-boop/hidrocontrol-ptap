@page "/historicos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Operador,Gerente,Simulador,Demo")]
@rendermode InteractiveServer
@implements IDisposable
@using PTAPControl.Models
@using PTAPControl.Services
@using PTAPControl.Components.Layout
@inject NodeRedApiClient Api

<PageTitle>Curvas de Proceso — HIDROCONTROL PTAP</PageTitle>

<section class="history-page">
    <header class="scada-header">
        <div class="scada-title-wrap">
            <h1>Curvas de Proceso</h1>
            <p class="scada-subtitle">SCADA Cloud 24/7</p>
        </div>
        <div class="header-actions">
            <a class="btn-pill-action download-link" href="@CsvHref" download="hidrocontrol-historicos.csv">
                Descargar CSV
            </a>
            <button class="btn-pill-action" @onclick="LoadAsync">
                Actualizar
            </button>

            <!-- Menú de usuario y campana de notificaciones en la esquina superior derecha -->
            <TopUserNav />
        </div>
    </header>

    <!-- Barra de control y filtrado temporal con botones píldora -->
    <div class="history-toolbar-card">
        <div class="toolbar-left">
            <span class="toolbar-label">Ventana Temporal:</span>
            <div class="range-buttons-group">
                <button type="button" class="btn-range @(SelectedRangeMinutes == 15 ? "active" : "")" 
                        @onclick="() => SetRange(15)">15 min</button>
                <button type="button" class="btn-range @(SelectedRangeMinutes == 30 ? "active" : "")" 
                        @onclick="() => SetRange(30)">30 min</button>
                <button type="button" class="btn-range @(SelectedRangeMinutes == 60 ? "active" : "")" 
                        @onclick="() => SetRange(60)">1 Hora</button>
            </div>
        </div>
        <div class="toolbar-right">
            <div class="toolbar-stat">
                <span class="stat-name">Puntos:</span>
                <strong class="stat-val">@RecentPoints.Count pts</strong>
            </div>
            <div class="toolbar-stat">
                <span class="stat-name">Intervalo:</span>
                <strong class="stat-val">@RangeStartText — @RangeEndText</strong>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert-line">@ErrorMessage</div>
    }

    <!-- GRID DE GRÁFICAS: 2 por fila en escritorio/tablet horizontal, 1 por fila en celular/tablet vertical -->
    <div class="charts-grid">
        <!-- 1. GRÁFICA INDIVIDUAL: SENSOR DE PH -->
        <section class="minimal-sensor-panel">
        <div class="sensor-chart-head">
            <div class="sensor-title-wrap">
                <h2>Sensor de pH</h2>
                <p class="sensor-sub">Potencial de Hidrógeno &bull; Rango Óptimo 6.5 — 8.5 pH</p>
            </div>
            <div class="sensor-reading-display">
                <span class="reading-num">@GetLatestValueNumeric("ph_agua_tratada").ToString("0.00", Culture)</span>
                <span class="reading-unit">pH</span>
            </div>
        </div>

        @{
            var phScale = CalculateScale("ph_agua_tratada", RecentPoints);
            var phChartData = BuildChartData("ph_agua_tratada", phScale.Min, phScale.Max);
        }

        <div class="chart-container" id="container-ph">
            <div class="chart-tooltip" id="tooltip-ph"></div>
            <div class="svg-chart-wrapper">
                <svg class="chart-interactive-svg" id="svg-ph" viewBox="0 0 760 520" 
                     data-chart-id="ph" data-points="@phChartData.JsonPoints" role="img" aria-label="Curva de pH">
                    <defs>
                        <linearGradient id="grad-ph" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.30" />
                            <stop offset="60%" stop-color="#38BDF8" stop-opacity="0.08" />
                            <stop offset="100%" stop-color="#38BDF8" stop-opacity="0.0" />
                        </linearGradient>
                    </defs>

                    <!-- Fondo de trazado recesado contrastante -->
                    <rect x="65" y="25" width="665" height="430" fill="#181A22" stroke="rgba(255, 255, 255, 0.05)" stroke-width="1" rx="10" />

                    <!-- Cuadrícula horizontal y etiquetas de escala dinámica Y -->
                    @for (int i = 0; i < phScale.Ticks.Count; i++)
                    {
                        var tickVal = phScale.Ticks[i];
                        var yPos = 25.0 + (i * (430.0 / (phScale.Ticks.Count - 1)));
                        <line x1="65" y1="@yPos.ToString("0.##", Culture)" x2="730" y2="@yPos.ToString("0.##", Culture)" stroke="rgba(255, 255, 255, 0.05)" stroke-width="1" />
                        @((MarkupString)$"<text x=\"56\" y=\"{(yPos + 4).ToString("0.##", Culture)}\" fill=\"#8C93A4\" font-size=\"11\" text-anchor=\"end\" font-weight=\"400\">{tickVal.ToString(phScale.Format, Culture)}</text>")
                    }

                    <!-- Cuadrícula vertical de tiempo (5 marcas) -->
                    @for (int i = 0; i <= 4; i++)
                    {
                        var xPos = 65.0 + i * (665.0 / 4.0);
                        <line x1="@xPos.ToString("0.##", Culture)" y1="25" x2="@xPos.ToString("0.##", Culture)" y2="455" stroke="rgba(255, 255, 255, 0.04)" stroke-width="1" />
                    }

                    <!-- Área con gradiente suave bajo la curva -->
                    @if (!string.IsNullOrWhiteSpace(phChartData.AreaPath))
                    {
                        <path d="@phChartData.AreaPath" fill="url(#grad-ph)" />
                    }

                    <!-- Curva suave Bezier estilizada -->
                    @if (!string.IsNullOrWhiteSpace(phChartData.CurvePath))
                    {
                        <path d="@phChartData.CurvePath" fill="none" stroke="#38BDF8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    }

                    <!-- Guía interactiva de cursor (oculta por defecto) -->
                    <line id="guide-line-ph" x1="0" y1="25" x2="0" y2="455" stroke="rgba(255, 255, 255, 0.25)" stroke-dasharray="3 3" stroke-width="1" style="display:none;" />
                    <circle id="guide-dot-ph" cx="0" cy="0" r="5" fill="#38BDF8" stroke="#0E1626" stroke-width="2" style="display:none;" />

                    <!-- Eje X: 5 marcas de tiempo claras -->
                    <text x="65" y="490" fill="#8C93A4" font-size="11" font-weight="400">@GetTimeAt(0.0)</text>
                    <text x="231.25" y="490" fill="#8C93A4" font-size="11" font-weight="400" text-anchor="middle">@GetTimeAt(0.25)</text>
                    <text x="397.5" y="490" fill="#8C93A4" font-size="11" font-weight="400" text-anchor="middle">@GetTimeAt(0.50)</text>
                    <text x="563.75" y="490" fill="#8C93A4" font-size="11" font-weight="400" text-anchor="middle">@GetTimeAt(0.75)</text>
                    <text x="730" y="490" fill="#8C93A4" font-size="11" font-weight="400" text-anchor="end">@GetTimeAt(1.0)</text>
                </svg>
            </div>
        </div>
    </section>

