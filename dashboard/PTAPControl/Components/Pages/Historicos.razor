@page "/historicos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Operador,Gerente")]
@rendermode InteractiveServer
@using PTAPControl.Models
@using PTAPControl.Services
@inject NodeRedApiClient Api

<PageTitle>Históricos y Tendencias — HIDROCONTROL PTAP</PageTitle>

<section class="history-page">
    <header class="scada-header">
        <div>
            <p class="eyebrow">HIDROCONTROL PTAP &bull; TELEMETRÍA Y CALIDAD</p>
            <h1>Curvas Históricas de Proceso</h1>
        </div>
        <div class="header-actions">
            <a class="refresh-button download-link" href="@CsvHref" download="hidrocontrol-historicos.csv">
                📥 Descargar CSV
            </a>
            <button class="refresh-button" @onclick="LoadAsync">
                🔄 Actualizar
            </button>
        </div>
    </header>

    <!-- Barra de control y filtrado temporal -->
    <div class="history-toolbar-card">
        <div class="toolbar-left">
            <span class="toolbar-label">⏱️ Ventana de Tiempo:</span>
            <div class="range-buttons-group">
                <button type="button" class="btn-range @(SelectedRangeMinutes == 60 ? "active" : "")" 
                        @onclick="() => SetRange(60)">1 Hora</button>
                <button type="button" class="btn-range @(SelectedRangeMinutes == 180 ? "active" : "")" 
                        @onclick="() => SetRange(180)">3 Horas</button>
                <button type="button" class="btn-range @(SelectedRangeMinutes == 720 ? "active" : "")" 
                        @onclick="() => SetRange(720)">12 Horas</button>
                <button type="button" class="btn-range @(SelectedRangeMinutes == 1440 ? "active" : "")" 
                        @onclick="() => SetRange(1440)">24 Horas</button>
            </div>
        </div>
        <div class="toolbar-right">
            <div class="toolbar-stat">
                <span class="stat-name">Muestras Registradas:</span>
                <strong class="stat-val">@RecentPoints.Count pts</strong>
            </div>
            <div class="toolbar-stat">
                <span class="stat-name">Período:</span>
                <strong class="stat-val">@RangeStartText — @RangeEndText</strong>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert-line">@ErrorMessage</div>
    }

    <!-- 1. GRÁFICA: AGUA CRUDA -->
    <section class="trend-panel">
        <div class="trend-head">
            <div class="trend-title-group">
                <div class="badge-stage badge-cruda">ETAPA ENTRADA</div>
                <h2>💧 Calidad de Agua Cruda</h2>
                <span class="trend-subtitle">@CurveSubtitle(RawSeries) &bull; Monitoreo continuo a la entrada de planta</span>
            </div>
            <div class="trend-legend">
                @foreach (var series in RawSeries)
                {
                    <div class="legend-card" style="border-left-color: @series.Color">
                        <span class="legend-dot" style="background: @series.Color"></span>
                        <div class="legend-info">
                            <span class="legend-label">@series.Label</span>
                            <strong class="legend-value" style="color: @series.Color">@GetLatestValue(series.Tag)</strong>
                        </div>
                    </div>
                }
            </div>
        </div>

        <svg class="trend-chart" viewBox="0 0 1060 360" role="img" aria-label="Curvas historicas de agua cruda">
            <defs>
                <linearGradient id="plotBgGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#0b1622" />
                    <stop offset="100%" stop-color="#080e15" />
                </linearGradient>
            </defs>

            <!-- Área de trazado -->
            <rect x="150" y="30" width="780" height="280" fill="url(#plotBgGrad)" stroke="rgba(78, 200, 216, 0.2)" stroke-width="1" rx="6" />

            <!-- Líneas de cuadrícula horizontal (5 niveles) -->
            @for (var i = 0; i < 5; i++)
            {
                var y = 30 + (i * 70.0);
                <line x1="150" y1="@y.ToString("0.#", Culture)" x2="930" y2="@y.ToString("0.#", Culture)" 
                      stroke="rgba(255, 255, 255, 0.06)" stroke-dasharray="4 4" stroke-width="1" />
            }

            <!-- Líneas de cuadrícula vertical (5 divisiones temporales) -->
            @for (var i = 0; i <= 4; i++)
            {
                var x = 150 + (i * 195.0);
                <line x1="@x.ToString("0.#", Culture)" y1="30" x2="@x.ToString("0.#", Culture)" y2="310" 
                      stroke="rgba(255, 255, 255, 0.04)" stroke-width="1" />
            }

            <!-- EJE 1 IZQUIERDA: pH (x = 55) -->
            <line x1="55" y1="30" x2="55" y2="310" stroke="#38bdf8" stroke-width="1.5" />
            <text x="47" y="34" fill="#38bdf8" font-size="11" text-anchor="end" font-weight="700">14.0</text>
            <text x="47" y="104" fill="#38bdf8" font-size="11" text-anchor="end" font-weight="700">10.5</text>
            <text x="47" y="174" fill="#38bdf8" font-size="11" text-anchor="end" font-weight="700">7.0</text>
            <text x="47" y="244" fill="#38bdf8" font-size="11" text-anchor="end" font-weight="700">3.5</text>
            <text x="47" y="314" fill="#38bdf8" font-size="11" text-anchor="end" font-weight="700">0.0</text>
            <text x="16" y="170" fill="#38bdf8" font-size="11" text-anchor="middle" transform="rotate(-90 16 170)" font-weight="800" letter-spacing="0.05em">pH (0 - 14)</text>

            <!-- EJE 2 IZQUIERDA: Conductividad (x = 140) -->
            <line x1="140" y1="30" x2="140" y2="310" stroke="#10b981" stroke-width="1.5" />
            <text x="132" y="34" fill="#10b981" font-size="10.5" text-anchor="end" font-weight="700">2000</text>
            <text x="132" y="104" fill="#10b981" font-size="10.5" text-anchor="end" font-weight="700">1500</text>
            <text x="132" y="174" fill="#10b981" font-size="10.5" text-anchor="end" font-weight="700">1000</text>
            <text x="132" y="244" fill="#10b981" font-size="10.5" text-anchor="end" font-weight="700">500</text>
            <text x="132" y="314" fill="#10b981" font-size="10.5" text-anchor="end" font-weight="700">0</text>
            <text x="76" y="170" fill="#10b981" font-size="11" text-anchor="middle" transform="rotate(-90 76 170)" font-weight="800" letter-spacing="0.05em">Conductividad (µS/cm)</text>

            <!-- EJE DERECHA: Turbidez (x = 940) -->
            <line x1="940" y1="30" x2="940" y2="310" stroke="#f59e0b" stroke-width="1.5" />
            <text x="948" y="34" fill="#f59e0b" font-size="11" text-anchor="start" font-weight="700">100</text>
            <text x="948" y="104" fill="#f59e0b" font-size="11" text-anchor="start" font-weight="700">75</text>
            <text x="948" y="174" fill="#f59e0b" font-size="11" text-anchor="start" font-weight="700">50</text>
            <text x="948" y="244" fill="#f59e0b" font-size="11" text-anchor="start" font-weight="700">25</text>
            <text x="948" y="314" fill="#f59e0b" font-size="11" text-anchor="start" font-weight="700">0</text>
            <text x="1005" y="170" fill="#f59e0b" font-size="11" text-anchor="middle" transform="rotate(90 1005 170)" font-weight="800" letter-spacing="0.05em">Turbidez (NTU)</text>

            <!-- Trazado de Curvas -->
            @foreach (var series in RawSeries)
            {
                var points = BuildPolyline(series.Tag);
                if (!string.IsNullOrWhiteSpace(points))
                {
                    <polyline points="@points" fill="none" stroke="@series.Color" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                }
            }

            <!-- Marcas de tiempo en el eje inferior -->
            <text x="150" y="334" fill="#94a3b8" font-size="11" font-weight="600" text-anchor="start">@RangeStartText</text>
            <text x="345" y="334" fill="#64748b" font-size="10.5" font-weight="500" text-anchor="middle">@GetTimeAt(0.25)</text>
            <text x="540" y="334" fill="#64748b" font-size="10.5" font-weight="500" text-anchor="middle">@GetTimeAt(0.50)</text>
            <text x="735" y="334" fill="#64748b" font-size="10.5" font-weight="500" text-anchor="middle">@GetTimeAt(0.75)</text>
            <text x="930" y="334" fill="#94a3b8" font-size="11" font-weight="600" text-anchor="end">@RangeEndText</text>
        </svg>
    </section>

