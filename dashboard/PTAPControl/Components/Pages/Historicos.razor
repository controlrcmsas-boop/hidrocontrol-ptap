        <div class="trend-head">
            <div class="trend-title-group">
                <div class="badge-stage badge-tratada">ETAPA SALIDA</div>
                <h2>✨ Calidad de Agua Tratada</h2>
                <span class="trend-subtitle">@CurveSubtitle(TreatedSeries) &bull; Cumplimiento normativo y salida al tanque final</span>
            </div>
            <div class="trend-legend">
                @foreach (var series in TreatedSeries)
                {
                    <div class="legend-card" style="border-left-color: @series.Color">
                        <span class="legend-dot" style="background: @series.Color"></span>
                        <div class="legend-info">
                            <span class="legend-label">@series.Label</span>
                            <strong class="legend-value" style="color: @series.Color">@GetLatestValue(series.Tag)</strong>
                        </div>
                    </div>
                }
            </div>
        </div>

        <svg class="trend-chart" viewBox="0 0 1060 360" role="img" aria-label="Curvas historicas de agua tratada">
            <!-- Área de trazado -->
            <rect x="150" y="30" width="780" height="280" fill="url(#plotBgGrad)" stroke="rgba(78, 200, 216, 0.2)" stroke-width="1" rx="6" />

            <!-- Líneas de cuadrícula horizontal (5 niveles) -->
            @for (var i = 0; i < 5; i++)
            {
                var y = 30 + (i * 70.0);
                <line x1="150" y1="@y.ToString("0.#", Culture)" x2="930" y2="@y.ToString("0.#", Culture)" 
                      stroke="rgba(255, 255, 255, 0.06)" stroke-dasharray="4 4" stroke-width="1" />
            }

            <!-- Líneas de cuadrícula vertical (5 divisiones temporales) -->
            @for (var i = 0; i <= 4; i++)
            {
                var x = 150 + (i * 195.0);
                <line x1="@x.ToString("0.#", Culture)" y1="30" x2="@x.ToString("0.#", Culture)" y2="310" 
                      stroke="rgba(255, 255, 255, 0.04)" stroke-width="1" />
            }

            <!-- EJE 1 IZQUIERDA: pH (x = 55) -->
            <line x1="55" y1="30" x2="55" y2="310" stroke="#60a5fa" stroke-width="1.5" />
            <text x="47" y="34" fill="#60a5fa" font-size="11" text-anchor="end" font-weight="700">14.0</text>
            <text x="47" y="104" fill="#60a5fa" font-size="11" text-anchor="end" font-weight="700">10.5</text>
            <text x="47" y="174" fill="#60a5fa" font-size="11" text-anchor="end" font-weight="700">7.0</text>
            <text x="47" y="244" fill="#60a5fa" font-size="11" text-anchor="end" font-weight="700">3.5</text>
            <text x="47" y="314" fill="#60a5fa" font-size="11" text-anchor="end" font-weight="700">0.0</text>
            <text x="16" y="170" fill="#60a5fa" font-size="11" text-anchor="middle" transform="rotate(-90 16 170)" font-weight="800" letter-spacing="0.05em">pH (0 - 14)</text>

            <!-- EJE 2 IZQUIERDA: Conductividad (x = 140) -->
            <line x1="140" y1="30" x2="140" y2="310" stroke="#a78bfa" stroke-width="1.5" />
            <text x="132" y="34" fill="#a78bfa" font-size="10.5" text-anchor="end" font-weight="700">2000</text>
            <text x="132" y="104" fill="#a78bfa" font-size="10.5" text-anchor="end" font-weight="700">1500</text>
            <text x="132" y="174" fill="#a78bfa" font-size="10.5" text-anchor="end" font-weight="700">1000</text>
            <text x="132" y="244" fill="#a78bfa" font-size="10.5" text-anchor="end" font-weight="700">500</text>
            <text x="132" y="314" fill="#a78bfa" font-size="10.5" text-anchor="end" font-weight="700">0</text>
            <text x="76" y="170" fill="#a78bfa" font-size="11" text-anchor="middle" transform="rotate(-90 76 170)" font-weight="800" letter-spacing="0.05em">Conductividad (µS/cm)</text>

            <!-- EJE DERECHA: Turbidez (x = 940) -->
            <line x1="940" y1="30" x2="940" y2="310" stroke="#fb923c" stroke-width="1.5" />
            <text x="948" y="34" fill="#fb923c" font-size="11" text-anchor="start" font-weight="700">100</text>
            <text x="948" y="104" fill="#fb923c" font-size="11" text-anchor="start" font-weight="700">75</text>
            <text x="948" y="174" fill="#fb923c" font-size="11" text-anchor="start" font-weight="700">50</text>
            <text x="948" y="244" fill="#fb923c" font-size="11" text-anchor="start" font-weight="700">25</text>
            <text x="948" y="314" fill="#fb923c" font-size="11" text-anchor="start" font-weight="700">0</text>
            <text x="1005" y="170" fill="#fb923c" font-size="11" text-anchor="middle" transform="rotate(90 1005 170)" font-weight="800" letter-spacing="0.05em">Turbidez (NTU)</text>

            <!-- Trazado de Curvas -->
            @foreach (var series in TreatedSeries)
            {
                var points = BuildPolyline(series.Tag);
                if (!string.IsNullOrWhiteSpace(points))
                {
                    <polyline points="@points" fill="none" stroke="@series.Color" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                }
            }

            <!-- Marcas de tiempo en el eje inferior -->
            <text x="150" y="334" fill="#94a3b8" font-size="11" font-weight="600" text-anchor="start">@RangeStartText</text>
            <text x="345" y="334" fill="#64748b" font-size="10.5" font-weight="500" text-anchor="middle">@GetTimeAt(0.25)</text>
            <text x="540" y="334" fill="#64748b" font-size="10.5" font-weight="500" text-anchor="middle">@GetTimeAt(0.50)</text>
            <text x="735" y="334" fill="#64748b" font-size="10.5" font-weight="500" text-anchor="middle">@GetTimeAt(0.75)</text>
            <text x="930" y="334" fill="#94a3b8" font-size="11" font-weight="600" text-anchor="end">@RangeEndText</text>
        </svg>
    </section>

    <!-- Tabla de telemetría reciente -->
    <div class="table-container-card">
        <div class="table-header-title">
            <h3>📑 Registro Reciente de Puntos de Calidad</h3>
            <span class="table-subtitle">Últimas 60 muestras ordenadas cronológicamente</span>
        </div>
        <table class="history-table">
            <thead>
                <tr>
                    <th>Fecha / Hora</th>
                    <th>Variable (Tag)</th>
                    <th>Valor Numérico</th>
                    <th>Unidad</th>
                    <th>Estado de Calidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in RecentPoints.Take(60))
                {
                    var series = GetSeriesInfo(item.TagId);
                    var color = series?.Color ?? "#38bdf8";
                    var label = series?.Label ?? item.TagId;
                    var unit = !string.IsNullOrWhiteSpace(item.Unit) 
                        ? item.Unit 
                        : (item.TagId.StartsWith("ph_") ? "pH" : (item.TagId.StartsWith("turbidez_") ? "NTU" : "µS/cm"));

                    <tr>
                        <td class="col-time">@item.RecordedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="col-tag">
                            <span class="tag-pill" style="border-color: @color; color: @color; background: @GetTransparentColor(color, 0.12);">
                                <span class="tag-bullet" style="background: @color;"></span>
                                <span class="tag-title">@label</span>
                                <code class="tag-code">@item.TagId</code>
                            </span>
                        </td>
                        <td class="col-val"><strong style="color: @color;">@item.ValueNumeric.ToString("0.##")</strong></td>
                        <td class="col-unit"><span class="unit-pill">@unit</span></td>
                        <td class="col-quality">
                            <span class="quality-badge @(item.Quality == "GOOD" ? "quality-good" : "quality-bad")">
                                @(item.Quality == "GOOD" ? "✓ NORMAL" : item.Quality)
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.InvariantCulture;
    private int SelectedRangeMinutes = 60;
    private List<QualityHistoryPoint> RecentPoints = [];
    private string? ErrorMessage;

    private readonly List<TrendSeries> RawSeries =
    [
        new("ph_agua_cruda", "pH Cruda", "#38bdf8"),
        new("turbidez_agua_cruda", "Turbidez Cruda", "#f59e0b"),
        new("conductividad_agua_cruda", "Conductividad Cruda", "#10b981")
    ];

    private readonly List<TrendSeries> TreatedSeries =
    [
        new("ph_agua_tratada", "pH Tratada", "#60a5fa"),
        new("turbidez_agua_tratada", "Turbidez Tratada", "#fb923c"),
        new("conductividad_agua_tratada", "Conductividad Tratada", "#a78bfa")
    ];

    private DateTimeOffset RangeEnd => DateTimeOffset.Now;
    private DateTimeOffset RangeStart => RangeEnd.AddMinutes(-SelectedRangeMinutes);
    private string RangeStartText => RangeStart.ToLocalTime().ToString("HH:mm");
    private string RangeEndText => RangeEnd.ToLocalTime().ToString("HH:mm");

    private string GetTimeAt(double ratio)
    {
        var totalMs = (RangeEnd - RangeStart).TotalMilliseconds;
        var t = RangeStart.AddMilliseconds(totalMs * ratio);
        return t.ToLocalTime().ToString("HH:mm");
    }

    private string CurveSubtitle(IEnumerable<TrendSeries> series)
    {
        var tags = series.Select(item => item.Tag).ToHashSet();
        var count = RecentPoints.Count(point => tags.Contains(point.TagId));
        return $"{count:N0} muestras analizadas";
    }

    private string GetLatestValue(string tag)
    {
        var point = RecentPoints.FirstOrDefault(p => p.TagId == tag);
        if (point is null) return "--";
        if (tag.StartsWith("ph_")) return $"{point.ValueNumeric:F2} pH";
        if (tag.StartsWith("turbidez_")) return $"{point.ValueNumeric:F1} NTU";
        if (tag.StartsWith("conductividad_")) return $"{point.ValueNumeric:F0} µS/cm";
        return point.ValueNumeric.ToString("0.##");
    }

    private TrendSeries? GetSeriesInfo(string tag) =>
        RawSeries.FirstOrDefault(s => s.Tag == tag) ?? TreatedSeries.FirstOrDefault(s => s.Tag == tag);

    private static string GetTransparentColor(string hex, double alpha)
    {
        if (hex.StartsWith("#") && hex.Length == 7)
        {
            int r = Convert.ToInt32(hex.Substring(1, 2), 16);
            int g = Convert.ToInt32(hex.Substring(3, 2), 16);
            int b = Convert.ToInt32(hex.Substring(5, 2), 16);
            return $"rgba({r}, {g}, {b}, {alpha.ToString(Culture)})";
        }
        return hex;
    }

    private string CsvHref => "data:text/csv;charset=utf-8," + Uri.EscapeDataString(BuildCsv());

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SetRange(int minutes)
    {
        SelectedRangeMinutes = minutes;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var loaded = new List<QualityHistoryPoint>();
            foreach (var series in RawSeries.Concat(TreatedSeries))
            {
                var points = await Api.GetQualityHistoryAsync(series.Tag, 2000);
                loaded.AddRange(points.Where(p => p.RecordedAt >= RangeStart));
            }

            RecentPoints = loaded
                .OrderByDescending(p => p.RecordedAt)
                .ToList();
            ErrorMessage = null;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No se pudieron cargar históricos: {ex.Message}";
        }
    }

    private string BuildPolyline(string tag)
    {
        var rawPoints = RecentPoints
            .Where(p => p.TagId == tag)
            .OrderBy(p => p.RecordedAt)
            .ToList();

        if (rawPoints.Count < 2)
        {
            return string.Empty;
        }

        // 1. Suavizado por media móvil (ventana de 5 puntos) para remover el jitter de alta frecuencia
        int window = Math.Min(5, rawPoints.Count);
        var smoothed = new List<(DateTimeOffset Time, double Value)>(rawPoints.Count);
        for (int i = 0; i < rawPoints.Count; i++)
        {
            int start = Math.Max(0, i - window / 2);
            int count = Math.Min(rawPoints.Count - start, window);
            double avg = rawPoints.Skip(start).Take(count).Average(p => (double)p.ValueNumeric);
            smoothed.Add((rawPoints[i].RecordedAt, avg));
        }

        // 2. Muestreo inteligente a máximo 220 puntos para trazado vectorial nítido
        int maxPoints = 220;
        List<(DateTimeOffset Time, double Value)> finalPoints;
        if (smoothed.Count > maxPoints)
        {
            double step = (double)(smoothed.Count - 1) / (maxPoints - 1);
            finalPoints = new List<(DateTimeOffset, double)>(maxPoints);
            for (int i = 0; i < maxPoints; i++)
            {
                int idx = (int)Math.Round(i * step);
                if (idx >= smoothed.Count) idx = smoothed.Count - 1;
                finalPoints.Add(smoothed[idx]);
            }
        }
        else
        {
            finalPoints = smoothed;
        }

        var minTime = RangeStart.ToUnixTimeMilliseconds();
        var maxTime = RangeEnd.ToUnixTimeMilliseconds();
        if (maxTime <= minTime) maxTime = minTime + 1;

        double minValue = 0;
        double maxValue = 100;

        if (tag.StartsWith("ph_"))
        {
            minValue = 0;
            maxValue = 14;
        }
        else if (tag.StartsWith("conductividad_"))
        {
            minValue = 0;
            maxValue = 2000;
        }
        else if (tag.StartsWith("turbidez_"))
        {
            minValue = 0;
            maxValue = 100;
        }

        const double plotLeft = 150;
        const double plotWidth = 780;
        const double plotTop = 30;
        const double plotHeight = 280;
        const double plotBottom = plotTop + plotHeight; // 310

        return string.Join(" ", finalPoints.Select(p =>
        {
            var timeRatio = (p.Time.ToUnixTimeMilliseconds() - minTime) / (double)(maxTime - minTime);
            var valueRatio = (p.Value - minValue) / (maxValue - minValue);
            var x = plotLeft + Math.Clamp(timeRatio, 0, 1) * plotWidth;
            var y = plotBottom - Math.Clamp(valueRatio, 0, 1) * plotHeight;
            return $"{x.ToString("0.##", Culture)},{y.ToString("0.##", Culture)}";
        }));
    }

    private string BuildCsv()
    {
        var lines = new List<string> { "recorded_at,tag_id,value_numeric,unit,quality" };
        lines.AddRange(RecentPoints
            .OrderBy(p => p.RecordedAt)
            .Select(p => $"{p.RecordedAt:O},{p.TagId},{p.ValueNumeric.ToString(Culture)},{p.Unit},{p.Quality}"));
        return string.Join(Environment.NewLine, lines);
    }

    private sealed record TrendSeries(string Tag, string Label, string Color);
}

<style>
.history-page {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 2.5rem;
}

/* Tarjeta de barra de herramientas */
.history-toolbar-card {
    background: #0d1822;
    border: 1px solid rgba(78, 200, 216, 0.2);
    border-radius: 12px;
    padding: 1rem 1.4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
