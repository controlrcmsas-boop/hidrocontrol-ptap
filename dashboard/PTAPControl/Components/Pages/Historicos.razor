                                <stop offset="100%" stop-color="#38BDF8" stop-opacity="0.0" />
                            </linearGradient>
                        </defs>

                        <rect x="46" y="14" width="442" height="162" fill="#131823" stroke="rgba(255, 255, 255, 0.05)" stroke-width="1" rx="8" />

                        @for (int i = 0; i < turbScale.Ticks.Count; i++)
                        {
                            var tickVal = turbScale.Ticks[i];
                            var yPos = 14.0 + (i * (162.0 / (turbScale.Ticks.Count - 1)));
                            <line x1="46" y1="@yPos.ToString("0.##", Culture)" x2="488" y2="@yPos.ToString("0.##", Culture)" stroke="rgba(255, 255, 255, 0.05)" stroke-width="1" />
                            @((MarkupString)$"<text x=\"40\" y=\"{(yPos + 4).ToString("0.##", Culture)}\" fill=\"#94A3B8\" font-size=\"13\" text-anchor=\"end\" font-weight=\"500\">{tickVal.ToString(turbScale.Format, Culture)}</text>")
                        }

                        @for (int i = 0; i <= 4; i++)
                        {
                            var xPos = 46.0 + i * (442.0 / 4.0);
                            <line x1="@xPos.ToString("0.##", Culture)" y1="14" x2="@xPos.ToString("0.##", Culture)" y2="176" stroke="rgba(255, 255, 255, 0.04)" stroke-width="1" />
                        }

                        @if (!turbChartData.HasData)
