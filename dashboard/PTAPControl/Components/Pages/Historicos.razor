<!-- Script interactivo de Tooltips Hover y Touch -->
<script>
    (function initChartsInteractive() {
        function attachListeners() {
            var svgs = document.querySelectorAll('.chart-interactive-svg');
            svgs.forEach(function (svg) {
                if (svg._attached) return;
                svg._attached = true;

                var chartId = svg.dataset.chartId;
                var tooltip = document.getElementById('tooltip-' + chartId);
                var guideLine = document.getElementById('guide-line-' + chartId);
                var guideDot = document.getElementById('guide-dot-' + chartId);

                function handlePointer(clientX, clientY) {
                    var rect = svg.getBoundingClientRect();
                    var relX = clientX - rect.left;
                    var svgX = (relX / rect.width) * 760;

                    if (svgX < 65 || svgX > 730) {
                        hide();
                        return;
                    }

                    var raw = svg.dataset.points;
                    if (!raw) return;
                    var points;
                    try { points = JSON.parse(raw); } catch (e) { return; }
                    if (!points || points.length === 0) return;

                    var closest = points[0];
                    var minDiff = Math.abs(points[0].x - svgX);
                    for (var i = 1; i < points.length; i++) {
                        var diff = Math.abs(points[i].x - svgX);
                        if (diff < minDiff) {
                            minDiff = diff;
                            closest = points[i];
                        }
                    }

                    if (guideLine) {
                        guideLine.setAttribute('x1', closest.x);
                        guideLine.setAttribute('x2', closest.x);
                        guideLine.style.display = 'block';
                    }
                    if (guideDot) {
                        guideDot.setAttribute('cx', closest.x);
                        guideDot.setAttribute('cy', closest.y);
                        guideDot.style.display = 'block';
                    }

                    if (tooltip) {
                        tooltip.innerHTML = '<span class="tooltip-val">' + closest.val + ' ' + closest.unit + '</span><span class="tooltip-time">' + closest.time + '</span>';
                        var pixelX = (closest.x / 760) * rect.width;
                        var pixelY = (closest.y / 520) * rect.height;
                        tooltip.style.left = pixelX + 'px';
                        tooltip.style.top = Math.max(10, pixelY - 45) + 'px';
                        tooltip.style.opacity = '1';
                    }
                }

                function hide() {
                    if (guideLine) guideLine.style.display = 'none';
                    if (guideDot) guideDot.style.display = 'none';
                    if (tooltip) tooltip.style.opacity = '0';
                }

                svg.addEventListener('mousemove', function (e) {
                    handlePointer(e.clientX, e.clientY);
                });
                svg.addEventListener('mouseleave', hide);

                svg.addEventListener('touchstart', function (e) {
                    if (e.touches && e.touches[0]) {
                        handlePointer(e.touches[0].clientX, e.touches[0].clientY);
                    }
                }, { passive: true });

                svg.addEventListener('touchmove', function (e) {
                    if (e.touches && e.touches[0]) {
                        handlePointer(e.touches[0].clientX, e.touches[0].clientY);
                    }
                }, { passive: true });

                svg.addEventListener('touchend', function () {
                    setTimeout(hide, 2000);
                });
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', attachListeners);
        } else {
            attachListeners();
        }
        setInterval(attachListeners, 1500);
    })();
</script>

@code {
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.InvariantCulture;
    private int SelectedRangeMinutes = 15;
    private List<QualityHistoryPoint> RecentPoints = [];
    private string? ErrorMessage;

    private sealed record TrendSeries(string Tag, string Label, string Color);

    private readonly List<TrendSeries> AllSeries =
    [
        new("ph_agua_tratada", "Sensor de pH", "#38BDF8"),
        new("turbidez_agua_tratada", "Sensor de Turbidez", "#38BDF8"),
        new("conductividad_agua_tratada", "Sensor de Conductividad", "#38BDF8")
    ];

    private DateTimeOffset RangeEnd => DateTimeOffset.Now;
    private DateTimeOffset RangeStart => RangeEnd.AddMinutes(-SelectedRangeMinutes);
    private string RangeStartText => RangeStart.ToLocalTime().ToString("HH:mm");
    private string RangeEndText => RangeEnd.ToLocalTime().ToString("HH:mm");

    private string GetTimeAt(double ratio)
    {
        var totalMs = (RangeEnd - RangeStart).TotalMilliseconds;
        var t = RangeStart.AddMilliseconds(totalMs * ratio);
        return t.ToLocalTime().ToString("HH:mm");
    }

    private double GetLatestValueNumeric(string tag)
    {
        var point = RecentPoints.FirstOrDefault(p => p.TagId == tag);
        return point is not null ? (double)point.ValueNumeric : 0.0;
    }

    private sealed class ChartScale
    {
        public double Min { get; set; }
        public double Max { get; set; }
        public string Unit { get; set; } = "";
        public string Format { get; set; } = "0.00";
        public List<double> Ticks { get; set; } = [];
    }

    private ChartScale CalculateScale(string tag, List<QualityHistoryPoint> points)
    {
        var tagPoints = points.Where(p => p.TagId == tag).ToList();
        if (tagPoints.Count == 0)
        {
            if (tag.StartsWith("ph")) return new ChartScale { Min = 6.8, Max = 7.4, Unit = "pH", Format = "0.00", Ticks = [7.4, 7.25, 7.10, 6.95, 6.8] };
            if (tag.StartsWith("turb")) return new ChartScale { Min = 0.0, Max = 0.8, Unit = "NTU", Format = "0.00", Ticks = [0.8, 0.6, 0.4, 0.2, 0.0] };
            return new ChartScale { Min = 410, Max = 470, Unit = "µS/cm", Format = "0", Ticks = [470, 455, 440, 425, 410] };
        }

        var minVal = (double)tagPoints.Min(p => p.ValueNumeric);
        var maxVal = (double)tagPoints.Max(p => p.ValueNumeric);

        if (tag.StartsWith("ph"))
        {
            double span = Math.Max(0.25, maxVal - minVal);
            double mid = (maxVal + minVal) / 2.0;
            double lo = Math.Round(mid - span * 0.70, 2);
            double hi = Math.Round(mid + span * 0.70, 2);
            if (hi - lo < 0.20) hi = lo + 0.20;
            double step = (hi - lo) / 4.0;
            return new ChartScale
            {
                Min = lo,
                Max = hi,
                Unit = "pH",
                Format = "0.00",
                Ticks = [hi, hi - step, hi - 2 * step, hi - 3 * step, lo]
            };
        }
        else if (tag.StartsWith("turb"))
        {
            double lo = Math.Max(0.0, Math.Floor(minVal * 10) / 10.0);
            double hi = Math.Max(lo + 0.30, Math.Ceiling((maxVal + 0.08) * 10) / 10.0);
            double step = (hi - lo) / 4.0;
            return new ChartScale
            {
                Min = lo,
                Max = hi,
                Unit = "NTU",
                Format = "0.00",
                Ticks = [hi, hi - step, hi - 2 * step, hi - 3 * step, lo]
            };
        }
        else
        {
            double span = Math.Max(25, maxVal - minVal);
            double mid = (maxVal + minVal) / 2.0;
            double lo = Math.Floor((mid - span * 0.70) / 5.0) * 5.0;
            double hi = Math.Ceiling((mid + span * 0.70) / 5.0) * 5.0;
            if (hi - lo < 20) hi = lo + 20;
            double step = (hi - lo) / 4.0;
            return new ChartScale
            {
                Min = lo,
                Max = hi,
                Unit = "µS/cm",
                Format = "0",
                Ticks = [hi, hi - step, hi - 2 * step, hi - 3 * step, lo]
            };
        }
    }

    private sealed record ChartRenderData(
        string CurvePath,
        string AreaPath,
        string JsonPoints
    );

    private ChartRenderData BuildChartData(string tag, double minVal, double maxVal)
    {
        var rawPoints = RecentPoints
            .Where(p => p.TagId == tag)
            .OrderBy(p => p.RecordedAt)
            .ToList();

        if (rawPoints.Count == 0)
        {
            return new ChartRenderData(string.Empty, string.Empty, "[]");
        }

        var minTime = RangeStart.ToUnixTimeMilliseconds();
        var maxTime = RangeEnd.ToUnixTimeMilliseconds();
        if (maxTime <= minTime) maxTime = minTime + 1;

        double left = 65.0;
        double width = 665.0;
        double top = 25.0;
        double height = 430.0;
        double bottom = top + height;
        double valSpan = Math.Max(0.001, maxVal - minVal);

        // Suavizado adaptativo según ventana temporal (15m: ~40 buckets, 30m: ~50 buckets, 60m: ~60 buckets)
        int targetBuckets = SelectedRangeMinutes switch
        {
            <= 15 => 40,
            <= 30 => 50,
            _ => 60
        };

        double bucketDurationMs = (maxTime - minTime) / (double)targetBuckets;
        var bucketed = new List<(double TimeMs, double Value, DateTimeOffset Stamp)>();

        for (int b = 0; b < targetBuckets; b++)
        {
            double bStart = minTime + b * bucketDurationMs;
            double bEnd = bStart + bucketDurationMs;
            var inBucket = rawPoints.Where(p =>
            {
                var t = p.RecordedAt.ToUnixTimeMilliseconds();
                return t >= bStart && (b == targetBuckets - 1 ? t <= bEnd : t < bEnd);
            }).ToList();

            if (inBucket.Count > 0)
            {
                double avgVal = inBucket.Average(p => (double)p.ValueNumeric);
                bucketed.Add((bStart + bucketDurationMs / 2.0, avgVal, inBucket.Last().RecordedAt));
            }
            else if (bucketed.Count > 0)
            {
                bucketed.Add((bStart + bucketDurationMs / 2.0, bucketed[^1].Value, bucketed[^1].Stamp));
            }
            else
            {
                // Si aún no hay puntos en buckets tempranos, rellenar con el primer punto conocido para abarcar toda la gráfica
                bucketed.Add((bStart + bucketDurationMs / 2.0, (double)rawPoints[0].ValueNumeric, rawPoints[0].RecordedAt));
            }
        }

        if (bucketed.Count < 2)
        {
            bucketed = rawPoints.Select(p => ((double)p.RecordedAt.ToUnixTimeMilliseconds(), (double)p.ValueNumeric, p.RecordedAt)).ToList();
        }

        // Filtro de suavizado (media móvil ponderada para eliminar ruido/dientes de sierra)
        var smoothed = new double[bucketed.Count];
        for (int i = 0; i < bucketed.Count; i++)
        {
            double prev = i > 0 ? bucketed[i - 1].Value : bucketed[i].Value;
            double curr = bucketed[i].Value;
            double next = i < bucketed.Count - 1 ? bucketed[i + 1].Value : bucketed[i].Value;
            smoothed[i] = (prev * 0.25) + (curr * 0.5) + (next * 0.25);
        }

        var pts = new List<(double X, double Y, double Val, string Time, string Unit)>();
        var unit = tag.StartsWith("ph") ? "pH" : (tag.StartsWith("turb") ? "NTU" : "µS/cm");

        for (int i = 0; i < bucketed.Count; i++)
        {
            var timeRatio = (bucketed[i].TimeMs - minTime) / (double)(maxTime - minTime);
            var valueRatio = (smoothed[i] - minVal) / valSpan;

            var x = left + Math.Clamp(timeRatio, 0.0, 1.0) * width;
            var y = bottom - Math.Clamp(valueRatio, 0.0, 1.0) * height;

            pts.Add((x, y, smoothed[i], bucketed[i].Stamp.ToLocalTime().ToString("HH:mm:ss"), unit));
        }

        if (pts.Count == 0)
        {
            return new ChartRenderData(string.Empty, string.Empty, "[]");
        }

        // Generar curva Bezier cúbica fluida
        var curvePath = BuildCubicBezierPath(pts);

        // Generar área cerrada bajo la curva
        var firstX = pts[0].X.ToString("0.#", Culture);
        var lastX = pts[^1].X.ToString("0.#", Culture);
        var bottomStr = bottom.ToString("0.#", Culture);
        int cIndex = curvePath.IndexOf('C');
        string bezierCommands = cIndex >= 0 ? curvePath[cIndex..] : "";
        var areaPath = $"M {firstX} {bottomStr} L {firstX} {pts[0].Y.ToString("0.#", Culture)} {bezierCommands} L {lastX} {bottomStr} Z";

        // JSON para el puntero interactivo de tooltip
        var jsonBuilder = new System.Text.StringBuilder("[");
        for (int i = 0; i < pts.Count; i++)
        {
            var item = pts[i];
            if (i > 0) jsonBuilder.Append(",");
            jsonBuilder.Append($"{{\"x\":{item.X.ToString("0.#", Culture)},\"y\":{item.Y.ToString("0.#", Culture)},\"val\":{item.Val.ToString("0.00", Culture)},\"time\":\"{item.Time}\",\"unit\":\"{item.Unit}\"}}");
        }
        jsonBuilder.Append("]");

        return new ChartRenderData(curvePath, areaPath, jsonBuilder.ToString());
    }

    private static string BuildCubicBezierPath(List<(double X, double Y, double Val, string Time, string Unit)> pts)
    {
        if (pts.Count == 0) return string.Empty;
        if (pts.Count == 1) return $"M {pts[0].X.ToString("0.#", Culture)} {pts[0].Y.ToString("0.#", Culture)}";

        var sb = new System.Text.StringBuilder();
        sb.Append($"M {pts[0].X.ToString("0.#", Culture)} {pts[0].Y.ToString("0.#", Culture)}");

        double tension = 0.2; // Tensión equilibrada para curvatura suave

        for (int i = 0; i < pts.Count - 1; i++)
        {
            var p0 = i > 0 ? pts[i - 1] : pts[i];
            var p1 = pts[i];
            var p2 = pts[i + 1];
            var p3 = i < pts.Count - 2 ? pts[i + 2] : p2;

            double cp1x = p1.X + (p2.X - p0.X) * tension;
            double cp1y = p1.Y + (p2.Y - p0.Y) * tension;
            double cp2x = p2.X - (p3.X - p1.X) * tension;
            double cp2y = p2.Y - (p3.Y - p1.Y) * tension;

            sb.Append($" C {cp1x.ToString("0.#", Culture)} {cp1y.ToString("0.#", Culture)}, {cp2x.ToString("0.#", Culture)} {cp2y.ToString("0.#", Culture)}, {p2.X.ToString("0.#", Culture)} {p2.Y.ToString("0.#", Culture)}");
        }

        return sb.ToString();
    }

    private string CsvHref => "data:text/csv;charset=utf-8," + Uri.EscapeDataString(BuildCsv());

    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _cts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = RunLoopAsync(_refreshTimer, _cts.Token);
    }

    private async Task RunLoopAsync(PeriodicTimer timer, CancellationToken ct)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task SetRange(int minutes)
    {
        SelectedRangeMinutes = minutes;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var loaded = new List<QualityHistoryPoint>();
            foreach (var series in AllSeries)
            {
                var points = await Api.GetQualityHistoryAsync(series.Tag, 1000);
                loaded.AddRange(points.Where(p => p.RecordedAt >= RangeStart));
            }

            RecentPoints = loaded
                .OrderByDescending(p => p.RecordedAt)
                .ToList();
            ErrorMessage = null;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No se pudieron cargar históricos: {ex.Message}";
        }
    }

    private string BuildCsv()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Timestamp,Tag,Value,Unit,Quality");
        foreach (var p in RecentPoints.OrderBy(p => p.RecordedAt))
        {
            sb.AppendLine($"{p.RecordedAt:yyyy-MM-dd HH:mm:ss},{p.TagId},{p.ValueNumeric.ToString(Culture)},{p.Unit},{p.Quality}");
        }
        return sb.ToString();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _refreshTimer?.Dispose();
    }
}

