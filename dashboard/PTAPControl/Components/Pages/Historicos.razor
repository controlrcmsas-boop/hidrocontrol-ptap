            </div>

            @{
                var condScale = CalculateScale("conductividad_agua_tratada", RecentPoints);
                var condChartData = BuildChartData("conductividad_agua_tratada", condScale.Min, condScale.Max);
            }

            <div class="chart-container" id="container-cond">
                <div class="chart-tooltip" id="tooltip-cond"></div>
                <div class="svg-chart-wrapper">
                    <svg class="chart-interactive-svg" id="svg-cond" viewBox="0 0 500 220" 
