@page "/historicos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]
@rendermode InteractiveServer
@using PTAPControl.Models
@using PTAPControl.Services
@inject NodeRedApiClient Api

<PageTitle>Historicos</PageTitle>

<section class="history-page">
    <header class="scada-header">
        <div>
            <p class="eyebrow">HIDROCONTROL PTAP</p>
            <h1>Curvas historicas</h1>
        </div>
        <div class="header-actions">
            <a class="refresh-button download-link" href="@CsvHref" download="hidrocontrol-historicos.csv">Descargar CSV</a>
            <button class="refresh-button" @onclick="LoadAsync">Actualizar</button>
        </div>
    </header>

    <div class="history-toolbar">
        <label>
            Rango
            <select @bind="SelectedRangeMinutes">
                <option value="60">Ultima hora</option>
                <option value="180">Ultimas 3 horas</option>
                <option value="720">Ultimas 12 horas</option>
                <option value="1440">Ultimas 24 horas</option>
            </select>
        </label>
        <button class="refresh-button" @onclick="LoadAsync">Consultar</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert-line">@ErrorMessage</div>
    }

    <section class="trend-panel">
        <div class="trend-head">
            <div>
                <h2>Agua cruda</h2>
                <span>@CurveSubtitle(RawSeries)</span>
            </div>
            <div class="trend-legend">
                @foreach (var series in RawSeries)
                {
                    <span><i style="background:@series.Color"></i>@series.Label</span>
                }
            </div>
        </div>

        <svg class="trend-chart" viewBox="0 0 1000 360" role="img" aria-label="Curvas historicas de calidad">
            <!-- Background panel -->
            <rect x="120" y="24" width="760" height="286" fill="rgba(17, 31, 39, 0.4)" rx="4" />

            <!-- Grid lines -->
            @for (var i = 0; i < 5; i++)
            {
                var y = 24 + (i * 71.5);
                <line x1="120" y1="@y.ToString("0.###", Culture)" x2="880" y2="@y.ToString("0.###", Culture)" class="chart-grid" />
            }
            @for (var i = 0; i <= 4; i++)
            {
                var x = 120 + (i * 190);
                <line x1="@x" y1="24" x2="@x" y2="310" class="chart-grid chart-grid-vertical" />
            }

            <!-- Axis 1: pH (x = 45) -->
            <line x1="45" y1="24" x2="45" y2="310" stroke="#4ec8d8" stroke-width="1.5" />
            <text x="38" y="29" fill="#4ec8d8" font-size="12" text-anchor="end" font-weight="bold">14.0</text>
            <text x="38" y="100.5" fill="#4ec8d8" font-size="12" text-anchor="end" font-weight="bold">10.5</text>
            <text x="38" y="172" fill="#4ec8d8" font-size="12" text-anchor="end" font-weight="bold">7.0</text>
            <text x="38" y="243.5" fill="#4ec8d8" font-size="12" text-anchor="end" font-weight="bold">3.5</text>
            <text x="38" y="315" fill="#4ec8d8" font-size="12" text-anchor="end" font-weight="bold">0.0</text>
            <text x="15" y="167" fill="#4ec8d8" font-size="11" text-anchor="middle" transform="rotate(-90 15 167)" font-weight="bold">pH</text>

            <!-- Axis 2: Conductividad (x = 90) -->
            <line x1="90" y1="24" x2="90" y2="310" stroke="#48d597" stroke-width="1.5" />
            <text x="83" y="29" fill="#48d597" font-size="11" text-anchor="end" font-weight="bold">2000</text>
            <text x="83" y="100.5" fill="#48d597" font-size="11" text-anchor="end" font-weight="bold">1500</text>
            <text x="83" y="172" fill="#48d597" font-size="11" text-anchor="end" font-weight="bold">1000</text>
            <text x="83" y="243.5" fill="#48d597" font-size="11" text-anchor="end" font-weight="bold">500</text>
            <text x="83" y="315" fill="#48d597" font-size="11" text-anchor="end" font-weight="bold">0</text>
            <text x="65" y="167" fill="#48d597" font-size="10" text-anchor="middle" transform="rotate(-90 65 167)" font-weight="bold">uS/cm</text>

            <!-- Axis 3: Turbidez (x = 920) -->
            <line x1="920" y1="24" x2="920" y2="310" stroke="#e7c765" stroke-width="1.5" />
            <text x="927" y="29" fill="#e7c765" font-size="11" text-anchor="start" font-weight="bold">100</text>
            <text x="927" y="100.5" fill="#e7c765" font-size="11" text-anchor="start" font-weight="bold">75</text>
            <text x="927" y="172" fill="#e7c765" font-size="11" text-anchor="start" font-weight="bold">50</text>
            <text x="927" y="243.5" fill="#e7c765" font-size="11" text-anchor="start" font-weight="bold">25</text>
            <text x="927" y="315" fill="#e7c765" font-size="11" text-anchor="start" font-weight="bold">0</text>
            <text x="965" y="167" fill="#e7c765" font-size="11" text-anchor="middle" transform="rotate(90 965 167)" font-weight="bold">Turbidez (NTU)</text>

            <!-- Plot boundary -->
            <rect x="120" y="24" width="760" height="286" fill="none" stroke="var(--line)" stroke-width="1" />

            <!-- Curves -->
            @foreach (var series in RawSeries)
            {
                var points = BuildPolyline(series.Tag);
                if (!string.IsNullOrWhiteSpace(points))
                {
                    <polyline points="@points" fill="none" stroke="@series.Color" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                }
            }

            <!-- Time labels -->
            <text x="120" y="340" fill="var(--muted)" font-size="13" font-weight="bold">@RangeStartText</text>
            <text x="880" y="340" fill="var(--muted)" font-size="13" text-anchor="end" font-weight="bold">@RangeEndText</text>
        </svg>
    </section>

    <section class="trend-panel">
        <div class="trend-head">
            <div>
                <h2>Agua tratada</h2>
                <span>@CurveSubtitle(TreatedSeries)</span>
            </div>
            <div class="trend-legend">
                @foreach (var series in TreatedSeries)
                {
                    <span><i style="background:@series.Color"></i>@series.Label</span>
                }
            </div>
        </div>

        <svg class="trend-chart" viewBox="0 0 1000 360" role="img" aria-label="Curvas historicas de agua tratada">
            <!-- Background panel -->
            <rect x="120" y="24" width="760" height="286" fill="rgba(17, 31, 39, 0.4)" rx="4" />

            <!-- Grid lines -->
            @for (var i = 0; i < 5; i++)
            {
                var y = 24 + (i * 71.5);
                <line x1="120" y1="@y.ToString("0.###", Culture)" x2="880" y2="@y.ToString("0.###", Culture)" class="chart-grid" />
            }
            @for (var i = 0; i <= 4; i++)
            {
                var x = 120 + (i * 190);
                <line x1="@x" y1="24" x2="@x" y2="310" class="chart-grid chart-grid-vertical" />
            }

            <!-- Axis 1: pH (x = 45) -->
            <line x1="45" y1="24" x2="45" y2="310" stroke="#8bc6ff" stroke-width="1.5" />
            <text x="38" y="29" fill="#8bc6ff" font-size="12" text-anchor="end" font-weight="bold">14.0</text>
            <text x="38" y="100.5" fill="#8bc6ff" font-size="12" text-anchor="end" font-weight="bold">10.5</text>
            <text x="38" y="172" fill="#8bc6ff" font-size="12" text-anchor="end" font-weight="bold">7.0</text>
            <text x="38" y="243.5" fill="#8bc6ff" font-size="12" text-anchor="end" font-weight="bold">3.5</text>
            <text x="38" y="315" fill="#8bc6ff" font-size="12" text-anchor="end" font-weight="bold">0.0</text>
            <text x="15" y="167" fill="#8bc6ff" font-size="11" text-anchor="middle" transform="rotate(-90 15 167)" font-weight="bold">pH</text>

            <!-- Axis 2: Conductividad (x = 90) -->
            <line x1="90" y1="24" x2="90" y2="310" stroke="#c792ea" stroke-width="1.5" />
            <text x="83" y="29" fill="#c792ea" font-size="11" text-anchor="end" font-weight="bold">2000</text>
            <text x="83" y="100.5" fill="#c792ea" font-size="11" text-anchor="end" font-weight="bold">1500</text>
            <text x="83" y="172" fill="#c792ea" font-size="11" text-anchor="end" font-weight="bold">1000</text>
            <text x="83" y="243.5" fill="#c792ea" font-size="11" text-anchor="end" font-weight="bold">500</text>
            <text x="83" y="315" fill="#c792ea" font-size="11" text-anchor="end" font-weight="bold">0</text>
            <text x="65" y="167" fill="#c792ea" font-size="10" text-anchor="middle" transform="rotate(-90 65 167)" font-weight="bold">uS/cm</text>

            <!-- Axis 3: Turbidez (x = 920) -->
            <line x1="920" y1="24" x2="920" y2="310" stroke="#ff9d66" stroke-width="1.5" />
            <text x="927" y="29" fill="#ff9d66" font-size="11" text-anchor="start" font-weight="bold">100</text>
            <text x="927" y="100.5" fill="#ff9d66" font-size="11" text-anchor="start" font-weight="bold">75</text>
            <text x="927" y="172" fill="#ff9d66" font-size="11" text-anchor="start" font-weight="bold">50</text>
            <text x="927" y="243.5" fill="#ff9d66" font-size="11" text-anchor="start" font-weight="bold">25</text>
            <text x="927" y="315" fill="#ff9d66" font-size="11" text-anchor="start" font-weight="bold">0</text>
            <text x="965" y="167" fill="#ff9d66" font-size="11" text-anchor="middle" transform="rotate(90 965 167)" font-weight="bold">Turbidez (NTU)</text>

            <!-- Plot boundary -->
            <rect x="120" y="24" width="760" height="286" fill="none" stroke="var(--line)" stroke-width="1" />

            <!-- Curves -->
            @foreach (var series in TreatedSeries)
            {
                var points = BuildPolyline(series.Tag);
                if (!string.IsNullOrWhiteSpace(points))
                {
                    <polyline points="@points" fill="none" stroke="@series.Color" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                }
            }

            <!-- Time labels -->
            <text x="120" y="340" fill="var(--muted)" font-size="13" font-weight="bold">@RangeStartText</text>
            <text x="880" y="340" fill="var(--muted)" font-size="13" text-anchor="end" font-weight="bold">@RangeEndText</text>
        </svg>
    </section>

    <table class="history-table">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Tag</th>
                <th>Valor</th>
                <th>Unidad</th>
                <th>Calidad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in RecentPoints.Take(80))
            {
                <tr>
                    <td>@item.RecordedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@item.TagId</td>
                    <td>@item.ValueNumeric.ToString("0.###")</td>
                    <td>@item.Unit</td>
                    <td>@item.Quality</td>
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.InvariantCulture;
    private int SelectedRangeMinutes = 60;
    private List<QualityHistoryPoint> RecentPoints = [];
    private string? ErrorMessage;

    private readonly List<TrendSeries> RawSeries =
    [
        new("ph_agua_cruda", "pH cruda", "#4ec8d8"),
        new("turbidez_agua_cruda", "Turbidez cruda", "#e7c765"),
        new("conductividad_agua_cruda", "Conductividad cruda", "#48d597")
    ];

    private readonly List<TrendSeries> TreatedSeries =
    [
        new("ph_agua_tratada", "pH tratada", "#8bc6ff"),
        new("turbidez_agua_tratada", "Turbidez tratada", "#ff9d66"),
        new("conductividad_agua_tratada", "Conductividad tratada", "#c792ea")
    ];

    private DateTimeOffset RangeEnd => DateTimeOffset.Now;
    private DateTimeOffset RangeStart => RangeEnd.AddMinutes(-SelectedRangeMinutes);
    private string RangeStartText => RangeStart.ToLocalTime().ToString("HH:mm");
    private string RangeEndText => RangeEnd.ToLocalTime().ToString("HH:mm");
    private string CurveSubtitle(IEnumerable<TrendSeries> series)
    {
        var tags = series.Select(item => item.Tag).ToHashSet();
        var count = RecentPoints.Count(point => tags.Contains(point.TagId));
        return $"{count} puntos en los ultimos {SelectedRangeMinutes} minutos";
    }
    private string CsvHref => "data:text/csv;charset=utf-8," + Uri.EscapeDataString(BuildCsv());

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var loaded = new List<QualityHistoryPoint>();
            foreach (var series in RawSeries.Concat(TreatedSeries))
            {
                var points = await Api.GetQualityHistoryAsync(series.Tag, 2000);
                loaded.AddRange(points.Where(p => p.RecordedAt >= RangeStart));
            }

            RecentPoints = loaded
                .OrderByDescending(p => p.RecordedAt)
                .ToList();
            ErrorMessage = null;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No se pudieron cargar historicos: {ex.Message}";
        }
    }

    private string BuildPolyline(string tag)
    {
        var points = RecentPoints
            .Where(p => p.TagId == tag)
            .OrderBy(p => p.RecordedAt)
            .ToList();

        if (points.Count < 2)
        {
            return string.Empty;
        }

        var minTime = RangeStart.ToUnixTimeMilliseconds();
        var maxTime = RangeEnd.ToUnixTimeMilliseconds();
        
        double minValue = 0;
        double maxValue = 100;

        if (tag.StartsWith("ph_"))
        {
            minValue = 0;
            maxValue = 14;
        }
        else if (tag.StartsWith("conductividad_"))
        {
            minValue = 0;
            maxValue = 2000;
        }
        else if (tag.StartsWith("turbidez_"))
        {
            minValue = 0;
            maxValue = 100;
        }
        else
        {
            minValue = points.Min(p => (double)p.ValueNumeric);
            maxValue = points.Max(p => (double)p.ValueNumeric);
            if (Math.Abs(maxValue - minValue) < 0.0001) maxValue = minValue + 1;
        }

        return string.Join(" ", points.Select(point =>
        {
            var timeRatio = (point.RecordedAt.ToUnixTimeMilliseconds() - minTime) / (double)(maxTime - minTime);
            var valueRatio = ((double)point.ValueNumeric - minValue) / (maxValue - minValue);
            var x = 120 + Math.Clamp(timeRatio, 0, 1) * 760;
            var y = 310 - Math.Clamp(valueRatio, 0, 1) * 286;
            return $"{x.ToString("0.###", Culture)},{y.ToString("0.###", Culture)}";
        }));
    }

    private string BuildCsv()
    {
        var lines = new List<string> { "recorded_at,tag_id,value_numeric,unit,quality" };
        lines.AddRange(RecentPoints
            .OrderBy(p => p.RecordedAt)
            .Select(p => $"{p.RecordedAt:O},{p.TagId},{p.ValueNumeric.ToString(Culture)},{p.Unit},{p.Quality}"));
        return string.Join(Environment.NewLine, lines);
    }

    private sealed record TrendSeries(string Tag, string Label, string Color);
}
