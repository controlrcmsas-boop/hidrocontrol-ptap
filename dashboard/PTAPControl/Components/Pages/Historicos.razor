                            }
                            @if (!string.IsNullOrWhiteSpace(turbChartData.CurvePath))
                            {
                                <path d="@turbChartData.CurvePath" fill="none" stroke="#38BDF8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                            }
                        }

                        <line id="guide-line-turb" x1="0" y1="14" x2="0" y2="176" stroke="rgba(255, 255, 255, 0.25)" stroke-dasharray="3 3" stroke-width="1" style="display:none;" />
                        <circle id="guide-dot-turb" cx="0" cy="0" r="4.5" fill="#38BDF8" stroke="#0E1626" stroke-width="2" style="display:none;" />

                        <text x="46" y="198" fill="#94A3B8" font-size="12" font-weight="500">@GetTimeAt(0.0)</text>
                        <text x="156.5" y="198" fill="#94A3B8" font-size="12" font-weight="500" text-anchor="middle">@GetTimeAt(0.25)</text>
                        <text x="267" y="198" fill="#94A3B8" font-size="12" font-weight="500" text-anchor="middle">@GetTimeAt(0.50)</text>
                        <text x="377.5" y="198" fill="#94A3B8" font-size="12" font-weight="500" text-anchor="middle">@GetTimeAt(0.75)</text>
                        <text x="488" y="198" fill="#94A3B8" font-size="12" font-weight="500" text-anchor="end">@GetTimeAt(1.0)</text>
                    </svg>
                </div>
            </div>
        </section>

        <!-- 3. SENSOR DE CONDUCTIVIDAD -->
        <section class="minimal-sensor-panel">
            <div class="sensor-chart-head">
                <div class="sensor-title-wrap">
                    <h2>Sensor de Conductividad</h2>
                    <p class="sensor-sub">Conductividad Iónica &bull; Valor Nominal &le; 1000 µS/cm</p>
                </div>
                <div class="sensor-reading-display">
