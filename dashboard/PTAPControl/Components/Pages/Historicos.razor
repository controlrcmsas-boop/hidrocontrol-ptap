@page "/historicos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Operador,Gerente,Simulador,Demo")]
@rendermode InteractiveServer
@implements IDisposable
@using PTAPControl.Models
@using PTAPControl.Services
@using PTAPControl.Components.Layout
@inject NodeRedApiClient Api

<PageTitle>Curvas de Proceso — HIDROCONTROL PTAP</PageTitle>

<section class="history-page">
    <header class="scada-header">
        <div class="scada-title-wrap">
            <h1>Curvas de Proceso</h1>
            <p class="scada-subtitle">Supervisión temporal continua de calidad</p>
        </div>
        <div class="header-actions">
            <a class="btn-pill-action download-link" href="@CsvHref" download="hidrocontrol-historicos.csv">
                Descargar CSV
            </a>
            <button type="button" class="btn-pill-action" @onclick="LoadAsync">
                Actualizar
            </button>
            <TopUserNav />
        </div>
    </header>

    <!-- Barra de control y filtrado temporal con botones píldora -->
    <div class="history-toolbar-card">
        <div class="toolbar-left">
            <span class="toolbar-label">Ventana:</span>
            <div class="range-buttons-group">
                <button type="button" class="btn-range @(SelectedRangeMinutes == 15 ? "active" : "")" 
                        @onclick="() => SetRange(15)">15 min</button>
                <button type="button" class="btn-range @(SelectedRangeMinutes == 30 ? "active" : "")" 
                        @onclick="() => SetRange(30)">30 min</button>
                <button type="button" class="btn-range @(SelectedRangeMinutes == 60 ? "active" : "")" 
                        @onclick="() => SetRange(60)">1 Hora</button>
            </div>
        </div>
        <div class="toolbar-right">
            <div class="toolbar-stat">
                <span class="stat-name">Puntos:</span>
                <strong class="stat-val">@RecentPoints.Count pts</strong>
            </div>
            <div class="toolbar-stat">
                <span class="stat-name">Intervalo:</span>
                <strong class="stat-val">@RangeStartText — @RangeEndText</strong>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert-line">@ErrorMessage</div>
    }

    <!-- GRID DE GRÁFICAS: 2 por fila en escritorio, 1 por fila en móvil -->
    <div class="charts-grid">
        <!-- 1. SENSOR DE PH -->
        <section class="minimal-sensor-panel">
            <div class="sensor-chart-head">
                <div class="sensor-title-wrap">
                    <h2>Sensor de pH</h2>
                    <p class="sensor-sub">Potencial de Hidrógeno &bull; Rango Óptimo 6.5 — 8.5 pH</p>
                </div>
                <div class="sensor-reading-display">
                    <span class="reading-num">@GetLatestValueNumeric("ph_agua_tratada").ToString("0.00", Culture)</span>
                    <span class="reading-unit">pH</span>
                </div>
            </div>

            @{
                var phScale = CalculateScale("ph_agua_tratada", RecentPoints);
                var phChartData = BuildChartData("ph_agua_tratada", phScale.Min, phScale.Max);
            }

            <div class="chart-container" id="container-ph">
                <div class="chart-tooltip" id="tooltip-ph"></div>
                <div class="svg-chart-wrapper">
                    <svg class="chart-interactive-svg" id="svg-ph" viewBox="0 0 500 220" 
                         data-chart-id="ph" data-points="@phChartData.JsonPoints" role="img" aria-label="Curva de pH">
                        <defs>
                            <linearGradient id="grad-ph" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.25" />
                                <stop offset="60%" stop-color="#38BDF8" stop-opacity="0.06" />
                                <stop offset="100%" stop-color="#38BDF8" stop-opacity="0.0" />
                            </linearGradient>
                        </defs>

                        <!-- Fondo del área de trazado recesada -->
                        <rect x="46" y="14" width="442" height="162" fill="#131823" stroke="rgba(255, 255, 255, 0.05)" stroke-width="1" rx="8" />

                        <!-- Cuadrícula horizontal y etiquetas de escala Y -->
                        @for (int i = 0; i < phScale.Ticks.Count; i++)
                        {
                            var tickVal = phScale.Ticks[i];
                            var yPos = 14.0 + (i * (162.0 / (phScale.Ticks.Count - 1)));
                            <line x1="46" y1="@yPos.ToString("0.##", Culture)" x2="488" y2="@yPos.ToString("0.##", Culture)" stroke="rgba(255, 255, 255, 0.05)" stroke-width="1" />
                            @((MarkupString)$"<text x=\"40\" y=\"{(yPos + 4).ToString("0.##", Culture)}\" fill=\"#94A3B8\" font-size=\"13\" text-anchor=\"end\" font-weight=\"500\">{tickVal.ToString(phScale.Format, Culture)}</text>")
                        }

                        <!-- Cuadrícula vertical de tiempo -->
                        @for (int i = 0; i <= 4; i++)
                        {
                            var xPos = 46.0 + i * (442.0 / 4.0);
                            <line x1="@xPos.ToString("0.##", Culture)" y1="14" x2="@xPos.ToString("0.##", Culture)" y2="176" stroke="rgba(255, 255, 255, 0.04)" stroke-width="1" />
                        }

                        @if (!phChartData.HasData)
                        {
                            @((MarkupString)"<text x=\"267\" y=\"100\" fill=\"#64748B\" font-size=\"13\" text-anchor=\"middle\" font-weight=\"500\">Sin datos registrados en el intervalo</text>")
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(phChartData.AreaPath))
                            {
                                <path d="@phChartData.AreaPath" fill="url(#grad-ph)" />
                            }
                            @if (!string.IsNullOrWhiteSpace(phChartData.CurvePath))
                            {
                                <path d="@phChartData.CurvePath" fill="none" stroke="#38BDF8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                            }
                        }

                        <!-- Guía interactiva de cursor -->
                        <line id="guide-line-ph" x1="0" y1="14" x2="0" y2="176" stroke="rgba(255, 255, 255, 0.25)" stroke-dasharray="3 3" stroke-width="1" style="display:none;" />
                        <circle id="guide-dot-ph" cx="0" cy="0" r="4.5" fill="#38BDF8" stroke="#0E1626" stroke-width="2" style="display:none;" />

                        <!-- Eje X: 5 marcas de tiempo con excelente legibilidad -->
                        <text x="46" y="198" fill="#94A3B8" font-size="12" font-weight="500">@GetTimeAt(0.0)</text>
                        <text x="156.5" y="198" fill="#94A3B8" font-size="12" font-weight="500" text-anchor="middle">@GetTimeAt(0.25)</text>
                        <text x="267" y="198" fill="#94A3B8" font-size="12" font-weight="500" text-anchor="middle">@GetTimeAt(0.50)</text>
                        <text x="377.5" y="198" fill="#94A3B8" font-size="12" font-weight="500" text-anchor="middle">@GetTimeAt(0.75)</text>
                        <text x="488" y="198" fill="#94A3B8" font-size="12" font-weight="500" text-anchor="end">@GetTimeAt(1.0)</text>
                    </svg>
                </div>
            </div>
        </section>

