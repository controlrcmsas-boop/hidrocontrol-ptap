@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Operador,Gerente,Administrador")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using PTAPControl.Models
@using PTAPControl.Services
@implements IAsyncDisposable
@inject NodeRedApiClient Api

<PageTitle>PTAP Control</PageTitle>

<section class="scada-page">
    <header class="scada-header">
        <div>
            <p class="eyebrow">HIDROCONTROL PTAP V2.2</p>
            <h1>PTAP Control</h1>
        </div>
        <AuthorizeView Roles="Operador,Administrador">
            <Authorized>
                <div class="mode-selector-strip">
                    <label class="mode-label">Modo Operativo:</label>
                    <div class="mode-buttons-group">
                        <button type="button" class="btn-mode @(Api.Simulation.CurrentMode == PtapDataSourceMode.SimulatedAuto ? "active auto" : "")" 
                                @onclick="() => SwitchMode(PtapDataSourceMode.SimulatedAuto)" title="Simulación autónoma continua en la nube (Ideal para demos 24/7)">
                            Piloto Auto (Nube)
                        </button>
                        <button type="button" class="btn-mode @(Api.Simulation.CurrentMode == PtapDataSourceMode.SimulatedManual ? "active manual" : "")" 
                                @onclick="() => SwitchMode(PtapDataSourceMode.SimulatedManual)" title="Showroom interactivo con inyección de fallas">
                            Showroom Demo
                        </button>
                        <button type="button" class="btn-mode @(Api.Simulation.CurrentMode == PtapDataSourceMode.PhysicalPlc ? "active plc" : "")" 
                                @onclick="() => SwitchMode(PtapDataSourceMode.PhysicalPlc)" title="@($"Conexión física directa con PLC Siemens S7-1200 en planta (192.168.1.110 vía {Api.EndpointDisplay})")">
                            Planta Real (PLC)
                        </button>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="system-strip">
            <span class="status-dot @(Telemetry?.PlcConnected == true ? "ok" : "bad")"></span>
            <span class="status-text @(Telemetry?.PlcConnected == true ? "connected" : "disconnected")">
                @(Telemetry?.PlcConnected == true 
                    ? (Api.Simulation.CurrentMode == PtapDataSourceMode.PhysicalPlc ? $"PLC FÍSICO CONECTADO (192.168.1.110 | {Api.EndpointDisplay})" : "SIMULADOR EN LÍNEA (24/7)") 
                    : "PLC DESCONECTADO (SEÑAL PERDIDA)")
            </span>
            <span>Watchdog: @FormatNumber("watchdog_plc", "0")</span>
            <span>@LastRefreshText</span>
        </div>
    </header>

    @if (Telemetry?.PlcConnected == false)
    {
        <div class="plc-lost-alert-banner">
            <span class="alert-icon-dot"></span>
            <div class="alert-body">
                <strong>ALERTA DE PROCESO: ENLACE CON EL AUTÓMATA INTERRUMPIDO</strong>
                <p>No se recibe telemetría del PLC Siemens S7-1200 ni del motor de adquisición. Los mandos de control están bloqueados por seguridad física de la planta.</p>
            </div>
        </div>
    }

    <div class="home-alarm-slot">
        <GlobalAlarmBanner />
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert-line">@ErrorMessage</div>
    }

    <div class="dashboard-grid">
        <div class="plant-stage-scroll-container">
            <section class="plant-stage plant-stage-v2" aria-label="Pantalla SCADA PTAP">
                <img src="images/hidrocontrol-scada.png" alt="HIDROCONTROL PTAP" />

                <!-- Hotspots interactivos de equipos (Minimalistas: solo visibles en hover o tap) -->
                <div class="equipment-hotspot hotspot-ea101 @(_activeEquipment == "EA-101" ? "active" : "")" 
                     @onclick='() => ToggleEquipment("EA-101")' 
                     tabindex="0"
                     title="Torre de Aireación">
                    <span class="hotspot-pin"></span>
                    <div class="hotspot-popover">
                        <span class="popover-code">EA-101</span>
                        <span class="popover-name">Torre de Aireación</span>
                    </div>
                </div>

                <div class="equipment-hotspot hotspot-fh201 @(_activeEquipment == "FH-201" ? "active" : "")" 
                     @onclick='() => ToggleEquipment("FH-201")' 
                     tabindex="0"
                     title="Floculador Hidráulico">
                    <span class="hotspot-pin"></span>
                    <div class="hotspot-popover">
                        <span class="popover-code">FH-201</span>
                        <span class="popover-name">Floculador Hidráulico</span>
                    </div>
                </div>

                <div class="equipment-hotspot hotspot-sc301 @(_activeEquipment == "SC-301" ? "active" : "")" 
                     @onclick='() => ToggleEquipment("SC-301")' 
                     tabindex="0"
                     title="Sedimentador Lamelar">
                    <span class="hotspot-pin"></span>
                    <div class="hotspot-popover">
                        <span class="popover-code">SC-301</span>
                        <span class="popover-name">Sedimentador Lamelar</span>
                    </div>
                </div>

                <div class="equipment-hotspot hotspot-fc401 @(_activeEquipment == "FC-401" ? "active" : "")" 
                     @onclick='() => ToggleEquipment("FC-401")' 
                     tabindex="0"
                     title="Filtro Carbón Activado">
                    <span class="hotspot-pin"></span>
                    <div class="hotspot-popover">
                        <span class="popover-code">FC-401</span>
                        <span class="popover-name">Filtro Carbón Activado</span>
                    </div>
                </div>

                <div class="equipment-hotspot hotspot-tk101 @(_activeEquipment == "TK-101" ? "active" : "")" 
                     @onclick='() => ToggleEquipment("TK-101")' 
                     tabindex="0"
                     title="Tanque Agua Cruda">
                    <span class="hotspot-pin"></span>
                    <div class="hotspot-popover">
                        <span class="popover-code">TK-101</span>
                        <span class="popover-name">Tanque Agua Cruda</span>
                    </div>
                </div>

                <div class="equipment-hotspot hotspot-tk501 @(_activeEquipment == "TK-501" ? "active" : "")" 
                     @onclick='() => ToggleEquipment("TK-501")' 
                     tabindex="0"
                     title="Tanque Agua Tratada">
                    <span class="hotspot-pin"></span>
                    <div class="hotspot-popover">
                        <span class="popover-code">TK-501</span>
                        <span class="popover-name">Tanque Agua Tratada</span>
                    </div>
                </div>

                <!-- Menú desplegable interactivo de Agua Tratada con flecha hacia abajo -->
                <div class="treated-water-interactive-card">
                    <button type="button" class="btn-treated-water-toggle @(_showTreatedMenu ? "open" : "")" 
                            @onclick="ToggleTreatedMenu" aria-label="Desplegar datos de Agua Tratada">
                        <span class="treated-dot"></span>
                        <span class="treated-text">AGUA TRATADA</span>
                        <span class="treated-arrow">▼</span>
                    </button>

                    @if (_showTreatedMenu)
                    {
                        <div class="treated-water-dropdown animate-fade-in">
                            <div class="dropdown-item">
                                <span class="lbl">Turbidez</span>
                                <strong class="val val-turb">@FormatNumber("turbidez_agua_tratada", "0.00") <small>NTU</small></strong>
                            </div>
                            <div class="dropdown-item">
                                <span class="lbl">pH</span>
                                <strong class="val val-ph">@FormatNumber("ph_agua_tratada", "0.00") <small>pH</small></strong>
                            </div>
                            <div class="dropdown-item">
                                <span class="lbl">Conductividad</span>
                                <strong class="val val-cond">@FormatNumber("conductividad_agua_tratada", "0") <small>µS/cm</small></strong>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- Tarjeta adaptada para móviles (Solo Agua Tratada) -->
            <div class="mobile-process-cards">
                <div class="mobile-metric-card mobile-treated-card">
                    <button type="button" class="mobile-treated-toggle @(_showTreatedMenu ? "open" : "")" @onclick="ToggleTreatedMenu">
                        <span class="treated-dot"></span>
                        <span class="mobile-toggle-title">Agua Tratada</span>
                        <span class="treated-arrow">▼</span>
                    </button>
                    @if (_showTreatedMenu)
                    {
                        <div class="mobile-metric-content animate-fade-in">
                            <div class="metric-card-row"><span>Turbidez:</span><strong>@FormatNumber("turbidez_agua_tratada", "0.00") NTU</strong></div>
                            <div class="metric-card-row"><span>pH:</span><strong>@FormatNumber("ph_agua_tratada", "0.00") pH</strong></div>
                            <div class="metric-card-row"><span>Conductividad:</span><strong>@FormatNumber("conductividad_agua_tratada", "0") µS/cm</strong></div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <aside class="side-panel">
            <AuthorizeView Roles="Operador">
                <Authorized>
                    <section class="panel-section">
                        <h2>Equipos</h2>

                        <div class="equipment-row">
                            <div class="equipment-id">B1</div>
                            <div class="equipment-main">
                                <strong>Bomba principal</strong>
                                <span class="equipment-state @StateClass("bomba_principal_estado")">@StateText("bomba_principal_estado")</span>
                            </div>
                            <div class="equipment-actions">
                                <button type="button" class="cmd start @CommandButtonClass("bomba_principal_estado", true)" @onclick='() => SendCommandAsync("bomba_principal", "start")'>ON</button>
                                <button type="button" class="cmd stop @CommandButtonClass("bomba_principal_estado", false)" @onclick='() => SendCommandAsync("bomba_principal", "stop")'>OFF</button>
                            </div>
                        </div>

                        <div class="equipment-row">
                            <div class="equipment-id">B2</div>
                            <div class="equipment-main">
                                <strong>Dosificador sulfato</strong>
                                <span class="equipment-state @StateClass("dosificador_sulfato_estado")">@StateText("dosificador_sulfato_estado")</span>
                            </div>
                            <div class="equipment-actions">
                                <button type="button" class="cmd start @CommandButtonClass("dosificador_sulfato_estado", true)" @onclick='() => SendCommandAsync("dosificador_sulfato", "start")'>ON</button>
                                <button type="button" class="cmd stop @CommandButtonClass("dosificador_sulfato_estado", false)" @onclick='() => SendCommandAsync("dosificador_sulfato", "stop")'>OFF</button>
                            </div>
                        </div>

                        <div class="equipment-row">
                            <div class="equipment-id">B3</div>
                            <div class="equipment-main">
                                <strong>Dosificador cloro</strong>
                                <span class="equipment-state @StateClass("dosificador_cloro_estado")">@StateText("dosificador_cloro_estado")</span>
                            </div>
                            <div class="equipment-actions">
                                <button type="button" class="cmd start @CommandButtonClass("dosificador_cloro_estado", true)" @onclick='() => SendCommandAsync("dosificador_cloro", "start")'>ON</button>
                                <button type="button" class="cmd stop @CommandButtonClass("dosificador_cloro_estado", false)" @onclick='() => SendCommandAsync("dosificador_cloro", "stop")'>OFF</button>
                            </div>
                        </div>
                    </section>
                </Authorized>
            </AuthorizeView>

            <section class="panel-section compact-metrics">
                <h2>Calidad Agua Tratada</h2>
                <div class="metric-row"><span>pH tratada</span><strong>@FormatNumber("ph_agua_tratada", "0.00") <small>pH</small></strong></div>
                <div class="metric-row"><span>Turbidez tratada</span><strong>@FormatNumber("turbidez_agua_tratada", "0.00") <small>NTU</small></strong></div>
                <div class="metric-row"><span>Conductividad tratada</span><strong>@FormatNumber("conductividad_agua_tratada", "0") <small>µS/cm</small></strong></div>
                <a href="historicos" class="btn-quality-charts-link">
                    Ver Curvas y Gráficas de Proceso &rarr;
                </a>
            </section>

            <section class="panel-section status-box">
                <h2>Seguridad</h2>
                <div>
                    <span>Modo remoto</span>
                    @if (Telemetry?.PlcConnected == true && Telemetry?.GetBool("modo_remoto_habilitado") == true)
                    {
                        <strong class="status-val-ok" style="color: #48d597 !important; font-weight: 800;">SI</strong>
                    }
                    else
                    {
                        <strong class="status-val-alarm" style="color: #ff6b6b !important; font-weight: 800;">NO</strong>
                    }
                </div>
                <div>
                    <span>Falla PLC</span>
                    @if (Telemetry?.PlcConnected != true || Telemetry?.GetBool("plc_en_falla") == true)
                    {
                        <strong class="status-val-alarm" style="color: #ff6b6b !important; font-weight: 800;">SI</strong>
                    }
                    else
                    {
                        <strong class="status-val-ok" style="color: #48d597 !important; font-weight: 800;">NO</strong>
                    }
                </div>
                <div>
                    <span>Ultimo comando</span>
                    <strong>@LastCommandText</strong>
                </div>
            </section>
        </aside>
    </div>
</section>

@code {
    private TelemetryResponse? Telemetry;
    private string? ErrorMessage;
    private string LastCommandText = "Sin comando";
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;
    private bool _showTreatedMenu = false;
    private string? _activeEquipment = null;

    private void ToggleTreatedMenu() => _showTreatedMenu = !_showTreatedMenu;
    private void ToggleEquipment(string id) => _activeEquipment = _activeEquipment == id ? null : id;

    protected override async Task OnInitializedAsync()
    {
        cts = new CancellationTokenSource();
        await RefreshAsync();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RefreshLoopAsync(cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        if (timer is null) return;

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SwitchMode(PtapDataSourceMode mode)
    {
        Api.Simulation.SetMode(mode);
        if (mode == PtapDataSourceMode.SimulatedAuto)
        {
            Api.Simulation.SimulatePlcDisconnected = false;
            Api.Simulation.SetScenario("normal");
        }
        await RefreshAsync();
    }

    private void SetScenario(string scenario)
    {
        Api.Simulation.SetScenario(scenario);
    }

    private void ToggleSimulatedDisconnect()
    {
        Api.Simulation.SimulatePlcDisconnected = !Api.Simulation.SimulatePlcDisconnected;
    }

    private async Task RefreshAsync()
    {
        try
        {
            Telemetry = await Api.GetCurrentTelemetryAsync(cts?.Token ?? CancellationToken.None);
            ErrorMessage = null;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error de lectura: {ex.Message}";
        }
    }

    private async Task SendCommandAsync(string target, string command)
    {
        try
        {
            var response = await Api.SendCommandAsync(target, command, cts?.Token ?? CancellationToken.None);
            LastCommandText = response?.Accepted == true
                ? $"{target} {command} aceptado"
                : response?.Error ?? "Comando rechazado";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            LastCommandText = "Error de comando";
            ErrorMessage = ex.Message;
        }
    }

    private string FormatNumber(string key, string format)
    {
        var value = Telemetry?.GetNumber(key);
        return value.HasValue ? value.Value.ToString(format) : "--";
    }

    private string BoolText(string key) => Telemetry?.GetBool(key) == true ? "SI" : "NO";
    private string StateText(string key) => Telemetry?.GetBool(key) == true ? "Encendido" : "Apagado";
    private string StateClass(string key) => Telemetry?.GetBool(key) == true ? "running" : "stopped";
    private string CommandButtonClass(string key, bool activeWhenOn) => Telemetry?.GetBool(key) == activeWhenOn ? "lit" : string.Empty;
    private string LastRefreshText => Telemetry is null ? "Sin lectura" : Telemetry.Timestamp.ToLocalTime().ToString("HH:mm:ss");

    public async ValueTask DisposeAsync()
    {
        if (cts is not null)
        {
            await cts.CancelAsync();
            cts.Dispose();
        }

        timer?.Dispose();
    }
}

<style>
.btn-quality-charts-link {
    display: block;
    margin-top: 0.85rem;
    padding: 0.55rem 0.75rem;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 8px;
    color: #38bdf8;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    text-align: center;
    transition: all 0.2s ease;
}
.btn-quality-charts-link:hover {
    background: rgba(56, 189, 248, 0.25);
    border-color: #38bdf8;
    color: #ffffff;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
}
</style>

