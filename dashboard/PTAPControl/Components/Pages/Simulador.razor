    }

    private async Task TogglePlcFalla(ChangeEventArgs e)
    {
        SimState.PlcEnFalla = Convert.ToBoolean(e.Value);
        await SyncStateAsync($"Falla PLC {(SimState.PlcEnFalla ? "FORZADA (ALARMA ACTIVA)" : "NORMALIZADA")}");
    }

    private double GetEstimatedPhTratada()
    {
        if (SimState.DosificadorSulfatoEstado && SimState.BombaPrincipalEstado)
        {
            return Math.Max(6.0, SimState.PhCrudaBase - 0.20);
        }
        return SimState.PhCrudaBase;
    }

    private double GetEstimatedTurbTratada()
    {
        if (SimState.DosificadorSulfatoEstado && SimState.BombaPrincipalEstado)
        {
            return Math.Max(0.25, SimState.TurbidezCrudaBase * 0.025);
        }
        return Math.Max(1.5, SimState.TurbidezCrudaBase * 0.45);
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
