@page "/simulador"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Simulador,Demo")]
@rendermode InteractiveServer
@using PTAPControl.Services
@using PTAPControl.Models
@inject NodeRedApiClient Api
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Simulador PTAP — HIDROCONTROL</PageTitle>

<div class="simulator-page">
    <div class="simulator-header">
        <div>
            <h1 class="page-title">Emulador de Planta PTAP</h1>
            <p class="page-subtitle">
                Ajuste de variables de proceso y control de actuadores para pruebas y calibración.
            </p>
        </div>
        <div class="sim-header-actions">
            <div class="mode-selector-strip">
                <label class="mode-label">Modo Operativo:</label>
                <div class="mode-buttons-group">
                    <button type="button" class="btn-mode @(Api.Simulation.CurrentMode != PtapDataSourceMode.PhysicalPlc ? "active auto" : "")" 
                            @onclick="() => SwitchMode(PtapDataSourceMode.SimulatedAuto)" title="Modo de simulación de planta">
                        Simulador
                    </button>
                    <button type="button" class="btn-mode @(Api.Simulation.CurrentMode == PtapDataSourceMode.PhysicalPlc ? "active plc" : "")" 
                            @onclick="() => SwitchMode(PtapDataSourceMode.PhysicalPlc)" title="Conexión física con autómata PLC Siemens S7-1200">
                        PLC
                    </button>
                </div>
            </div>
            <TopUserNav />
        </div>
    </div>

    <!-- ESCENARIOS RÁPIDOS: Botones cápsula limpios sin emojis -->
    <div class="preset-section">
        <span class="preset-title">Escenarios de Prueba Rápidos:</span>
        <div class="preset-buttons">
            <button type="button" class="preset-btn @(CurrentScenario == "normal" ? "active" : "")" 
                    @onclick="@(() => ApplyPreset("normal"))">
                Operación Normal
            </button>
            <button type="button" class="preset-btn @(CurrentScenario == "rain" ? "active" : "")" 
                    @onclick="@(() => ApplyPreset("rain"))">
                Alta Turbidez (85 NTU)
            </button>
            <button type="button" class="preset-btn @(CurrentScenario == "pump_fault" ? "active" : "")" 
                    @onclick="@(() => ApplyPreset("pump_fault"))">
                Falla Bomba Principal
            </button>
            <button type="button" class="preset-btn @(CurrentScenario == "chlorine_fault" ? "active" : "")" 
                    @onclick="@(() => ApplyPreset("chlorine_fault"))">
                Falla Dosificador Cloro
            </button>
            <button type="button" class="preset-btn stop" @onclick="StopAll">
                Parada de Emergencia
            </button>
        </div>
    </div>

    <div class="simulator-grid">
        <!-- COLUMNA 1: VARIABLES DE PROCESO (Únicamente pH, Turbidez y Conductividad) -->
        <div class="sim-card">
            <div class="card-header">
                <h3>Variables de Proceso</h3>
            </div>

            <!-- pH -->
            <div class="control-group">
                <div class="control-label-row">
                    <label>pH</label>
                    <span class="val-text">@SimState.PhCrudaBase.ToString("F2") pH</span>
                </div>
                <input type="range" class="sim-slider" min="4.0" max="10.0" step="0.05"
                       value="@SimState.PhCrudaBase"
                       @oninput="(e) => OnPhChange(e)" />
                <div class="range-limits">
                    <span>4.0</span>
                    <span class="optimum">Óptimo (6.5 — 8.5)</span>
                    <span>10.0</span>
                </div>
            </div>

            <!-- Turbidez -->
            <div class="control-group">
                <div class="control-label-row">
                    <label>Turbidez</label>
                    <span class="val-text">@SimState.TurbidezCrudaBase.ToString("F1") NTU</span>
                </div>
                <input type="range" class="sim-slider" min="1.0" max="120.0" step="0.5"
                       value="@SimState.TurbidezCrudaBase"
                       @oninput="(e) => OnTurbidezChange(e)" />
                <div class="range-limits">
                    <span>1.0 NTU</span>
                    <span class="optimum">Normal (15 — 25)</span>
                    <span>120 NTU</span>
                </div>
            </div>

            <!-- Conductividad -->
            <div class="control-group">
                <div class="control-label-row">
                    <label>Conductividad</label>
                    <span class="val-text">@SimState.ConductividadCrudaBase.ToString("F0") µS/cm</span>
                </div>
                <input type="range" class="sim-slider" min="100" max="1000" step="10"
                       value="@SimState.ConductividadCrudaBase"
                       @oninput="(e) => OnCondChange(e)" />
                <div class="range-limits">
                    <span>100 µS/cm</span>
                    <span>500 µS/cm</span>
                    <span>1.000 µS/cm</span>
                </div>
            </div>
        </div>

        <!-- COLUMNA 2: ACTUADORES DEL TABLERO (Solo equipos físicos existentes) -->
        <div class="sim-card">
            <div class="card-header">
                <h3>Actuadores del Tablero</h3>
            </div>

            <div class="switches-list">
                <!-- Bomba Principal (B1) -->
                <div class="switch-row">
                    <div class="switch-info">
                        <strong>Bomba Principal (B1)</strong>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@SimState.BombaPrincipalEstado" @onchange="ToggleBomba" />
                        <span class="slider round"></span>
                    </label>
                </div>

                <!-- Dosificador Sulfato (B2) -->
                <div class="switch-row">
                    <div class="switch-info">
                        <strong>Dosificador de Sulfato (B2)</strong>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@SimState.DosificadorSulfatoEstado" @onchange="ToggleSulfato" />
                        <span class="slider round"></span>
                    </label>
                </div>

                <!-- Dosificador Cloro (B3) -->
                <div class="switch-row">
                    <div class="switch-info">
                        <strong>Dosificador de Cloro (B3)</strong>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@SimState.DosificadorCloroEstado" @onchange="ToggleCloro" />
                        <span class="slider round"></span>
                    </label>
                </div>

                <!-- Forzar Falla PLC -->
                <div class="switch-row danger-switch">
                    <div class="switch-info">
                        <strong>Forzar Falla en PLC S7-1200</strong>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@SimState.PlcEnFalla" @onchange="TogglePlcFalla" />
                        <span class="slider round danger"></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .simulator-page {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 16px 22px 3rem;
        width: 100%;
        box-sizing: border-box;
    }

    .simulator-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        width: 100%;
    }

    .sim-header-actions {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    /* Selector de modo operativo en Simulador */
    .mode-selector-strip {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--panel);
        border: 1px solid var(--line);
        padding: 4px 12px;
        border-radius: 9999px;
    }

    .mode-label {
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #94A3B8;
    }

    .mode-buttons-group {
        display: flex;
        gap: 6px;
    }

    .btn-mode {
        background: var(--panel-2);
        border: 1px solid var(--line);
        color: #94A3B8;
        padding: 0.35rem 1rem;
        border-radius: 9999px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-mode:hover {
        background: #353842;
        color: #FFFFFF;
    }

    .btn-mode.active.auto,
    .btn-mode.active.plc {
        background: #38BDF8;
        border-color: #38BDF8;
        color: #0F172A;
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(56, 189, 248, 0.25);
    }

    .page-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #FFFFFF;
        margin: 0;
        letter-spacing: -0.02em;
    }

    .page-subtitle {
        font-size: 0.85rem;
        color: #8C93A4;
        margin: 0.35rem 0 0;
    }

    /* Sección de escenarios rápidos */
    .preset-section {
        background: var(--panel);
        border: 1px solid var(--line);
        padding: 1rem 1.25rem;
        border-radius: 14px;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: 100%;
        box-sizing: border-box;
    }

    .preset-title {
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: #8C93A4;
    }

    .preset-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    /* Botones píldora estilo Imagen 2 */
    .preset-btn {
        background: #2A2C32;
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #9EABB8;
        padding: 0.45rem 1.2rem;
        border-radius: 9999px;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .preset-btn:hover {
        background: #353842;
        color: #FFFFFF;
    }

    .preset-btn.active {
        background: #38BDF8;
        border-color: #38BDF8;
        color: #0F172A;
        font-weight: 600;
    }

    .preset-btn.stop {
        border-color: rgba(239, 68, 68, 0.3);
        color: #F87171;
    }

    .preset-btn.stop:hover {
        background: #EF4444;
        color: #FFFFFF;
        border-color: #EF4444;
    }

    /* Grid de simulación: 2 tarjetas de sección equilibradas en escritorio */
    .simulator-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        width: 100%;
        box-sizing: border-box;
    }

    @@media (min-width: 960px) {
        .simulator-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    .sim-card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        box-sizing: border-box;
    }

    .card-header {
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        padding-bottom: 0.85rem;
    }

    .card-header h3 {
        margin: 0;
        font-size: 1.1rem;
        color: #FFFFFF;
        font-weight: 600;
    }

    .control-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .control-label-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.92rem;
        font-weight: 600;
        color: #E2E8F0;
    }

    .val-text {
        color: #38BDF8;
        font-weight: 700;
        font-size: 0.95rem;
    }

    .sim-slider {
        -webkit-appearance: none;
        width: 100%;
        height: 6px;
        border-radius: 9999px;
        background: #2A2C32;
        outline: none;
        transition: opacity 0.2s;
    }

    .sim-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #38BDF8;
        cursor: pointer;
        border: 2px solid #FFFFFF;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    }

    .sim-slider::-moz-range-thumb {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #38BDF8;
        cursor: pointer;
        border: 2px solid #FFFFFF;
    }

    .range-limits {
        display: flex;
        justify-content: space-between;
        font-size: 0.72rem;
        color: #7E8494;
    }

    .range-limits .optimum {
        color: #9EABB8;
    }

    /* Lista de actuadores */
    .switches-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .switch-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.85rem 1rem;
        background: #18191D;
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 12px;
    }

    .switch-info strong {
        font-size: 0.92rem;
        color: #FFFFFF;
        font-weight: 500;
    }

    /* Toggle switches elegantes */
    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 48px;
        height: 26px;
        flex-shrink: 0;
    }

    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #2A2C32;
        transition: 0.25s;
        border-radius: 9999px;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 20px;
        width: 20px;
        left: 3px;
        bottom: 3px;
        background-color: #FFFFFF;
        transition: 0.25s;
        border-radius: 50%;
    }

    input:checked + .slider {
        background-color: #38BDF8;
    }

    input:checked + .slider.danger {
        background-color: #EF4444;
    }

    input:checked + .slider:before {
        transform: translateX(22px);
    }
</style>

@code {
    private SimulatorStateDto SimState = new();
    private string CurrentScenario = "normal";
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadStateAsync();
    }

    private async Task LoadStateAsync()
    {
        var remoteState = await Api.GetSimulatorStateAsync(_cts.Token);
        if (remoteState is not null)
        {
            SimState = remoteState;
            CurrentScenario = remoteState.Scenario;
        }
    }

    private async Task SwitchMode(PtapDataSourceMode mode)
    {
        Api.Simulation.SetMode(mode);
        if (mode == PtapDataSourceMode.SimulatedAuto)
        {
            Api.Simulation.SimulatePlcDisconnected = false;
            Api.Simulation.SetScenario("normal");
        }
        await LoadStateAsync();
        StateHasChanged();
    }

    private async Task SyncStateAsync(string reason)
    {
        var result = await Api.UpdateSimulatorStateAsync(SimState, _cts.Token);
        if (result is not null)
        {
            SimState = result;
            StateHasChanged();
        }
    }

    private async Task ApplyPreset(string scenario)
    {
        CurrentScenario = scenario;
        var success = await Api.SetSimulatorScenarioAsync(scenario, _cts.Token);
        if (success)
        {
            await LoadStateAsync();
            StateHasChanged();
        }
    }

    private async Task StopAll()
    {
        SimState.BombaPrincipalEstado = false;
        SimState.DosificadorSulfatoEstado = false;
        SimState.DosificadorCloroEstado = false;
        await SyncStateAsync("Parada total de emergencia");
    }

    private async Task OnPhChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var val))
        {
            SimState.PhCrudaBase = val;
            await SyncStateAsync($"pH ajustado a {val:F2}");
        }
    }

    private async Task OnTurbidezChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var val))
        {
            SimState.TurbidezCrudaBase = val;
            await SyncStateAsync($"Turbidez ajustada a {val:F1} NTU");
        }
    }

    private async Task OnCondChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var val))
        {
            SimState.ConductividadCrudaBase = val;
            await SyncStateAsync($"Conductividad ajustada a {val:F0} µS/cm");
        }
    }

    private async Task ToggleBomba(ChangeEventArgs e)
    {
        SimState.BombaPrincipalEstado = Convert.ToBoolean(e.Value);
        await SyncStateAsync($"Bomba Principal {(SimState.BombaPrincipalEstado ? "ENCENDIDA" : "APAGADA")}");
    }

    private async Task ToggleSulfato(ChangeEventArgs e)
    {
        SimState.DosificadorSulfatoEstado = Convert.ToBoolean(e.Value);
        await SyncStateAsync($"Dosificador Sulfato {(SimState.DosificadorSulfatoEstado ? "ENCENDIDO" : "APAGADO")}");
    }

    private async Task ToggleCloro(ChangeEventArgs e)
    {
        SimState.DosificadorCloroEstado = Convert.ToBoolean(e.Value);
        await SyncStateAsync($"Dosificador Cloro {(SimState.DosificadorCloroEstado ? "ENCENDIDO" : "APAGADO")}");
    }

    private async Task TogglePlcFalla(ChangeEventArgs e)
    {
        SimState.PlcEnFalla = Convert.ToBoolean(e.Value);
        await SyncStateAsync($"Falla PLC {(SimState.PlcEnFalla ? "FORZADA (ALARMA ACTIVA)" : "NORMALIZADA")}");
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
