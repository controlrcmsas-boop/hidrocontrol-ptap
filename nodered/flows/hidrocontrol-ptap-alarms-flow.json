        "func":  "var body = msg.payload || {};\nvar email = (body.email || '').trim().toLowerCase();\nvar name = body.name || null;\nif (!email || email.indexOf('@') < 1) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'correo invalido' };\n    return [null, msg];\n}\nmsg.query = \"INSERT INTO notification_emails (email, name, enabled) VALUES ($1, $2, true) ON CONFLICT (email) DO UPDATE SET name = EXCLUDED.name, enabled = true, updated_at = now() RETURNING id, email, name, enabled, created_at;\";\nmsg.params = [email, name];\nreturn [msg, null];",
