    {
        "id":  "fn_alarm_eval_001",
        "type":  "function",
        "z":  "hidro_alarms_tab_001",
        "name":  "Evaluar condiciones",
        "func":  "var limits = msg.payload || [];\nvar telemetry = global.get(\u0027hidroTelemetryCurrent\u0027);\nif (!telemetry || !telemetry.values) {\n    node.status({ fill: \u0027yellow\u0027, shape: \u0027ring\u0027, text: \u0027sin telemetria\u0027 });\n    return null;\n}\n\nvar values = telemetry.values;\nvar messages = [];\n\nfunction toNumber(value) {\n    var n = Number(value);\n    return Number.isFinite(n) ? n : null;\n}\n\nfunction toBool(value) {\n    if (typeof value === \u0027boolean\u0027) return value;\n    if (typeof value === \u0027number\u0027) return value !== 0;\n    if (typeof value === \u0027string\u0027) return value.toLowerCase() === \u0027true\u0027 || value === \u00271\u0027;\n    return null;\n}\n\nlimits.forEach(function (limit) {\n    var tag = limit.tag_id;\n    if (values[tag] === undefined || values[tag] === null) return;\n\n    var alarm = false;\n    var numericValue = null;\n    var boolValue = null;\n    var low = limit.limit_low === null || limit.limit_low === undefined ? null : Number(limit.limit_low);\n    var high = limit.limit_high === null || limit.limit_high === undefined ? null : Number(limit.limit_high);\n\n    if (limit.alarm_type === \u0027bool_equals\u0027) {\n        boolValue = toBool(values[tag]);\n        var alarmBool = toBool(limit.bool_alarm_value);\n        if (boolValue === null || alarmBool === null) return;\n        alarm = boolValue === alarmBool;\n    } else {\n        numericValue = toNumber(values[tag]);\n        if (numericValue === null) return;\n        if ((limit.alarm_type === \u0027range\u0027 || limit.alarm_type === \u0027low\u0027) \u0026\u0026 low !== null \u0026\u0026 numericValue \u003c low) alarm = true;\n        if ((limit.alarm_type === \u0027range\u0027 || limit.alarm_type === \u0027high\u0027) \u0026\u0026 high !== null \u0026\u0026 numericValue \u003e high) alarm = true;\n    }\n\n    if (alarm) {\n        messages.push({\n            query: \"INSERT INTO alarm_events (tag_id, alarm_type, severity, value_numeric, value_bool, message, state, started_at) SELECT $1, $2, $3, $4, $5, $6, \u0027active\u0027, now() WHERE NOT EXISTS (SELECT 1 FROM alarm_events WHERE tag_id = $1 AND alarm_type = $2 AND state = \u0027active\u0027);\",\n            params: [tag, limit.alarm_type, limit.severity || \u0027medium\u0027, numericValue, boolValue, limit.message || (\u0027Alarma activa: \u0027 + tag)]\n        });\n    } else {\n        messages.push({\n            query: \"UPDATE alarm_events SET state = \u0027cleared\u0027, cleared_at = now() WHERE tag_id = $1 AND alarm_type = $2 AND state = \u0027active\u0027;\",\n            params: [tag, limit.alarm_type]\n        });\n    }\n});\n\nnode.status({ fill: \u0027green\u0027, shape: \u0027dot\u0027, text: messages.length + \u0027 evaluaciones\u0027 });\nreturn [messages];",
        "outputs":  1,
        "timeout":  0,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",
        "libs":  [

                 ],
        "x":  680,
        "y":  100,
        "wires":  [
