    {
        "id":  "pg_alarm_limits_eval_001",
        "type":  "postgresql",
        "z":  "hidro_alarms_tab_001",
        "name":  "Leer limites habilitados",
        "query":  "SELECT id, tag_id, alarm_type, enabled, severity, limit_low, limit_high, bool_alarm_value, unit, message FROM alarm_limits WHERE enabled = true ORDER BY id;",
        "postgreSQLConfig":  "postgres_config_hidro_alarm_001",
        "split":  false,
        "rowsPerMsg":  "1",
        "outputs":  1,
        "x":  430,
        "y":  100,
        "wires":  [
                      "fn_alarm_eval_001"
                  ]
