    {
        "id":  "fn_update_alarm_limit_001",
        "type":  "function",
        "z":  "hidro_alarms_tab_001",
        "name":  "Preparar update limite",
        "func":  "var body = msg.payload || {};\nvar id = parseInt(body.id, 10);\nif (!Number.isFinite(id) || id \u003c 1) {\n    msg.statusCode = 400;\n    msg.payload = { error: \u0027id de limite invalido\u0027 };\n    return [null, msg];\n}\n\nfunction nullableNumber(value) {\n    if (value === undefined || value === null || value === \u0027\u0027) return null;\n    var n = Number(value);\n    return Number.isFinite(n) ? n : null;\n}\n\nfunction nullableBool(value) {\n    if (value === undefined || value === null || value === \u0027\u0027) return null;\n    if (typeof value === \u0027boolean\u0027) return value;\n    if (typeof value === \u0027number\u0027) return value !== 0;\n    if (typeof value === \u0027string\u0027) return value.toLowerCase() === \u0027true\u0027 || value === \u00271\u0027;\n    return null;\n}\n\nmsg.query = \"UPDATE alarm_limits SET enabled = $2, severity = $3, limit_low = $4, limit_high = $5, bool_alarm_value = $6, message = $7, updated_at = now() WHERE id = $1 RETURNING id, tag_id, alarm_type, enabled, severity, limit_low, limit_high, bool_alarm_value, unit, message, technical_note, updated_at;\";\nmsg.params = [\n    id,\n    Boolean(body.enabled),\n    body.severity || \u0027medium\u0027,\n    nullableNumber(body.limit_low),\n    nullableNumber(body.limit_high),\n    nullableBool(body.bool_alarm_value),\n    body.message || \u0027Alarma de proceso\u0027\n];\nreturn [msg, null];",
