    {
        "id":  "fn_get_current_001",
        "type":  "function",
        "z":  "hidro_tab_001",
        "name":  "Responder telemetria actual",
        "func":  "const telemetry = flow.get(\u0027telemetryCurrent\u0027);\nconst lastSeen = flow.get(\u0027plcLastSeen\u0027);\nconst now = Date.now();\n\nif (!telemetry) {\n    msg.statusCode = 503;\n    msg.payload = {\n        error: \u0027No telemetry available\u0027,\n        plcConnected: false,\n        timestamp: new Date().toISOString()\n    };\n    return msg;\n}\n\nconst stale = !lastSeen || (now - lastSeen \u003e 10000);\nmsg.payload = {\n    ...telemetry,\n    plcConnected: !stale,\n    stale\n};\nreturn msg;",
        "outputs":  1,
        "timeout":  0,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",
        "libs":  [

                 ],
