    {
        "id": "fn_validate_command_001",
        "type": "function",
        "z": "hidro_tab_001",
        "name": "Validar comando",
        "func": "const body = msg.payload || {};\nconst telemetry = flow.get('telemetryCurrent');\nconst values = telemetry?.values || {};\n\nconst commandMap = {\n    bomba_principal: {\n        start: 'comando_bomba_principal_start',\n        stop: 'comando_bomba_principal_stop'\n    },\n    dosificador_sulfato: {\n        start: 'comando_dosificador_sulfato_start',\n        stop: 'comando_dosificador_sulfato_stop'\n    },\n    dosificador_cloro: {\n        start: 'comando_dosificador_cloro_start',\n        stop: 'comando_dosificador_cloro_stop'\n    }\n};\n\nconst target = body.target;\nconst command = body.command;\nconst operator = body.operator || 'unknown';\nconst source = body.source || 'api';\n\nif (!commandMap[target] || !commandMap[target][command]) {\n    msg.statusCode = 400;\n    msg.payload = { accepted: false, error: 'Invalid target or command', target, command };\n    return [null, msg];\n}\n\nif (values.modo_remoto_habilitado !== true) {\n    msg.statusCode = 409;\n    msg.payload = { accepted: false, error: 'Remote mode is not enabled', target, command };\n    return [null, msg];\n}\n\nif (values.plc_en_falla === true) {\n    msg.statusCode = 409;\n    msg.payload = { accepted: false, error: 'PLC/process is in fault', target, command };\n    return [null, msg];\n}\n\nconst variable = commandMap[target][command];\nconst seq = (flow.get('commandSequence') || 0) + 1;\nflow.set('commandSequence', seq);\n\nconst commandLog = {\n    sequence: seq,\n    target,\n    command,\n    variable,\n    operator,\n    source,\n    requestedAt: new Date().toISOString(),\n    status: 'accepted'\n};\nflow.set('lastCommand', commandLog);\n\nmsg.commandInfo = commandLog;\nmsg.payload = true;\nmsg.variable = variable;\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 340,
        "wires": [
            [
                "fn_pulse_command_001"
            ],
            [
                "http_response_command_error_001"
            ]
        ]
    },
