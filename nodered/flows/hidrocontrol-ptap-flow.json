        "type": "http response",
        "z": "hidro_tab_001",
        "name": "HTTP response status",
        "statusCode": "",
        "headers": {},
        "x": 690,
        "y": 520,
        "wires": []
    },
    {
        "id": "fn_pulse_command_001",
        "type": "function",
        "z": "hidro_tab_001",
        "name": "Pulso comando PLC",
        "func": "const info = msg.commandInfo || {};\nconst variable = msg.variable;\n\nif (!variable) {\n    msg.statusCode = 500;\n    msg.payload = { accepted: false, error: 'No PLC command variable selected' };\n    return [null, msg];\n}\n\nconst writeTrue = { ...msg, payload: true, variable };\nconst writeFalse = { ...msg, payload: false, variable };\n\nconst response = {\n    ...msg,\n    payload: {\n        accepted: true,\n        sequence: info.sequence,\n        target: info.target,\n        command: info.command,\n        variable: info.variable,\n        message: 'Comando validado y enviado al PLC como pulso',\n        pulseMs: 500,\n        timestamp: new Date().toISOString()\n    }\n};\n\nnode.send([writeTrue, response]);\nsetTimeout(() => node.send([writeFalse, null]), 500);\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
