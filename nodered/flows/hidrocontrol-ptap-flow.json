    {
        "id": "fn_get_current_001",
        "type": "function",
        "z": "hidro_tab_001",
        "name": "Responder telemetria actual",
        "func": "const telemetry = flow.get('telemetryCurrent');\nconst lastSeen = flow.get('plcLastSeen');\nconst now = Date.now();\n\nif (!telemetry) {\n    msg.statusCode = 503;\n    msg.payload = {\n        error: 'No telemetry available',\n        plcConnected: false,\n        timestamp: new Date().toISOString()\n    };\n    return msg;\n}\n\nconst stale = !lastSeen || (now - lastSeen > 10000);\nmsg.payload = {\n    ...telemetry,\n    plcConnected: !stale,\n    stale\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 220,
        "wires": [
            [
                "http_response_current_001"
            ]
        ]
    },
