        "id": "fn_store_telemetry_001",
        "type": "function",
        "z": "hidro_tab_001",
        "name": "Guardar telemetria actual",
        "func": "const values = msg.payload || {};\nconst previous = flow.get('telemetryCurrent');\n\nconst telemetry = {\n    timestamp: new Date().toISOString(),\n    plcConnected: true,\n    source: 'PLC_HIDROCONTROL',\n    values\n};\n\nflow.set('telemetryCurrent', telemetry);\nflow.set('plcLastSeen', Date.now());\n\nmsg.payload = telemetry;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
