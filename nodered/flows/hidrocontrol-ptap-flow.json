    {
        "id":  "fn_system_status_001",
        "type":  "function",
        "z":  "hidro_tab_001",
        "name":  "Responder estado sistema",
        "func":  "const lastSeen = flow.get(\u0027plcLastSeen\u0027);\nconst telemetry = flow.get(\u0027telemetryCurrent\u0027);\nconst lastCommand = flow.get(\u0027lastCommand\u0027);\nconst now = Date.now();\nconst stale = !lastSeen || (now - lastSeen \u003e 10000);\n\nmsg.payload = {\n    service: \u0027HIDROCONTROL PTAP Node-RED\u0027,\n    timestamp: new Date().toISOString(),\n    plc: {\n        ip: \u0027192.168.1.110\u0027,\n        connected: !stale,\n        lastSeen: lastSeen ? new Date(lastSeen).toISOString() : null,\n        watchdog: telemetry?.values?.watchdog_plc ?? null\n    },\n    lastCommand: lastCommand || null\n};\nreturn msg;",
        "outputs":  1,
        "timeout":  0,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",
