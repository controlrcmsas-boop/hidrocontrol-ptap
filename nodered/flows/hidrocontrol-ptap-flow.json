    {
        "id": "fn_system_status_001",
        "type": "function",
        "z": "hidro_tab_001",
        "name": "Responder estado sistema",
        "func": "const lastSeen = flow.get('plcLastSeen');\nconst telemetry = flow.get('telemetryCurrent');\nconst lastCommand = flow.get('lastCommand');\nconst now = Date.now();\nconst stale = !lastSeen || (now - lastSeen > 10000);\n\nmsg.payload = {\n    service: 'HIDROCONTROL PTAP Node-RED',\n    timestamp: new Date().toISOString(),\n    plc: {\n        ip: '192.168.1.110',\n        connected: !stale,\n        lastSeen: lastSeen ? new Date(lastSeen).toISOString() : null,\n        watchdog: telemetry?.values?.watchdog_plc ?? null\n    },\n    lastCommand: lastCommand || null\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 520,
        "wires": [
            [
                "http_response_status_001"
            ]
        ]
    },
    {
