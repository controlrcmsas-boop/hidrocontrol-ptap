    {
        "id":  "fn_store_telemetry_001",
        "type":  "function",
        "z":  "hidro_tab_001",
        "name":  "Guardar telemetria actual",
        "func":  "const values = msg.payload || {};\nconst previous = flow.get(\u0027telemetryCurrent\u0027);\n\nconst telemetry = {\n    timestamp: new Date().toISOString(),\n    plcConnected: true,\n    source: \u0027PLC_HIDROCONTROL\u0027,\n    values\n};\n\nflow.set(\u0027telemetryCurrent\u0027, telemetry);\nflow.set(\u0027plcLastSeen\u0027, Date.now());\n\nmsg.payload = telemetry;\nreturn msg;",
        "outputs":  1,
        "timeout":  0,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",
        "libs":  [

