    {
        "id":  "fn_validate_command_001",
        "type":  "function",
        "z":  "hidro_tab_001",
        "name":  "Validar comando",
        "func":  "const body = msg.payload || {};\nconst telemetry = flow.get(\u0027telemetryCurrent\u0027);\nconst values = telemetry?.values || {};\n\nconst commandMap = {\n    bomba_principal: {\n        start: \u0027comando_bomba_principal_start\u0027,\n        stop: \u0027comando_bomba_principal_stop\u0027\n    },\n    dosificador_sulfato: {\n        start: \u0027comando_dosificador_sulfato_start\u0027,\n        stop: \u0027comando_dosificador_sulfato_stop\u0027\n    },\n    dosificador_cloro: {\n        start: \u0027comando_dosificador_cloro_start\u0027,\n        stop: \u0027comando_dosificador_cloro_stop\u0027\n    }\n};\n\nconst target = body.target;\nconst command = body.command;\nconst operator = body.operator || \u0027unknown\u0027;\nconst source = body.source || \u0027api\u0027;\n\nif (!commandMap[target] || !commandMap[target][command]) {\n    msg.statusCode = 400;\n    msg.payload = { accepted: false, error: \u0027Invalid target or command\u0027, target, command };\n    return [null, msg];\n}\n\nif (values.modo_remoto_habilitado !== true) {\n    msg.statusCode = 409;\n    msg.payload = { accepted: false, error: \u0027Remote mode is not enabled\u0027, target, command };\n    return [null, msg];\n}\n\nif (values.plc_en_falla === true) {\n    msg.statusCode = 409;\n    msg.payload = { accepted: false, error: \u0027PLC/process is in fault\u0027, target, command };\n    return [null, msg];\n}\n\nconst variable = commandMap[target][command];\nconst seq = (flow.get(\u0027commandSequence\u0027) || 0) + 1;\nflow.set(\u0027commandSequence\u0027, seq);\n\nconst commandLog = {\n    sequence: seq,\n    target,\n    command,\n    variable,\n    operator,\n    source,\n    requestedAt: new Date().toISOString(),\n    status: \u0027accepted\u0027\n};\nflow.set(\u0027lastCommand\u0027, commandLog);\n\nmsg.commandInfo = commandLog;\nmsg.payload = true;\nmsg.variable = variable;\nreturn [msg, null];",
        "outputs":  2,
        "timeout":  0,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",
        "libs":  [

                 ],
