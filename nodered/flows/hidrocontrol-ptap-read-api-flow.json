    {
        "id":  "fn_get_current_read_001",
        "type":  "function",
        "z":  "hidro_read_tab_001",
        "name":  "Responder telemetria actual",
        "func":  "var telemetry = flow.get(\u0027telemetryCurrent\u0027);\nvar lastSeen = flow.get(\u0027plcLastSeen\u0027);\nvar now = Date.now();\nif (!telemetry) {\n    msg.statusCode = 503;\n    msg.payload = { error: \u0027No telemetry available\u0027, plcConnected: false, timestamp: new Date().toISOString() };\n    return msg;\n}\nvar stale = !lastSeen || (now - lastSeen \u003e 10000);\ntelemetry.plcConnected = !stale;\ntelemetry.stale = stale;\nmsg.payload = telemetry;\nreturn msg;",
        "outputs":  1,
        "timeout":  0,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",
        "libs":  [

                 ],
