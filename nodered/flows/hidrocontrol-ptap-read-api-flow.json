    {
        "id":  "fn_store_telemetry_read_001",
        "type":  "function",
        "z":  "hidro_read_tab_001",
        "name":  "Guardar telemetria actual",
        "func":  "var values = msg.payload || {};\nvar telemetry = {\n    timestamp: new Date().toISOString(),\n    plcConnected: true,\n    source: \u0027PLC_HIDROCONTROL\u0027,\n    values: values\n};\nflow.set(\u0027telemetryCurrent\u0027, telemetry);\nflow.set(\u0027plcLastSeen\u0027, Date.now());\nglobal.set(\u0027hidroTelemetryCurrent\u0027, telemetry);\nglobal.set(\u0027hidroPlcLastSeen\u0027, Date.now());\nmsg.payload = telemetry;\nreturn msg;",
