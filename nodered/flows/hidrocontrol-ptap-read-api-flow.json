    {
        "id":  "fn_system_status_read_001",
        "type":  "function",
        "z":  "hidro_read_tab_001",
        "name":  "Responder estado sistema",
        "func":  "var lastSeen = flow.get(\u0027plcLastSeen\u0027);\nvar telemetry = flow.get(\u0027telemetryCurrent\u0027);\nvar now = Date.now();\nvar stale = !lastSeen || (now - lastSeen \u003e 10000);\nmsg.payload = {\n    service: \u0027HIDROCONTROL PTAP Node-RED\u0027,\n    timestamp: new Date().toISOString(),\n    plc: {\n        ip: \u0027192.168.1.110\u0027,\n        connected: !stale,\n        lastSeen: lastSeen ? new Date(lastSeen).toISOString() : null,\n        watchdog: telemetry \u0026\u0026 telemetry.values ? telemetry.values.watchdog_plc : null\n    }\n};\nreturn msg;",
